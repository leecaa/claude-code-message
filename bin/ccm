#!/usr/bin/env python3
"""claude-code-message: a group chat for Claude Code sessions, across machines.

Sessions on linked machines show up as native SendMessage peers
(`<machine>-<session>`); every session registers what it is working on, so
agents can pick whom to @, or broadcast to everyone. Everything is audited.

Setup:     ccm init | ccm pair HOST | ccm doctor
Daemon:    ccm up | ccm down | ccm restart | ccm status
Chat:      ccm roster | ccm send NAME TEXT | ccm broadcast TEXT | ccm task TEXT
Audit:     ccm log [-f] [-n N] [--ev EV]
Internal:  ccm hook EVENT | ccm serve | ccm mirror | ccm link HOST
"""
import argparse
import fcntl
import hashlib
import json
import math
import os
import random
import sqlite3
import stat
from contextlib import contextmanager
import re
import secrets
import signal
import socket
import subprocess
import sys
import threading
import time
import unicodedata
import uuid
from urllib.parse import quote, unquote

VERSION = "0.3.0"
PROTO = 1
MIRROR_TAG = "claude-code-message"
MAX_FRAME = 1_048_576
SCAN_INTERVAL = 2.0
ROSTER_GRACE = 120  # seconds a roster entry may exist before its session registers
AUDIT_MAX = 20 * 1024 * 1024
HOME = os.path.expanduser("~")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude"))
SESSIONS_DIR = os.path.join(CLAUDE_DIR, "sessions")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")), "claude-code-message")
CONFIG_PATH = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "claude-code-message", "config.json")
ROSTER_DIR = os.path.join(STATE_DIR, "roster")
PIDFILE = os.path.join(STATE_DIR, "daemon.pid")
LOGFILE = os.path.join(STATE_DIR, "daemon.log")
STATUSFILE = os.path.join(STATE_DIR, "status.json")
AUDITFILE = os.path.join(STATE_DIR, "audit.jsonl")
COUNTERSFILE = os.path.join(STATE_DIR, "counters.json")
REMOTE_SCRIPT = "~/.cache/claude-code-message/ccm.py"
REMOTE_HOME = "~/.local/share/claude-code-message"
PLUGIN_ID = "claude-code-message@claude-code-message"
PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
RELIABILITY_DB = os.path.join(STATE_DIR, "reliability.sqlite3")
RELIABILITY_IDENTITY = os.path.join(STATE_DIR, "reliability-identity.json")
RELIABILITY_SCHEMA = 1
RELIABILITY_DEFAULTS = {
    "read_receipts": True, "retry_enabled": True, "retry_initial": 2.0,
    "retry_max": 300.0, "retry_jitter": 0.2, "ack_wait": 10.0,
    "max_attempts": 512, "message_ttl": 86400.0, "max_active_messages": 10000,
    "max_payload_bytes": 64 * 1024 * 1024, "max_store_bytes": 256 * 1024 * 1024,
    "ack_reserve_bytes": 4 * 1024 * 1024, "clock_skew": 300.0,
    "tombstone_margin": 172800.0,
}
RELIABILITY_RANGES = {
    "retry_initial": (0.1, 300), "retry_max": (1, 3600), "retry_jitter": (0, 0.5),
    "ack_wait": (0.1, 300), "max_attempts": (1, 10000), "message_ttl": (1, 86400),
    "max_active_messages": (1, 100000), "max_payload_bytes": (1024, 1024 ** 3),
    "max_store_bytes": (1024 * 1024, 2 * 1024 ** 3), "ack_reserve_bytes": (4096, 64 * 1024 * 1024),
    "clock_skew": (0, 300), "tombstone_margin": (3600, 604800),
}
IS_LINUX = sys.platform.startswith("linux")
LOG_TAG = ""


def log(*a):
    sys.stderr.write(" ".join([time.strftime("%Y-%m-%dT%H:%M:%S"), f"[{LOG_TAG}]" if LOG_TAG else "", *map(str, a)]) + "\n")
    sys.stderr.flush()


def label_ok(s):
    s = re.sub(r"[^A-Za-z0-9_-]+", "-", s or "").strip("-_")
    return s[:40] or "peer"


def default_label():
    return label_ok(socket.gethostname().split(".")[0])


def now_ms():
    return int(time.time() * 1000)


def write_json_private(path, obj):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{secrets.token_hex(4)}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, ensure_ascii=False, allow_nan=False)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        directory = os.open(os.path.dirname(path), os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


class ReliabilityError(RuntimeError):
    pass


def validate_config(cfg):
    if not isinstance(cfg, dict):
        raise ReliabilityError("configuration must be an object")
    cfg = dict(cfg)
    cfg.setdefault("label", default_label())
    cfg.setdefault("peers", [])
    cfg.setdefault("audit_preview_chars", 160)
    cfg.setdefault("policy_revision", 0)
    if not isinstance(cfg["label"], str) or not isinstance(cfg["peers"], list):
        raise ReliabilityError("invalid node configuration")
    if type(cfg["audit_preview_chars"]) is not int or not 0 <= cfg["audit_preview_chars"] <= 100000:
        raise ReliabilityError("invalid preview size")
    if type(cfg["policy_revision"]) is not int or cfg["policy_revision"] < 0:
        raise ReliabilityError("invalid policy revision")
    for key in cfg:
        if (key.startswith("retry_") or key.startswith("receipt_")) and key not in RELIABILITY_DEFAULTS:
            raise ReliabilityError("unknown reliability setting")
    for key, default in RELIABILITY_DEFAULTS.items():
        cfg.setdefault(key, default)
        value = cfg[key]
        if type(default) is bool:
            if type(value) is not bool:
                raise ReliabilityError(key + " must be a JSON boolean")
        else:
            if type(value) not in (int, float) or not math.isfinite(value):
                raise ReliabilityError(key + " must be finite")
            if type(default) is int and type(value) is not int:
                raise ReliabilityError(key + " must be an integer")
            low, high = RELIABILITY_RANGES[key]
            if not low <= value <= high:
                raise ReliabilityError(key + " outside supported range")
    if cfg["retry_initial"] > cfg["retry_max"] or cfg["ack_reserve_bytes"] >= cfg["max_store_bytes"] // 4:
        raise ReliabilityError("inconsistent reliability limits")
    return cfg


def load_config():
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f, parse_constant=lambda _: (_ for _ in ()).throw(ValueError("non-finite JSON")))
    except FileNotFoundError:
        cfg = {}
    except (OSError, ValueError) as e:
        raise ReliabilityError("configuration unreadable or invalid; sending paused") from e
    return validate_config(cfg)


def save_config(cfg):
    cfg = validate_config(cfg)
    store = ReliabilityStore()
    revision = store.begin_policy_update(suppress_read=not cfg["read_receipts"])
    cfg["policy_revision"] = revision
    write_json_private(CONFIG_PATH, cfg)
    store.finish_policy_update(cfg)
    return cfg


# -------------------------------------------------------------- reliability

def canonical_json(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def generation(rec):
    return {key: rec.get(key) for key in ("pid", "procStart", "pidDomain")}


def safe_identifier(value):
    return isinstance(value, str) and bool(re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", value))


class ReliabilityStore:
    """Private, bounded ledger. Native IO is deliberately outside its transactions."""
    def __init__(self, directory=None, clock=None, rng=None):
        self.directory = directory or STATE_DIR
        self.path = os.path.join(self.directory, "reliability.sqlite3")
        self.identity_path = os.path.join(self.directory, "reliability-identity.json")
        self.clock = clock or time.time
        self.rng = rng or random.SystemRandom()
        os.makedirs(self.directory, mode=0o700, exist_ok=True)
        d = os.lstat(self.directory)
        if not stat.S_ISDIR(d.st_mode) or d.st_uid != os.getuid():
            raise ReliabilityError("reliability state directory must be owned and regular")
        # Older roster creation could leave this owned data directory at 0755.
        if d.st_mode & 0o077:
            os.chmod(self.directory,0o700)
        lock_path = os.path.join(self.directory, "reliability.lock")
        lock = os.open(lock_path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if not os.path.exists(self.path):
                fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
                os.close(fd)
            s = os.lstat(self.path)
            if not stat.S_ISREG(s.st_mode) or s.st_uid != os.getuid() or stat.S_IMODE(s.st_mode) != 0o600:
                raise ReliabilityError("reliability database must be a private regular file")
            self._file_identity = (s.st_dev,s.st_ino)
            if os.path.lexists(self.identity_path):
                marker_stat = os.lstat(self.identity_path)
                if not stat.S_ISREG(marker_stat.st_mode) or marker_stat.st_uid != os.getuid() or stat.S_IMODE(marker_stat.st_mode) != 0o600:
                    raise ReliabilityError("identity marker must be private and regular")
            with self.connection() as db:
                version = db.execute("PRAGMA user_version").fetchone()[0]
                if version not in (0, RELIABILITY_SCHEMA):
                    raise ReliabilityError("unsupported reliability database schema")
                db.executescript("""
                    CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
                    CREATE TABLE IF NOT EXISTS peers (
                        channel TEXT PRIMARY KEY, node_id TEXT NOT NULL, incarnation TEXT NOT NULL,
                        label TEXT NOT NULL, disposition TEXT NOT NULL DEFAULT 'bound');
                    CREATE TABLE IF NOT EXISTS routes (
                        peer TEXT NOT NULL, sid TEXT NOT NULL, name TEXT NOT NULL,
                        binding TEXT NOT NULL, observed REAL NOT NULL, PRIMARY KEY(peer,sid));
                    CREATE TABLE IF NOT EXISTS outbox (
                        id TEXT PRIMARY KEY, native_id TEXT NOT NULL, source_sid TEXT NOT NULL,
                        source_generation TEXT, target_peer TEXT NOT NULL, target_sid TEXT NOT NULL,
                        target_generation TEXT, frame TEXT, payload_bytes INTEGER NOT NULL,
                        fingerprint TEXT NOT NULL, created REAL NOT NULL, expires REAL NOT NULL,
                        retain_until REAL NOT NULL, read_requested INTEGER NOT NULL, group_id TEXT,
                        peer_node TEXT, peer_inc TEXT, channel TEXT, mode TEXT NOT NULL DEFAULT 'unbound',
                        transport TEXT NOT NULL DEFAULT 'queued', native_state TEXT NOT NULL DEFAULT 'none',
                        admission TEXT NOT NULL DEFAULT 'unknown', acknowledged INTEGER NOT NULL DEFAULT 0,
                        disposition TEXT NOT NULL DEFAULT 'enabled', attempts INTEGER NOT NULL DEFAULT 0,
                        next_at REAL NOT NULL, attempt_owner TEXT, attempt_until REAL,
                        explicit_seen INTEGER NOT NULL DEFAULT 0,
                        legacy_started INTEGER NOT NULL DEFAULT 0,
                        UNIQUE(target_peer,native_id));
                    CREATE TABLE IF NOT EXISTS inbox (
                        origin_node TEXT NOT NULL, origin_inc TEXT NOT NULL, id TEXT NOT NULL,
                        native_id TEXT NOT NULL, source_sid TEXT NOT NULL, source_generation TEXT,
                        target_sid TEXT NOT NULL, target_generation TEXT, frame TEXT,
                        payload_bytes INTEGER NOT NULL, fingerprint TEXT NOT NULL,
                        created REAL NOT NULL, expires REAL NOT NULL, retain_until REAL NOT NULL,
                        read_requested INTEGER NOT NULL, peer TEXT NOT NULL, channel TEXT,
                        native_state TEXT NOT NULL DEFAULT 'waiting_target', admission TEXT NOT NULL DEFAULT 'unknown',
                        acknowledged INTEGER NOT NULL DEFAULT 0, disclosure TEXT NOT NULL DEFAULT 'none',
                        disposition TEXT NOT NULL DEFAULT 'enabled', attempts INTEGER NOT NULL DEFAULT 0,
                        next_at REAL NOT NULL, dispatch_owner TEXT, dispatch_pid INTEGER,
                        dispatch_start TEXT, dispatch_domain TEXT, dispatch_revision INTEGER,
                        PRIMARY KEY(origin_node,origin_inc,id),
                        UNIQUE(origin_node,origin_inc,native_id));
                    CREATE TABLE IF NOT EXISTS receipts (
                        id TEXT PRIMARY KEY, origin_node TEXT NOT NULL, origin_inc TEXT NOT NULL,
                        delivery_id TEXT NOT NULL, peer TEXT NOT NULL, channel TEXT,
                        peer_node TEXT NOT NULL, peer_inc TEXT NOT NULL, kind TEXT NOT NULL,
                        payload TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'pending',
                        attempts INTEGER NOT NULL DEFAULT 0, next_at REAL NOT NULL,
                        expires REAL NOT NULL, retain_until REAL NOT NULL,
                        owner TEXT, owner_until REAL, revision INTEGER,
                        explicit_seen INTEGER NOT NULL DEFAULT 0,
                        privacy_suppressed INTEGER NOT NULL DEFAULT 0,
                        send_kind TEXT NOT NULL DEFAULT 'regular', reactive_next_at REAL NOT NULL DEFAULT 0,
                        UNIQUE(origin_node,origin_inc,delivery_id,kind));
                    CREATE TABLE IF NOT EXISTS native_status_pending (
                        id TEXT PRIMARY KEY, delivery_id TEXT NOT NULL, peer_node TEXT NOT NULL,
                        peer_inc TEXT NOT NULL, channel TEXT, source_sid TEXT NOT NULL,
                        source_generation TEXT NOT NULL, target_sid TEXT NOT NULL,
                        target_generation TEXT NOT NULL, native_id TEXT NOT NULL,
                        status TEXT NOT NULL, observed REAL NOT NULL, retain_until REAL NOT NULL);
                    CREATE TABLE IF NOT EXISTS explicit_grants (
                        token TEXT PRIMARY KEY, delivery_id TEXT NOT NULL, peer TEXT NOT NULL,
                        owner_sid TEXT NOT NULL, owner_generation TEXT NOT NULL, purpose TEXT NOT NULL,
                        created REAL NOT NULL, expires REAL NOT NULL, used INTEGER NOT NULL DEFAULT 0);
                    CREATE INDEX IF NOT EXISTS outbox_due ON outbox(target_peer,next_at);
                    CREATE INDEX IF NOT EXISTS inbox_due ON inbox(next_at);
                    CREATE INDEX IF NOT EXISTS receipt_due ON receipts(peer,next_at);
                """)
                db.execute("BEGIN IMMEDIATE")
                try:
                    existing = dict(db.execute("SELECT key,value FROM meta"))
                    marker = None
                    try:
                        with open(self.identity_path) as f:
                            marker = json.load(f)
                    except FileNotFoundError:
                        pass
                    except (OSError, ValueError) as e:
                        raise ReliabilityError("reliability identity marker invalid") from e
                    node_id = existing.get("node_id") or (marker or {}).get("node_id") or str(uuid.uuid4())
                    incarnation = existing.get("incarnation") or str(uuid.uuid4())
                    if existing.get("incarnation") and marker and (marker.get("incarnation"),marker.get("node_id")) != (incarnation,node_id):
                        raise ReliabilityError("database identity changed; reconciliation required")
                    self.node_id, self.incarnation = node_id, incarnation
                    cfg = load_config()
                    initial = {"node_id":node_id, "incarnation":incarnation, "policy_revision":str(cfg["policy_revision"]),
                               "read_enabled":"1" if cfg["read_receipts"] else "0", "retry_enabled":"1" if cfg["retry_enabled"] else "0",
                               "policy_pending":"0", "last_wall":str(self.clock())}
                    for key, value in initial.items():
                        db.execute("INSERT OR IGNORE INTO meta VALUES (?,?)", (key,value))
                    db.execute("PRAGMA user_version=%d" % RELIABILITY_SCHEMA)
                    db.execute("COMMIT")
                except BaseException:
                    db.execute("ROLLBACK")
                    raise
            write_json_private(self.identity_path, {"node_id":self.node_id,"incarnation":self.incarnation})
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)

    @contextmanager
    def connection(self):
        s = os.lstat(self.path)
        if not stat.S_ISREG(s.st_mode) or s.st_uid != os.getuid() or stat.S_IMODE(s.st_mode) != 0o600 or (s.st_dev,s.st_ino) != self._file_identity:
            raise ReliabilityError("reliability database changed; sending paused")
        uri = "file:" + quote(os.path.abspath(self.path),safe="/") + "?mode=rw"
        db = sqlite3.connect(uri, uri=True, timeout=5, isolation_level=None)
        db.row_factory = sqlite3.Row
        try:
            db.execute("PRAGMA journal_mode=DELETE")
            db.execute("PRAGMA synchronous=FULL")
            db.execute("PRAGMA busy_timeout=5000")
            db.execute("PRAGMA secure_delete=ON")
            cfg = load_config()
            page = db.execute("PRAGMA page_size").fetchone()[0]
            db.execute("PRAGMA max_page_count=%d" % max(32, cfg["max_store_bytes"] // (2 * page)))
            yield db
        finally:
            db.close()

    @contextmanager
    def transaction(self):
        with self.connection() as db:
            db.execute("BEGIN IMMEDIATE")
            try:
                yield db
                db.execute("COMMIT")
            except BaseException:
                db.execute("ROLLBACK")
                raise

    def _clock(self, db):
        now = self.clock()
        if not math.isfinite(now):
            raise ReliabilityError("clock is not finite")
        last = float(db.execute("SELECT value FROM meta WHERE key='last_wall'").fetchone()[0])
        if now < last - 0.001:
            raise ReliabilityError("clock rolled back; sending paused")
        db.execute("UPDATE meta SET value=? WHERE key='last_wall'", (str(max(now,last)),))
        return now

    def _policy(self, db):
        cfg = load_config()
        values = dict(db.execute("SELECT key,value FROM meta WHERE key IN ('policy_revision','read_enabled','retry_enabled','policy_pending')"))
        revision = int(values["policy_revision"])
        if cfg["policy_revision"] != revision or values["policy_pending"] == "1":
            raise ReliabilityError("privacy/retry policy update incomplete; sending paused")
        # A manual edit may disable policy, but cannot silently re-enable old disclosure.
        read = cfg["read_receipts"] and values["read_enabled"] == "1"
        retry = cfg["retry_enabled"] and values["retry_enabled"] == "1"
        if not cfg["read_receipts"]:
            db.execute("UPDATE meta SET value='0' WHERE key='read_enabled'")
            db.execute("UPDATE receipts SET privacy_suppressed=1 WHERE kind='receiver_acknowledged' AND state!='received'")
            db.execute("UPDATE receipts SET state='suppressed' WHERE kind='receiver_acknowledged' AND state IN ('pending','reserved')")
            db.execute("UPDATE inbox SET disclosure='suppressed' WHERE acknowledged=1 AND disclosure='pending'")
        if not cfg["retry_enabled"]:
            db.execute("UPDATE meta SET value='0' WHERE key='retry_enabled'")
            db.execute("UPDATE outbox SET disposition='paused_retry_disabled' WHERE disposition='enabled'")
            db.execute("UPDATE inbox SET disposition='paused_retry_disabled' WHERE disposition='enabled' AND native_state IN ('waiting_target','waiting_source_route','prewrite_failed')")
        return cfg, read, retry, revision

    def begin_policy_update(self, suppress_read=False):
        with self.transaction() as db:
            if suppress_read:
                db.execute("UPDATE receipts SET privacy_suppressed=1 WHERE kind='receiver_acknowledged' AND state!='received'")
            revision = int(db.execute("SELECT value FROM meta WHERE key='policy_revision'").fetchone()[0]) + 1
            db.execute("UPDATE meta SET value='1' WHERE key='policy_pending'")
            db.execute("UPDATE meta SET value=? WHERE key='policy_revision'", (str(revision),))
            return revision

    def finish_policy_update(self, cfg):
        with self.transaction() as db:
            expected = int(db.execute("SELECT value FROM meta WHERE key='policy_revision'").fetchone()[0])
            if expected != cfg["policy_revision"]:
                raise ReliabilityError("configuration revision changed")
            if not cfg["read_receipts"]:
                db.execute("UPDATE receipts SET privacy_suppressed=1 WHERE kind='receiver_acknowledged' AND state!='received'")
                db.execute("UPDATE receipts SET state='suppressed' WHERE kind='receiver_acknowledged' AND state IN ('pending','reserved')")
                db.execute("UPDATE inbox SET disclosure='suppressed' WHERE acknowledged=1 AND disclosure='pending'")
            for key,value in (("read_enabled",cfg["read_receipts"]),("retry_enabled",cfg["retry_enabled"])):
                db.execute("UPDATE meta SET value=? WHERE key=?", ("1" if value else "0",key))
            if cfg["retry_enabled"]:
                db.execute("UPDATE outbox SET disposition='enabled' WHERE disposition='paused_retry_disabled'")
                db.execute("UPDATE inbox SET disposition='enabled' WHERE disposition='paused_retry_disabled' AND native_state IN ('waiting_target','waiting_source_route','prewrite_failed')")
            else:
                db.execute("UPDATE outbox SET disposition='paused_retry_disabled' WHERE disposition='enabled'")
                db.execute("UPDATE inbox SET disposition='paused_retry_disabled' WHERE disposition='enabled' AND native_state IN ('waiting_target','waiting_source_route','prewrite_failed')")
            db.execute("UPDATE meta SET value='0' WHERE key='policy_pending'")

    def _capacity(self, db, cfg, additional_bytes=0, control=False):
        page_size=db.execute("PRAGMA page_size").fetchone()[0]
        pages=db.execute("PRAGMA page_count").fetchone()[0]
        free=db.execute("PRAGMA freelist_count").fetchone()[0]
        growth=max(0,math.ceil(additional_bytes/page_size)-free)
        reserve=max(cfg["ack_reserve_bytes"],8*page_size)
        return {"pages":pages,"free":free,"required_bytes":2*(pages+growth)*page_size,
                "available_bytes":cfg["max_store_bytes"]-(0 if control else reserve)}

    def _budget(self, db, frames, metadata_rows=1, control=False):
        cfg = load_config()
        count = sum(db.execute("SELECT COUNT(*) FROM " + t + " WHERE frame IS NOT NULL").fetchone()[0] for t in ("outbox","inbox"))
        size = sum(db.execute("SELECT COALESCE(SUM(payload_bytes),0) FROM " + t + " WHERE frame IS NOT NULL").fetchone()[0] for t in ("outbox","inbox"))
        if count + len(frames) > cfg["max_active_messages"] or size + sum(frames) > cfg["max_payload_bytes"]:
            raise ReliabilityError("active message budget exhausted")
        capacity=self._capacity(db,cfg,sum(frames)+4096*metadata_rows,control)
        if capacity["required_bytes"] > capacity["available_bytes"]:
            raise ReliabilityError("total reliability store budget exhausted")

    def _fingerprint(self, item):
        immutable = {key:item.get(key) for key in ("source_sid","source_generation","target_sid","frame","created","expires","read_requested")}
        return hashlib.sha256(canonical_json(immutable).encode()).hexdigest()

    def bind_peer(self, channel, label, node_id, incarnation):
        if not channel or not all(safe_identifier(x) for x in (node_id,incarnation)):
            raise ReliabilityError("invalid paired channel identity")
        with self.transaction() as db:
            old = db.execute("SELECT * FROM peers WHERE channel=?",(channel,)).fetchone()
            if old and (old["node_id"],old["incarnation"],old["label"]) != (node_id,incarnation,label):
                db.execute("UPDATE peers SET disposition='needs_reconcile' WHERE channel=?",(channel,))
                db.execute("UPDATE outbox SET disposition='needs_reconcile' WHERE channel=?",(channel,))
                return False
            if old and old["disposition"] != "bound":
                return False
            db.execute("INSERT OR IGNORE INTO peers(channel,node_id,incarnation,label) VALUES (?,?,?,?)",(channel,node_id,incarnation,label))
            return True

    def peer(self, channel):
        with self.connection() as db:
            row = db.execute("SELECT * FROM peers WHERE channel=?",(channel,)).fetchone()
            return dict(row) if row else None

    def _gc_routes(self, db, now):
        # Cache retirement must not redirect still-live queued targets or depend on a new roster.
        db.execute("""DELETE FROM routes WHERE observed<? AND NOT EXISTS
            (SELECT 1 FROM outbox WHERE target_peer=routes.peer AND target_sid=routes.sid AND expires>?)""",(now-86400,now))

    def remember_routes(self, peer, records):
        accepted=0;rejected=0
        with self.transaction() as db:
            now=self._clock(db)
            self._gc_routes(db,now)
            for rec in records:
                sid=rec.get("sessionId")
                if not safe_identifier(sid):
                    rejected+=1;continue
                name=display_name(rec)
                if not isinstance(name,str) or len(name.encode())>1024:
                    rejected+=1;continue
                binding=canonical_json(generation(rec))
                old=db.execute("SELECT 1 FROM routes WHERE peer=? AND sid=?",(peer,sid)).fetchone()
                if not old and db.execute("SELECT COUNT(*) FROM routes").fetchone()[0]>=10000:
                    rejected+=1;continue
                try:
                    self._budget(db,[],metadata_rows=1)
                except ReliabilityError:
                    rejected+=1;continue
                db.execute("INSERT OR REPLACE INTO routes VALUES (?,?,?,?,?)",(peer,sid,name,binding,now));accepted+=1
        return {"accepted":accepted,"rejected":rejected,"truncated":bool(rejected)}

    def cached_routes(self):
        with self.connection() as db:
            return [dict(row) for row in db.execute("SELECT * FROM routes")]

    def enqueue(self, targets, frame, source=None, group_id=None):
        return self.enqueue_batch([(target,frame) for target in targets],source,group_id)

    def enqueue_batch(self, deliveries, source=None, group_id=None):
        source = source or {}
        entries = []
        with self.transaction() as db:
            now = self._clock(db); cfg,read,retry,revision = self._policy(db)
            for target,frame in deliveries:
                if not isinstance(frame,dict) or frame.get("type") != "user" or not safe_identifier(frame.get("msg_id")):
                    raise ReliabilityError("only identified user messages can be queued")
                encoded = canonical_json(frame)
                if len(encoded.encode()) + 4096 > MAX_FRAME:
                    raise ReliabilityError("message too large")
                peer,sid = target["peer"],target["sid"]
                if not safe_identifier(sid) or not isinstance(peer,str) or not peer:
                    raise ReliabilityError("target must have a fixed peer and SID")
                existing = db.execute("SELECT * FROM outbox WHERE target_peer=? AND native_id=?",(peer,frame["msg_id"])).fetchone()
                if existing:
                    if existing["target_sid"] != sid or existing["source_sid"] != (source.get("sessionId") or "") or existing["frame"] != encoded or existing["source_generation"] != canonical_json(generation(source)):
                        raise ReliabilityError("native message ID conflict")
                    entries.append(dict(existing));continue
                item = {"source_sid":source.get("sessionId") or "", "source_generation":canonical_json(generation(source)),
                        "target_sid":sid,"frame":frame,"created":now,"expires":now+cfg["message_ttl"],"read_requested":read}
                self._budget(db,[len(encoded.encode())],metadata_rows=2)
                delivery_id = str(uuid.uuid4())
                db.execute("""INSERT INTO outbox(id,native_id,source_sid,source_generation,target_peer,target_sid,
                    frame,payload_bytes,fingerprint,created,expires,retain_until,read_requested,group_id,next_at,disposition)
                    VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                    (delivery_id,frame["msg_id"],item["source_sid"],item["source_generation"],peer,sid,encoded,len(encoded.encode()),
                     self._fingerprint(item),now,item["expires"],item["expires"]+cfg["clock_skew"]+cfg["tombstone_margin"],int(read),group_id,now,
                     "enabled" if retry else "paused_retry_disabled"))
                entries.append(dict(db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone()))
        return entries

    def claim_explicit_notice(self, table, item_id):
        if table not in ("outbox", "receipts"):
            raise ReliabilityError("invalid explicit notice")
        with self.transaction() as db:
            cursor = db.execute("UPDATE " + table + " SET explicit_seen=1 WHERE id=? AND explicit_seen=0",(item_id,))
            return cursor.rowcount == 1

    def outbox_rows(self, peer=None):
        with self.connection() as db:
            rows = db.execute("SELECT * FROM outbox" + (" WHERE target_peer=?" if peer else ""), (peer,) if peer else ())
            return [dict(row) for row in rows]

    def _delay(self, cfg, attempts):
        base = min(cfg["retry_max"],cfg["retry_initial"] * 2 ** min(max(0,attempts-1),30))
        return max(0.01,base * self.rng.uniform(1-cfg["retry_jitter"],1+cfg["retry_jitter"]))

    def reserve_outgoing(self, delivery_id, channel, peer_identity, mode, explicit=False):
        with self.transaction() as db:
            now=self._clock(db);cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone()
            if not row or row["transport"] in ("peer_received","legacy_socket_written_unconfirmed") or row["disposition"] in ("terminal","needs_reconcile") or row["admission"] in ("held","denied","refused","dropped","expired"):
                return None
            if row["expires"] <= now:
                db.execute("UPDATE outbox SET disposition='terminal' WHERE id=?",(delivery_id,));return None
            if not retry and not explicit:
                return None
            if row["attempts"] >= cfg["max_attempts"]:
                db.execute("UPDATE outbox SET disposition='terminal' WHERE id=?",(delivery_id,));return None
            if row["next_at"] > now and not explicit:
                return None
            if row["attempt_until"] and row["attempt_until"] > now:
                return None
            if row["mode"] == "legacy" and row["legacy_started"]:
                return None
            if row["mode"] not in ("unbound",mode):
                db.execute("UPDATE outbox SET disposition='needs_reconcile' WHERE id=?",(delivery_id,));return None
            node,inc = peer_identity if peer_identity else (None,None)
            if row["peer_node"] and (row["peer_node"],row["peer_inc"]) != (node,inc):
                db.execute("UPDATE outbox SET disposition='needs_reconcile' WHERE id=?",(delivery_id,));return None
            owner=str(uuid.uuid4());attempts=row["attempts"]+1
            db.execute("""UPDATE outbox SET mode=?,channel=?,peer_node=?,peer_inc=?,attempts=?,attempt_owner=?,
                attempt_until=?,next_at=?,disposition=? WHERE id=?""",
                (mode,channel,node,inc,attempts,owner,now+cfg["ack_wait"],now+self._delay(cfg,attempts),
                 "enabled" if retry else "paused_retry_disabled",delivery_id))
            updated=dict(db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone());updated["policy_revision"]=revision
            return updated

    def outgoing_send_allowed(self, attempt, explicit=False):
        with self.transaction() as db:
            cfg,read,retry,revision=self._policy(db);now=self._clock(db)
            row=db.execute("SELECT * FROM outbox WHERE id=?",(attempt["id"],)).fetchone()
            if not row or row["attempt_owner"]!=attempt["attempt_owner"] or revision!=attempt["policy_revision"] or row["transport"]!="queued" or row["disposition"] in ("terminal","needs_reconcile") or row["expires"]<=now or not retry and not explicit:
                return False
            if row["mode"]=="legacy":
                if row["legacy_started"]:
                    return False
                db.execute("UPDATE outbox SET legacy_started=1 WHERE id=?",(row["id"],))
            return True

    def outgoing_envelope(self, row):
        return {"op":"reliable_deliver","schema":RELIABILITY_SCHEMA,"origin_node_id":self.node_id,
                "store_incarnation":self.incarnation,"delivery_id":row["id"],"source_sid":row["source_sid"],
                "source_generation":json.loads(row["source_generation"]),"target_sid":row["target_sid"],
                "frame":json.loads(row["frame"]),"created":row["created"],"expires":row["expires"],
                "read_requested":bool(row["read_requested"]),"fingerprint":row["fingerprint"]}

    def outgoing_finished(self, delivery_id, owner, outcome):
        with self.transaction() as db:
            row=db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone()
            if not row or row["attempt_owner"] != owner:
                return False
            if row["mode"] == "legacy" and row["legacy_started"]:
                # A legacy write or write exception is never made replayable by an upgrade.
                db.execute("UPDATE outbox SET transport='legacy_socket_written_unconfirmed',disposition='terminal',attempt_until=NULL WHERE id=?",(delivery_id,))
            elif outcome != "sent":
                db.execute("UPDATE outbox SET attempt_until=NULL WHERE id=?",(delivery_id,))
            return True

    def peer_received(self, delivery_id, peer_identity, target_sid):
        with self.transaction() as db:
            row=db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone()
            if not row or row["mode"] != "durable" or (row["peer_node"],row["peer_inc"],row["target_sid"]) != (peer_identity[0],peer_identity[1],target_sid):
                return False
            db.execute("UPDATE outbox SET transport='peer_received',attempt_until=NULL WHERE id=?",(delivery_id,))
            return True

    def _receipt(self, db, item, kind, payload):
        receipt_id=hashlib.sha256((item["origin_node"]+":"+item["origin_inc"]+":"+item["id"]+":"+kind).encode()).hexdigest()
        self._budget(db,[],metadata_rows=1,control=True)
        db.execute("""INSERT OR IGNORE INTO receipts(id,origin_node,origin_inc,delivery_id,peer,channel,peer_node,peer_inc,
            kind,payload,next_at,expires,retain_until) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)""",
            (receipt_id,item["origin_node"],item["origin_inc"],item["id"],item["peer"],item["channel"],item["origin_node"],item["origin_inc"],
             kind,canonical_json(payload),self.clock(),item["expires"],item["retain_until"]))
        return receipt_id

    def accept(self, envelope, peer, channel, peer_identity, legacy=False):
        with self.transaction() as db:
            now=self._clock(db);cfg,read,retry,revision=self._policy(db)
            if legacy:
                frame=envelope["frame"];native=frame.get("msg_id")
                if not safe_identifier(native):
                    raise ReliabilityError("legacy message lacks a stable ID")
                old=db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND native_id=?",
                               (peer_identity[0],peer_identity[1],native)).fetchone()
                envelope=dict(envelope,origin_node_id=peer_identity[0],store_incarnation=peer_identity[1],delivery_id=native,
                              created=old["created"] if old else now,expires=old["expires"] if old else now+cfg["message_ttl"],read_requested=False)
            origin,inc,delivery=(envelope.get(k) for k in ("origin_node_id","store_incarnation","delivery_id"))
            if (origin,inc) != tuple(peer_identity) or not all(safe_identifier(x) for x in (origin,inc,delivery,envelope.get("target_sid"))):
                raise ReliabilityError("invalid origin or target binding")
            frame=envelope.get("frame")
            if not isinstance(frame,dict) or frame.get("type") != "user" or not safe_identifier(frame.get("msg_id")):
                raise ReliabilityError("invalid reliable user frame")
            if type(envelope.get("read_requested")) is not bool:
                raise ReliabilityError("invalid receipt request")
            created,expires=envelope.get("created"),envelope.get("expires")
            if any(type(x) not in (int,float) or not math.isfinite(x) for x in (created,expires)) or not 0 < expires-created <= 86400 or created > now+cfg["clock_skew"]:
                raise ReliabilityError("invalid message lifetime or clock")
            if expires <= now:
                raise ReliabilityError("message expired")
            item={"source_sid":envelope.get("source_sid") or "","source_generation":canonical_json(envelope.get("source_generation") or {}),
                  "target_sid":envelope["target_sid"],"frame":frame,"created":created,"expires":expires,"read_requested":envelope["read_requested"]}
            fingerprint=self._fingerprint(item)
            if not legacy and envelope.get("fingerprint") != fingerprint:
                raise ReliabilityError("message fingerprint mismatch")
            encoded=canonical_json(frame);size=len(encoded.encode())
            if len(canonical_json(envelope).encode())+4096 > MAX_FRAME:
                raise ReliabilityError("reliable envelope too large")
            old=db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND id=?",(origin,inc,delivery)).fetchone()
            mapped=db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND native_id=?",(origin,inc,frame["msg_id"])).fetchone()
            if old or mapped:
                existing=old or mapped
                if existing["fingerprint"] != fingerprint or existing["id"] != delivery:
                    raise ReliabilityError("delivery ID conflict")
                return dict(existing),False
            self._budget(db,[size],metadata_rows=3)
            db.execute("""INSERT INTO inbox(origin_node,origin_inc,id,native_id,source_sid,source_generation,target_sid,frame,payload_bytes,
                fingerprint,created,expires,retain_until,read_requested,peer,channel,next_at,disposition)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (origin,inc,delivery,frame["msg_id"],item["source_sid"],item["source_generation"],item["target_sid"],encoded,size,fingerprint,
                 created,expires,expires+cfg["clock_skew"]+cfg["tombstone_margin"],int(item["read_requested"]),peer,channel,now,
                 "enabled" if retry else "paused_retry_disabled"))
            row=dict(db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND id=?",(origin,inc,delivery)).fetchone())
            if not legacy:
                self._receipt(db,row,"peer_received",{"target_sid":row["target_sid"]})
            return row,True

    def inbox_rows(self):
        with self.connection() as db:
            return [dict(r) for r in db.execute("SELECT * FROM inbox")]

    def claim_native(self, key, target, explicit=False):
        with self.transaction() as db:
            now=self._clock(db);cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND id=?",key).fetchone()
            if not row or row["native_state"] not in ("waiting_target","waiting_source_route","prewrite_failed") or row["disposition"] in ("terminal","needs_reconcile") or row["admission"] in ("held","denied","refused","dropped","expired") or row["acknowledged"]:
                return None
            if row["expires"] <= now or row["attempts"] >= cfg["max_attempts"]:
                db.execute("UPDATE inbox SET disposition='terminal',native_state='expired' WHERE origin_node=? AND origin_inc=? AND id=?",key);return None
            if (not retry and not explicit) or (row["next_at"] > now and not explicit):
                return None
            if target.get("sessionId") != row["target_sid"]:
                raise ReliabilityError("native target SID changed")
            owner=str(uuid.uuid4())
            db.execute("""UPDATE inbox SET native_state='native_dispatching',dispatch_owner=?,dispatch_pid=?,dispatch_start=?,dispatch_domain=?,
                dispatch_revision=?,target_generation=?,attempts=attempts+1 WHERE origin_node=? AND origin_inc=? AND id=?""",
                (owner,os.getpid(),proc_start(os.getpid()),pid_domain(),revision,canonical_json(generation(target)),*key))
            return dict(db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND id=?",key).fetchone())

    def prewrite_allowed(self, key, owner):
        with self.transaction() as db:
            cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND id=?",key).fetchone()
            return bool(row and row["native_state"]=="native_dispatching" and row["dispatch_owner"]==owner and row["dispatch_pid"]==os.getpid()
                        and row["dispatch_start"]==proc_start(os.getpid()) and row["dispatch_domain"]==pid_domain() and row["dispatch_revision"]==revision
                        and row["expires"]>self._clock(db) and db.execute("SELECT value FROM meta WHERE key='policy_pending'").fetchone()[0]=="0")

    def native_finished(self, key, owner, result):
        with self.transaction() as db:
            now=self._clock(db);cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND id=?",key).fetchone()
            if not row or row["dispatch_owner"]!=owner or row["native_state"]!="native_dispatching" or row["dispatch_pid"]!=os.getpid() or row["dispatch_start"]!=proc_start(os.getpid()):
                return False
            state=result["state"]
            if state not in ("prewrite_failed","socket_written_unconfirmed","handoff_unknown"):
                state="handoff_unknown"
            disposition="enabled" if state=="prewrite_failed" and retry else ("paused_retry_disabled" if state=="prewrite_failed" else "needs_reconcile" if state=="handoff_unknown" else "terminal")
            db.execute("UPDATE inbox SET native_state=?,disposition=?,next_at=? WHERE origin_node=? AND origin_inc=? AND id=?",
                       (state,disposition,now+self._delay(cfg,row["attempts"]),*key))
            if state in ("socket_written_unconfirmed","handoff_unknown") and not row["origin_node"].startswith("legacy:"):
                saved=dict(db.execute("SELECT * FROM inbox WHERE origin_node=? AND origin_inc=? AND id=?",key).fetchone())
                self._receipt(db,saved,"native_handoff",{"target_sid":saved["target_sid"],"target_generation":json.loads(saved["target_generation"]),"native_state":state})
            return True

    def recover_dispatches(self):
        with self.transaction() as db:
            rows=list(db.execute("SELECT * FROM inbox WHERE native_state='native_dispatching'"))
            for row in rows:
                if not row["dispatch_pid"] or not pid_alive(row["dispatch_pid"]) or proc_start(row["dispatch_pid"]) != row["dispatch_start"] or pid_domain()!=row["dispatch_domain"]:
                    key=(row["origin_node"],row["origin_inc"],row["id"])
                    db.execute("UPDATE inbox SET native_state='handoff_unknown',disposition='needs_reconcile' WHERE origin_node=? AND origin_inc=? AND id=?",key)
                    if row["target_generation"] and not row["origin_node"].startswith("legacy:"):
                        self._receipt(db,dict(row),"native_handoff",{"target_sid":row["target_sid"],"target_generation":json.loads(row["target_generation"]),"native_state":"handoff_unknown"})

    def waiting(self, key, state):
        with self.transaction() as db:
            db.execute("UPDATE inbox SET native_state=? WHERE origin_node=? AND origin_inc=? AND id=? AND native_state IN ('waiting_target','waiting_source_route','prewrite_failed')",(state,*key))

    def acknowledge(self, delivery_id, owner_rec):
        with self.transaction() as db:
            now=self._clock(db);cfg,read,retry,revision=self._policy(db)
            rows=list(db.execute("SELECT * FROM inbox WHERE id=? AND target_sid=?",(delivery_id,owner_rec.get("sessionId"))))
            if len(rows)!=1:
                raise ReliabilityError("acknowledgement requires the owned target SID")
            row=rows[0]
            if row["native_state"] not in ("socket_written_unconfirmed","handoff_unknown"):
                raise ReliabilityError("no native handoff to acknowledge")
            if row["target_generation"]!=canonical_json(generation(owner_rec)):
                raise ReliabilityError("acknowledgement generation mismatch")
            key=(row["origin_node"],row["origin_inc"],row["id"])
            if row["acknowledged"]:
                return False
            disclosure="pending" if read and row["read_requested"] else "suppressed"
            db.execute("UPDATE inbox SET acknowledged=1,disclosure=? WHERE origin_node=? AND origin_inc=? AND id=?",(disclosure,*key))
            if disclosure=="pending":
                self._receipt(db,dict(row),"receiver_acknowledged",{"target_sid":row["target_sid"],"target_generation":json.loads(row["target_generation"]),"declared_at":now})
            return True

    def receipt_rows(self, peer=None):
        with self.connection() as db:
            rows=db.execute("SELECT * FROM receipts"+(" WHERE peer=?" if peer else ""),(peer,) if peer else ())
            return [dict(r) for r in rows]

    def reserve_receipt(self, receipt_id, explicit=False, reactive=False):
        with self.transaction() as db:
            now=self._clock(db);cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM receipts WHERE id=?",(receipt_id,)).fetchone()
            allowed_states=("pending","reserved","sending","received") if reactive else ("pending","reserved","sending")
            if not row or row["state"] not in allowed_states or reactive and row["kind"]!="peer_received":
                return None
            if row["kind"]=="receiver_acknowledged" and (not read or row["privacy_suppressed"]):
                db.execute("UPDATE receipts SET state='suppressed' WHERE id=?",(receipt_id,));return None
            if not retry and not explicit and not reactive:
                return None
            if row["expires"]<=now or row["attempts"]>=cfg["max_attempts"]:
                if row["state"]!="received":db.execute("UPDATE receipts SET state='expired' WHERE id=?",(receipt_id,))
                return None
            due=row["reactive_next_at"] if reactive else row["next_at"]
            if (not explicit and due>now) or row["owner_until"] and row["owner_until"]>now:
                return None
            owner=str(uuid.uuid4());attempts=row["attempts"]+1;deadline=now+self._delay(cfg,attempts)
            state=row["state"] if reactive else "reserved"
            db.execute("UPDATE receipts SET state=?,send_kind=?,owner=?,owner_until=?,revision=?,attempts=?,next_at=?,reactive_next_at=? WHERE id=?",
                       (state,"reactive" if reactive else "regular",owner,now+cfg["ack_wait"],revision,attempts,
                        row["next_at"] if reactive else deadline,deadline,receipt_id))
            return dict(db.execute("SELECT * FROM receipts WHERE id=?",(receipt_id,)).fetchone())

    def receipt_send_allowed(self, receipt):
        with self.transaction() as db:
            cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM receipts WHERE id=?",(receipt["id"],)).fetchone()
            reactive=row and row["send_kind"]=="reactive"
            allowed=bool(row and row["owner"]==receipt["owner"] and row["revision"]==revision and (row["state"] in ("pending","reserved","sending","received") if reactive else row["state"]=="reserved"))
            if row and row["kind"]=="receiver_acknowledged" and (not read or row["privacy_suppressed"]):
                db.execute("UPDATE receipts SET state='suppressed' WHERE id=?",(row["id"],));return False
            if allowed and not reactive:
                db.execute("UPDATE receipts SET state='sending' WHERE id=?",(row["id"],))
            return allowed

    def receipt_finished(self, receipt_id, owner):
        with self.transaction() as db:
            cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM receipts WHERE id=? AND owner=?",(receipt_id,owner)).fetchone()
            if row and (row["send_kind"]=="reactive" or row["state"]=="received"):
                db.execute("UPDATE receipts SET owner_until=NULL WHERE id=?",(receipt_id,))
                return
            if row and row["state"]=="sending":
                state="suppressed" if row["kind"]=="receiver_acknowledged" and (not read or row["revision"]!=revision or row["privacy_suppressed"]) else "pending"
                db.execute("UPDATE receipts SET owner_until=NULL,state=? WHERE id=?",(state,receipt_id))

    def receipt_ack(self, receipt_id, peer_identity):
        with self.transaction() as db:
            row=db.execute("SELECT * FROM receipts WHERE id=?",(receipt_id,)).fetchone()
            if not row or (row["peer_node"],row["peer_inc"])!=tuple(peer_identity):
                return False
            if row["state"]!="suppressed":
                db.execute("UPDATE receipts SET state='received' WHERE id=?",(receipt_id,))
            return True

    def received_receipt(self, message, peer_identity):
        with self.transaction() as db:
            row=db.execute("SELECT * FROM outbox WHERE id=?",(message.get("delivery_id"),)).fetchone()
            if not isinstance(message.get("payload"),dict) or not isinstance(message.get("id"),str) or not re.fullmatch(r"[0-9a-f]{64}",message["id"]):
                return False
            if not row or (row["peer_node"],row["peer_inc"],row["target_sid"])!=(peer_identity[0],peer_identity[1],message["payload"].get("target_sid")):
                return False
            kind=message.get("kind")
            if kind=="peer_received":
                db.execute("UPDATE outbox SET transport='peer_received',attempt_until=NULL WHERE id=?",(row["id"],))
            elif kind=="native_handoff":
                payload=message.get("payload",{})
                binding=payload.get("target_generation")
                if not isinstance(binding,dict) or type(binding.get("pid")) is not int or binding["pid"]<=0 or not isinstance(binding.get("procStart"),str) or not isinstance(binding.get("pidDomain"),str) or payload.get("native_state") not in ("socket_written_unconfirmed","handoff_unknown"):
                    return False
                db.execute("UPDATE outbox SET native_state=?,target_generation=? WHERE id=?",(payload["native_state"],canonical_json(binding),row["id"]))
                updated=db.execute("SELECT * FROM outbox WHERE id=?",(row["id"],)).fetchone()
                self._reconcile_native_status(db,updated)
            elif kind=="receiver_acknowledged":
                payload=message.get("payload",{});declared=payload.get("declared_at")
                if type(declared) not in (int,float) or not math.isfinite(declared) or declared>self._clock(db)+load_config()["clock_skew"] or row["target_generation"]!=canonical_json(payload.get("target_generation")):
                    return False
                db.execute("UPDATE outbox SET acknowledged=1 WHERE id=?",(row["id"],))
            else:
                return False
            return True

    def _admission(self, db, row, state):
        if row["admission"] in ("denied","refused","dropped","expired") or row["admission"]=="delivered" and state=="held":
            return False
        db.execute("UPDATE outbox SET admission=?,disposition=? WHERE id=?",(state,"terminal" if state in ("denied","refused","dropped","expired") else row["disposition"],row["id"]))
        return True

    def _reconcile_native_status(self, db, row):
        pending=list(db.execute("SELECT * FROM native_status_pending WHERE delivery_id=? ORDER BY observed,id",(row["id"],)))
        for fact in pending:
            if (fact["peer_node"],fact["peer_inc"],fact["channel"],fact["source_sid"],fact["source_generation"],fact["target_sid"],fact["target_generation"],fact["native_id"]) == (row["peer_node"],row["peer_inc"],row["channel"],row["source_sid"],row["source_generation"],row["target_sid"],row["target_generation"],row["native_id"]):
                current=db.execute("SELECT * FROM outbox WHERE id=?",(row["id"],)).fetchone()
                self._admission(db,current,fact["status"])
            db.execute("DELETE FROM native_status_pending WHERE id=?",(fact["id"],))

    def native_status(self, peer_identity, sender_sid, target_sid, target_generation, frame, source_generation=None, ingress_channel=None):
        if frame.get("type")!="control" or frame.get("action")!="peer_message_status":
            return 0
        state=frame.get("status")
        if state=="expired" and frame.get("status_detail")=="refused":
            state="refused"
        if state not in ("held","denied","expired","delivered","refused","dropped"):
            return 0
        ids=[]
        if safe_identifier(frame.get("orig_msg_id")):
            ids.append(frame["orig_msg_id"])
        if state=="dropped" and isinstance(frame.get("dropped_msg_ids"),list):
            ids += [x for x in frame["dropped_msg_ids"][:100] if safe_identifier(x)]
        changed=0
        with self.transaction() as db:
            for native_id in set(ids):
                row=db.execute("SELECT * FROM outbox WHERE native_id=? AND source_sid=? AND target_sid=? AND peer_node=? AND peer_inc=?",
                               (native_id,sender_sid,target_sid,peer_identity[0],peer_identity[1])).fetchone()
                if not row or not ingress_channel or row["channel"]!=ingress_channel or source_generation is None or row["source_generation"]!=canonical_json(source_generation):
                    continue
                target_binding=canonical_json(target_generation)
                if row["target_generation"] is None:
                    if db.execute("SELECT COUNT(*) FROM native_status_pending WHERE delivery_id=?",(row["id"],)).fetchone()[0]>=64:
                        continue
                    identity={"delivery":row["id"],"peer":peer_identity,"channel":ingress_channel,"source":sender_sid,"source_generation":source_generation,
                              "target":target_sid,"target_generation":target_generation,"native":native_id,"status":state}
                    fact_id=hashlib.sha256(canonical_json(identity).encode()).hexdigest()
                    if not db.execute("SELECT 1 FROM native_status_pending WHERE id=?",(fact_id,)).fetchone():
                        self._budget(db,[],metadata_rows=1,control=True)
                        db.execute("INSERT INTO native_status_pending VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",(fact_id,row["id"],peer_identity[0],peer_identity[1],ingress_channel,sender_sid,row["source_generation"],target_sid,target_binding,native_id,state,self._clock(db),row["retain_until"]))
                        changed+=1
                    continue
                if row["target_generation"]!=target_binding:
                    continue
                if self._admission(db,row,state):
                    changed+=1
        return changed

    def status(self, inbox_sid=None):
        with self.connection() as db:
            if inbox_sid is not None:
                rows=db.execute("SELECT id,native_id,source_sid,target_sid,native_state,admission,acknowledged,disposition,expires FROM inbox WHERE target_sid=?",(inbox_sid,))
            else:
                rows=db.execute("SELECT id,native_id,target_peer,target_sid,transport,native_state,admission,acknowledged,disposition,attempts,expires FROM outbox")
            return [dict(r) for r in rows]

    def bind_local_outgoing(self, delivery_id):
        with self.transaction() as db:
            row=db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone()
            if not row or row["target_peer"]!="@local":
                raise ReliabilityError("not a local delivery")
            if row["mode"] not in ("unbound","durable") or row["peer_node"] and (row["peer_node"],row["peer_inc"])!=(self.node_id,self.incarnation):
                raise ReliabilityError("local reliability identity changed")
            db.execute("UPDATE outbox SET mode='durable',peer_node=?,peer_inc=?,channel='local' WHERE id=?",(self.node_id,self.incarnation,delivery_id))
            return dict(db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone())

    def apply_local_receipts(self, explicit=False):
        for row in self.receipt_rows("@local"):
            if row["state"] in ("suppressed","expired","received"):
                continue
            with self.transaction() as db:
                cfg,read,retry,revision=self._policy(db)
                fresh=db.execute("SELECT * FROM receipts WHERE id=?",(row["id"],)).fetchone()
                if fresh["kind"]=="receiver_acknowledged" and (not read or fresh["privacy_suppressed"]):
                    db.execute("UPDATE receipts SET state='suppressed' WHERE id=?",(row["id"],));continue
                if not retry and not explicit:
                    continue
            message={"id":row["id"],"delivery_id":row["delivery_id"],"kind":row["kind"],"payload":json.loads(row["payload"])}
            if self.received_receipt(message,(self.node_id,self.incarnation)):
                self.receipt_ack(row["id"],(self.node_id,self.incarnation))

    def explicit_retry(self, delivery_id, owner_rec):
        with self.transaction() as db:
            now=self._clock(db);cfg,read,retry,revision=self._policy(db)
            row=db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone()
            if not row or row["source_sid"]!=(owner_rec or {}).get("sessionId","") or row["source_generation"]!=canonical_json(generation(owner_rec or {})):
                raise ReliabilityError("retry requires the original owning session generation")
            if row["transport"]!="queued" or row["mode"]=="legacy" and row["legacy_started"] or row["disposition"] in ("terminal","needs_reconcile") or row["admission"] in ("held","denied","refused","dropped","expired") or row["expires"]<=now or row["attempts"]>=cfg["max_attempts"]:
                raise ReliabilityError("message is not safely retryable")
            self._budget(db,[],metadata_rows=1)
            token=str(uuid.uuid4())
            db.execute("INSERT INTO explicit_grants(token,delivery_id,peer,owner_sid,owner_generation,purpose,created,expires) VALUES (?,?,?,?,?,?,?,?)",
                       (token,delivery_id,row["target_peer"],row["source_sid"],row["source_generation"],"outgoing_retry",now,min(now+60,row["expires"])))
            db.execute("UPDATE outbox SET next_at=?,attempt_until=NULL WHERE id=?",(now,delivery_id))
            result=dict(db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone());result["explicit_grant"]=token
            return result

    def consume_explicit_grant(self, token, delivery_id, peer, owner_rec):
        with self.transaction() as db:
            now=self._clock(db);self._policy(db)
            grant=db.execute("SELECT * FROM explicit_grants WHERE token=?",(token,)).fetchone()
            if not grant or grant["used"] or grant["expires"]<=now or (grant["delivery_id"],grant["peer"],grant["owner_sid"],grant["owner_generation"],grant["purpose"])!=(delivery_id,peer,owner_rec.get("sessionId"),canonical_json(generation(owner_rec)),"outgoing_retry"):
                return False
            row=db.execute("SELECT * FROM outbox WHERE id=?",(delivery_id,)).fetchone()
            if not row or row["transport"]!="queued" or row["disposition"] in ("terminal","needs_reconcile") or row["admission"] in ("held","denied","refused","dropped","expired"):
                return False
            db.execute("UPDATE explicit_grants SET used=1 WHERE token=? AND used=0",(token,))
            return True

    def gc(self):
        with self.transaction() as db:
            now=self._clock(db)
            for table in ("outbox","inbox"):
                db.execute("UPDATE "+table+" SET frame=NULL,payload_bytes=0 WHERE expires<=?",(now,))
                db.execute("DELETE FROM "+table+" WHERE retain_until<?",(now,))
            db.execute("DELETE FROM receipts WHERE retain_until<?",(now,))
            db.execute("DELETE FROM native_status_pending WHERE retain_until<?",(now,))
            db.execute("DELETE FROM explicit_grants WHERE expires<?",(now,))
            self._gc_routes(db,now)
        # auto_vacuum=NONE retains its high-water file after deletion. Reclaim only
        # after GC committed; valid replay/dedup records are never deleted for space.
        with self.connection() as db:
            capacity=self._capacity(db,load_config())
            if capacity["free"] and capacity["required_bytes"] > capacity["available_bytes"]:
                db.execute("PRAGMA temp_store=MEMORY")
                db.execute("VACUUM")


# -------------------------------------------------------------------- audit
_audit_lock = threading.Lock()


def audit(ev, **kw):
    """Append-only JSONL trail of every join/leave/task change and every
    message that crosses the bridge or is sent through ccm or SendMessage."""
    rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "node": load_config()["label"], "ev": ev}
    rec.update({k: v for k, v in kw.items() if v is not None})
    line = (json.dumps(rec, ensure_ascii=False) + "\n").encode()
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        with _audit_lock:
            try:
                if os.path.getsize(AUDITFILE) > AUDIT_MAX:
                    os.replace(AUDITFILE, AUDITFILE + ".1")
            except OSError:
                pass
            fd = os.open(AUDITFILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            try:
                os.write(fd, line)
            finally:
                os.close(fd)
    except OSError as e:
        log("audit write failed:", e)


SECRET_RES = [
    # ASCII lookarounds instead of \b: in CJK text a key often follows a letter with no space
    re.compile(r"(?<![A-Za-z0-9])(?:sk|pk|rk|ctx7sk|sess|ghp|gho|ghs|github_pat|glpat|xox[abprs])[-_][A-Za-z0-9_\-]{12,}"),
    re.compile(r"(?<![A-Za-z0-9])AKIA[0-9A-Z]{16}(?![A-Za-z0-9])"),
    re.compile(r"(?i)(?<![A-Za-z0-9])(bearer|basic)\s+[A-Za-z0-9._\-+=/]{16,}"),
    re.compile(r"(?<![A-Za-z0-9])eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    re.compile(r"""(?i)(?<![a-z0-9])(["']?[A-Z0-9_]*(?:password|passwd|pwd|secret|token|api[_-]?key)["']?)(\s*[:=]\s*["']?)[^\s"',}]+(["']?)"""),
    re.compile(r"://[^/\s:@]+:[^/\s@]+@"),
    re.compile(r"(?<![A-Za-z0-9])(?:[A-Fa-f0-9]{40,}|[A-Za-z0-9+/]{48,}={0,2})(?![A-Za-z0-9])"),
]


def redact(text):
    """Tasks and previews travel to other machines and into other agents' context;
    strip anything that looks like a credential first."""
    if not isinstance(text, str):
        return text
    for r in SECRET_RES:
        text = r.sub(lambda m: (m.group(1) + (m.group(2) if m.lastindex and m.lastindex > 1 else " ") + "[redacted]" + (m.group(3) if m.lastindex and m.lastindex >= 3 else ""))
                     if m.lastindex else ("://[redacted]@" if m.group(0).startswith("://") else "[redacted]"), text)
    return text


def preview(text):
    n = load_config()["audit_preview_chars"]
    if not n or not isinstance(text, str):
        return None
    text = re.sub(r"^<cross-session-message[^>]*>\n?", "", text)
    text = re.sub(r"\n?</cross-session-message>\s*$", "", text)
    text = redact(" ".join(text.split()))
    return text[:n] + ("…" if len(text) > n else "")


def frame_text(frame):
    c = (frame.get("message") or {}).get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return next((b.get("text") for b in c if isinstance(b, dict) and isinstance(b.get("text"), str)), None)
    return None


def header_attr(text, attr):
    m = re.match(r'<cross-session-message\b[^>]*\b' + attr + r'="([^"]*)"', text or "")
    return m.group(1) if m else None


class Counters:
    def __init__(self):
        self.data = read_json(COUNTERSFILE, {}) or {}
        self.lock = threading.Lock()
        self.dirty = False

    def bump(self, peer, key):
        with self.lock:
            self.data.setdefault(peer, {"relay_out": 0, "relay_in": 0, "errors": 0})
            self.data[peer][key] = self.data[peer].get(key, 0) + 1
            self.dirty = True

    def flush(self):
        with self.lock:
            if self.dirty:
                write_json_private(COUNTERSFILE, self.data)
                self.dirty = False


COUNTERS = Counters()


# ---------------------------------------------------------------- platform ids
# Must match how Claude Code identifies live processes (docs/PROTOCOL.md), or
# the mirror's registry record is silently ignored.

def proc_start(pid):
    if IS_LINUX:
        try:
            with open(f"/proc/{pid}/stat") as f:
                return f.read().rsplit(")", 1)[1].split()[19]
        except OSError:
            return None
    try:
        out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                             env={**os.environ, "LC_ALL": "C", "TZ": "UTC"}, timeout=2)
        return out.stdout.strip() or None
    except Exception:
        return None


def pid_domain():
    if not IS_LINUX:
        return "darwin" if sys.platform == "darwin" else sys.platform
    try:
        with open('/etc/machine-id') as f:
            return f"linux:{f.read().strip()}:{os.readlink('/proc/self/ns/pid')}"
    except OSError:
        return None


def ancestor_pids():
    """Only an actual ancestor can own the Claude session running this CLI."""
    pid, seen = os.getppid(), []
    while pid > 1 and pid not in seen and len(seen) < 64:
        seen.append(pid)
        try:
            if IS_LINUX:
                with open(f"/proc/{pid}/stat") as f:
                    pid = int(f.read().rsplit(")", 1)[1].split()[1])
            else:
                result = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                                        capture_output=True, text=True, timeout=2)
                pid = int(result.stdout.strip())
        except (OSError, ValueError, subprocess.TimeoutExpired):
            break
    return seen


def socket_dir():
    for rec in read_sessions(include_mirrors=True):
        return os.path.dirname(rec["messagingSocketPath"])
    base = os.environ.get("CLAUDE_CODE_TMPDIR") or os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(base, "cc-socks")


def key_path(pid, sock):
    # path.resolve semantics: absolute, but symlinks (/tmp on macOS) are kept
    h = hashlib.sha256(os.path.abspath(sock).encode()).hexdigest()
    return os.path.join(SESSIONS_DIR, f"{pid}.{h}.key")


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def read_sessions(include_mirrors=False):
    out = []
    try:
        names = os.listdir(SESSIONS_DIR)
    except OSError:
        return out
    for n in names:
        if not re.fullmatch(r"\d+\.json", n):
            continue
        rec = read_json(os.path.join(SESSIONS_DIR, n))
        if not isinstance(rec, dict):
            continue
        if not include_mirrors and rec.get("agent") == MIRROR_TAG:
            continue
        pid = rec.get("pid")
        if not isinstance(pid, int) or pid <= 0 or not pid_alive(pid) or not rec.get("messagingSocketPath"):
            continue
        if not rec.get("procStart") or rec["procStart"] != proc_start(pid):
            continue
        if not rec.get("pidDomain") or rec["pidDomain"] != pid_domain():
            continue
        out.append(rec)
    return out


def is_mirror(rec):
    return rec.get("agent") == MIRROR_TAG


def display_name(rec):
    return rec.get("name") or os.path.basename(rec.get("cwd") or "") or str(rec.get("pid"))


def deliver_local(sock, pid, frame, expected_sid=None, expected_generation=None, structured=False, prewrite_check=None):
    """A successful socket write is not native admission, reading, or approval."""
    result = {"state": "prewrite_failed", "error": "target_unavailable", "safe_to_retry": True}
    target = next((r for r in read_sessions(include_mirrors=True) if r["pid"] == pid and r["messagingSocketPath"] == sock), None)
    if target and (expected_sid is None or target.get("sessionId") == expected_sid) and (expected_generation is None or generation(target) == expected_generation):
        kp = read_json(key_path(pid, sock))
        if not kp or not isinstance(kp.get("peerToken"), str) or any(kp.get(k) != target.get(k) for k in ("procStart", "pidDomain")):
            result["error"] = "key_generation_mismatch"
        else:
            c = None
            io_started = False
            try:
                data = (json.dumps({"type": "auth", "token": kp["peerToken"]}) + "\n" +
                        json.dumps(frame, ensure_ascii=False, allow_nan=False) + "\n").encode()
                if len(data) > MAX_FRAME:
                    result["error"] = "message_too_large"
                else:
                    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    c.settimeout(5)
                    c.connect(sock)
                    current = next((r for r in read_sessions(include_mirrors=True) if r["pid"] == pid and r.get("sessionId") == target.get("sessionId") and generation(r) == generation(target)), None)
                    if not current or prewrite_check is not None and not prewrite_check():
                        result["error"] = "dispatch_fence_changed"
                    else:
                        # Once sendall starts, a timeout cannot certify zero native side effects.
                        io_started = True
                        c.sendall(data)
                        time.sleep(0.15)
                        c.shutdown(socket.SHUT_WR)
                        result = {"state": "socket_written_unconfirmed", "error": None, "safe_to_retry": False}
            except (OSError, ValueError, TypeError):
                result = {"state": "handoff_unknown" if io_started else "prewrite_failed",
                          "error": "native_write_uncertain" if io_started else "native_prewrite_failed", "safe_to_retry": not io_started}
            finally:
                if c is not None:
                    c.close()
    if structured:
        return result
    return None if result["state"] == "socket_written_unconfirmed" else result["error"]


# ------------------------------------------------------------------- roster
def roster_path(sid):
    return os.path.join(ROSTER_DIR, f"{re.sub(r'[^A-Za-z0-9-]', '', sid)}.json")


def roster_get(sid):
    return read_json(roster_path(sid)) if sid else None


def roster_put(sid, **kw):
    clean_sid = re.sub(r'[^A-Za-z0-9-]', '', sid)
    lock_path = os.path.join(ROSTER_DIR, f"{clean_sid}.lock")
    os.makedirs(ROSTER_DIR, mode=0o700, exist_ok=True)
    try:
        lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            cur = roster_get(sid) or {"sessionId": sid, "joinedAt": now_ms()}
            cur.update({k: v for k, v in kw.items() if v is not None})
            cur["updatedAt"] = now_ms()
            write_json_private(roster_path(sid), cur)
            return cur
        finally:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
            os.close(lock_fd)
    except OSError:
        cur = roster_get(sid) or {"sessionId": sid, "joinedAt": now_ms()}
        cur.update({k: v for k, v in kw.items() if v is not None})
        cur["updatedAt"] = now_ms()
        write_json_private(roster_path(sid), cur)
        return cur


def roster_drop(sid):
    clean_sid = re.sub(r'[^A-Za-z0-9-]', '', sid)
    try:
        os.unlink(os.path.join(ROSTER_DIR, f"{clean_sid}.lock"))
    except OSError:
        pass
    try:
        os.unlink(roster_path(sid))
        return True
    except OSError:
        return False


def roster_sweep(live_sids):
    try:
        names = os.listdir(ROSTER_DIR)
    except OSError:
        return
    for n in names:
        if not n.endswith(".json"):
            continue
        rec = read_json(os.path.join(ROSTER_DIR, n)) or {}
        sid = rec.get("sessionId")
        if sid in live_sids:
            continue
        if now_ms() - rec.get("updatedAt", 0) > ROSTER_GRACE * 1000:
            roster_drop(sid or n[:-5])
            audit("leave", session=rec.get("name"), sessionId=sid, reason="swept (session gone)")


def _human_prompt(line):
    if '"user"' not in line:
        return None
    try:
        d = json.loads(line)
    except ValueError:
        return None
    origin = (d.get("origin") or {}).get("kind")
    if d.get("type") != "user" or d.get("isMeta") or d.get("isSidechain") or (origin is not None and origin != "human"):
        return None
    c = (d.get("message") or {}).get("content")
    t = c if isinstance(c, str) else next((b.get("text") for b in c or [] if isinstance(b, dict) and b.get("type") == "text"), None)
    return task_from_prompt(t)


def infer_task(rec):
    """For sessions without a hook-registered task (started before the plugin):
    the latest human prompt in the transcript. Scans backwards in 1 MB chunks and
    caches the answer in the roster, so it is computed once per session."""
    sid = rec.get("sessionId")
    if not sid:
        return None
    cached = roster_get(sid)
    if cached and "task" in cached:
        return redact(cached["task"])
    proj = re.sub(r"[^A-Za-z0-9]", "-", rec.get("cwd") or "")
    path = os.path.join(CLAUDE_DIR, "projects", proj, f"{sid}.jsonl")
    task = None
    try:
        with open(path, "rb") as f:
            end = f.seek(0, 2)
            tail = b""
            pos = end
            while pos > 0 and end - pos < 32 * 1024 * 1024 and not task:
                n = min(1024 * 1024, pos)
                pos -= n
                f.seek(pos)
                chunk = f.read(n) + tail
                lines = chunk.split(b"\n")
                tail = lines[0] if pos > 0 else b""
                for l in reversed(lines[1:] if pos > 0 else lines):
                    task = _human_prompt(l.decode("utf8", "replace"))
                    if task:
                        break
    except OSError:
        return None
    roster_put(sid, pid=rec.get("pid"), name=display_name(rec), cwd=rec.get("cwd"), task=task if task is not None else "", taskSource="inferred")
    return task


# text Claude Code injects as user turns: peer messages, skill bodies, resumes
NOT_A_TASK = ("<", "/", "[Request interrupted", "Another Claude session", "Base directory for this skill",
              "This session is being continued", "Caveat:")


def task_from_prompt(p):
    if not isinstance(p, str):
        return None
    p = p.strip()
    if not p or p.startswith(NOT_A_TASK) or len(p) < 6:
        return None
    first = next((l.strip() for l in p.splitlines() if l.strip()), "")
    first = redact(" ".join(first.split()))
    return first[:140] + ("…" if len(first) > 140 else "")


def roster_rows(infer=True):
    """Every member this machine can reach: local sessions + mirrors."""
    rows = []
    for rec in read_sessions(include_mirrors=True):
        if is_mirror(rec):
            rows.append({"name": rec.get("name"), "node": rec.get("ccmHost"), "remote": True,
                         "status": rec.get("status"), "task": rec.get("ccmTask"), "cwd": rec.get("cwd"),
                         "sessionId": rec.get("sessionId")})
        else:
            r = roster_get(rec.get("sessionId")) or {}
            task = redact(r.get("task")) if "task" in r else (infer_task(rec) if infer else None)
            rows.append({"name": display_name(rec), "node": load_config()["label"], "remote": False,
                         "status": rec.get("status"), "task": task,
                         "cwd": rec.get("cwd"), "sessionId": rec.get("sessionId")})
    rows.sort(key=lambda r: (r["remote"], r["node"] or "", r["name"] or ""))
    return rows


# ------------------------------------------------------------------- mirror
def cmd_mirror(a):
    """One process per remote session. Owning a real pid lets it publish a
    registry record, key and inbox that local Claude Code accepts as a peer.
    Received frames go to stdout; status/task updates come in on stdin."""
    pid = os.getpid()
    os.makedirs(SESSIONS_DIR, mode=0o700, exist_ok=True)
    sdir = socket_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    sock = os.path.join(sdir, f"{pid}.sock")
    token = secrets.token_hex(16)
    ps = proc_start(pid)
    dom = pid_domain()
    reg_path = os.path.join(SESSIONS_DIR, f"{pid}.json")
    kpath = key_path(pid, sock)
    remote = json.loads(a.remote)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.unlink(sock)
    except OSError:
        pass
    srv.bind(sock)
    os.chmod(sock, 0o600)
    srv.listen(16)

    def cleanup(*_):
        for p in (reg_path, kpath, sock):
            try:
                os.unlink(p)
            except OSError:
                pass
        os._exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    write_json_private(kpath, {"peerToken": token, "procStart": ps, "pidDomain": dom})
    now = now_ms()
    task = remote.get("task")
    reg = {
        "pid": pid, "sessionId": remote.get("sessionId"), "cwd": remote.get("cwd") or HOME,
        "startedAt": now, "procStart": ps, "version": remote.get("version") or "claude-code-message",
        "peerProtocol": remote.get("peerProtocol", 1), "peerFeatures": remote.get("peerFeatures") or [],
        "kind": "interactive", "entrypoint": "cli", "pidDomain": dom, "messagingSocketPath": sock,
        "name": a.name, "nameSource": "user", "nameSince": now, "agent": MIRROR_TAG,
        "ccmHost": a.peer, "ccmRemoteName": remote.get("name"), "ccmTask": task,
        "ccmRemoteGeneration": generation(remote),
        "detail": f"[{a.peer}] {task}" if task else f"[{a.peer}] {remote.get('name')}",
        "status": remote.get("status") or "idle", "updatedAt": now, "statusUpdatedAt": now,
    }
    write_json_private(reg_path, reg)
    print(json.dumps({"ready": True, "pid": pid, "sock": sock}), flush=True)

    def stdin_loop():
        for line in sys.stdin:
            try:
                upd = json.loads(line)
            except ValueError:
                continue
            changed = False
            if upd.get("status") and upd["status"] != reg["status"]:
                reg["status"] = upd["status"]
                reg["statusUpdatedAt"] = now_ms()
                changed = True
            if "task" in upd and upd["task"] != reg.get("ccmTask"):
                reg["ccmTask"] = upd["task"]
                reg["detail"] = f"[{a.peer}] {upd['task']}" if upd["task"] else f"[{a.peer}] {reg['ccmRemoteName']}"
                changed = True
            if changed:
                reg["updatedAt"] = now_ms()
                write_json_private(reg_path, reg)
        cleanup()

    threading.Thread(target=stdin_loop, daemon=True).start()
    out_lock = threading.Lock()

    def handle(c):
        buf = b""
        c.settimeout(3)
        try:
            while len(buf) <= MAX_FRAME + 4096:
                d = c.recv(65536)
                if not d:
                    break
                buf += d
        except OSError:
            pass
        finally:
            c.close()
        lines = [l for l in buf.split(b"\n") if l.strip()]
        if not lines:
            return  # liveness probe
        try:
            first = json.loads(lines[0])
        except ValueError:
            return
        if first.get("type") != "auth" or not secrets.compare_digest(str(first.get("token", "")), token):
            log("mirror: unauthenticated frame dropped")
            return
        for l in lines[1:]:
            try:
                frame = json.loads(l)
            except ValueError:
                continue
            delivery_id = None
            if frame.get("type") == "user" and safe_identifier(frame.get("msg_id")) and safe_identifier(remote.get("sessionId")):
                try:
                    address = frame.get("from")
                    path = os.path.abspath(unquote(address[4:])) if isinstance(address, str) and address.startswith("uds:") else None
                    source = next((r for r in read_sessions() if path and os.path.abspath(r["messagingSocketPath"]) == path), None)
                    delivery_id = ReliabilityStore().enqueue([{"peer":a.peer,"sid":remote["sessionId"]}],frame,source)[0]["id"]
                except (OSError, sqlite3.Error, ReliabilityError, ValueError):
                    log("mirror: durable acceptance failed")
                    continue
            with out_lock:
                print(json.dumps({"frame": frame, "delivery_id": delivery_id}, ensure_ascii=False), flush=True)

    while True:
        c, _ = srv.accept()
        threading.Thread(target=handle, args=(c,), daemon=True).start()


# --------------------------------------------------------------------- node
class Node:
    """One end of a link; both ends run the same logic: publish local sessions
    (with their registered task), mirror the peer's, relay frames both ways."""

    def __init__(self, rfile, wfile, label, peer_label=None, is_server=False, trusted_link=None):
        self.rfile, self.wfile = rfile, wfile
        self.trusted_link = trusted_link
        self.peer_identity = None
        self.durable_peer = False
        self.peer_advertised = False
        self.remote_records = []
        self._store = None
        self.label = label
        self.peer_label = peer_label
        self.is_server = is_server
        self.wlock = threading.Lock()
        self.scanlock = threading.RLock()
        self.mlock = threading.Lock()
        self.mirrors = {}      # remote pid -> {"proc","sock","pid","name","rec"}
        self.local = {}        # local pid -> registry record
        self.last_pub = None
        self.stop = threading.Event()
        self.session = {"relay_out": 0, "relay_in": 0, "errors": 0}

    @property
    def store(self):
        if self._store is None:
            self._store = ReliabilityStore()
        return self._store

    def send(self, obj):
        data = (json.dumps(obj, ensure_ascii=False, allow_nan=False) + "\n").encode()
        if len(data) > MAX_FRAME:
            raise ReliabilityError("link envelope too large")
        with self.wlock:
            self.wfile.write(data)
            self.wfile.flush()

    def remote_by_sid(self, sid):
        rows = [r for r in self.remote_records if r.get("sessionId") == sid]
        return rows[0] if len(rows) == 1 else None

    def mirror_by_sid(self, sid):
        rows = [m for m in list(self.mirrors.values()) if m["rec"].get("sessionId") == sid]
        return rows[0] if len(rows) == 1 else None

    def capture_outgoing(self, frame, remote):
        source = self.local_by_sock(frame.get("from"))
        if not source:
            records = read_sessions()
            path = unquote(frame.get("from", "uds:")[4:]) if isinstance(frame.get("from"), str) else ""
            source = next((r for r in records if os.path.abspath(r["messagingSocketPath"]) == os.path.abspath(path)), None) if path else None
        return self.store.enqueue([{"peer":self.peer_label,"sid":remote["sessionId"]}],frame,source)[0]

    def send_outgoing(self, delivery_id, explicit=False):
        if not self.peer_advertised:
            return False
        rows = [r for r in self.store.outbox_rows(self.peer_label) if r["id"] == delivery_id]
        if not rows:
            return False
        row = rows[0]
        if self.durable_peer:
            mode = "durable"
        else:
            mode = "legacy"
            target = self.remote_by_sid(row["target_sid"])
            if not target:
                return False
        source = next((r for r in self.local.values() if r.get("sessionId") == row["source_sid"]),None)
        if row["source_sid"] and not source:
            return False
        attempt = self.store.reserve_outgoing(delivery_id,self.trusted_link,self.peer_identity,mode,explicit=explicit)
        if not attempt:
            return False
        outcome = "not_started"
        try:
            if not self.store.outgoing_send_allowed(attempt,explicit=explicit):
                return False
            outcome = "sent"
            if mode == "durable":
                self.send(self.store.outgoing_envelope(attempt))
            else:
                target = self.remote_by_sid(attempt["target_sid"])
                self.send({"op":"deliver","to_pid":target["pid"],"from_pid":source and source["pid"],"frame":json.loads(attempt["frame"])})
            self.bump("relay_out")
        except (OSError, ValueError, ReliabilityError):
            outcome = "uncertain"
        finally:
            self.store.outgoing_finished(delivery_id,attempt["attempt_owner"],outcome)
            audit("relay_out",msg_id=attempt["native_id"],delivery_id=attempt["id"],peer=self.peer_label,
                  relay_node=self.label,to=attempt["target_sid"],state="link_written_unconfirmed" if outcome=="sent" else outcome,
                  ok=outcome=="sent",attempt=attempt["attempts"],preview=preview(frame_text(json.loads(attempt["frame"]))))
        return outcome == "sent"

    def send_receipt(self, row, explicit=False, reactive=False):
        if not self.durable_peer or (row["peer_node"],row["peer_inc"]) != self.peer_identity:
            return False
        receipt = self.store.reserve_receipt(row["id"],explicit=explicit,reactive=reactive)
        if not receipt:
            return False
        if not self.store.receipt_send_allowed(receipt):
            return False
        try:
            self.send({"op":"receipt","id":receipt["id"],"delivery_id":receipt["delivery_id"],"kind":receipt["kind"],
                       "node_id":self.store.node_id,"incarnation":self.store.incarnation,"payload":json.loads(receipt["payload"])})
            return True
        except (OSError, ValueError, ReliabilityError):
            return False
        finally:
            self.store.receipt_finished(receipt["id"],receipt["owner"])

    def dispatch_inbox(self, item, explicit=False, local=False):
        key=(item["origin_node"],item["origin_inc"],item["id"])
        targets=[r for r in read_sessions() if r.get("sessionId")==item["target_sid"]]
        if len(targets)!=1:
            self.store.waiting(key,"waiting_target")
            return False
        target=targets[0]
        frame=json.loads(item["frame"]) if item["frame"] else None
        if not frame:
            return False
        if item["source_sid"]:
            if local:
                sources=[r for r in read_sessions() if r.get("sessionId")==item["source_sid"]]
                sender={"sock":sources[0]["messagingSocketPath"],"name":display_name(sources[0])} if len(sources)==1 else None
            else:
                sender=self.mirror_by_sid(item["source_sid"])
            if not sender:
                self.store.waiting(key,"waiting_source_route")
                return False
            frame=rewrite_from(frame,sender["sock"],sender["name"])
        claim=self.store.claim_native(key,target,explicit=explicit)
        if not claim:
            return False
        result=deliver_local(target["messagingSocketPath"],target["pid"],frame,expected_sid=item["target_sid"],
                             expected_generation=generation(target),structured=True,
                             prewrite_check=lambda:self.store.prewrite_allowed(key,claim["dispatch_owner"]))
        # IO test substitutes model only the transport, never production dispatch logic.
        if result is None:
            result={"state":"socket_written_unconfirmed","error":None,"safe_to_retry":False}
        if result["state"] in ("socket_written_unconfirmed","handoff_unknown"):
            self.bump("native_handoffs")
        audit("native_handoff" if result["state"]!="prewrite_failed" else "native_prewrite_failed",
              msg_id=item["native_id"],delivery_id=item["id"],peer=self.peer_label,relay_node=self.label,
              to=item["target_sid"],state=result["state"],ok=result["state"]=="socket_written_unconfirmed")
        try:
            self.store.native_finished(key,claim["dispatch_owner"],result)
        except (sqlite3.Error,OSError,ReliabilityError):
            # native_dispatching remains irreclaimable if the post-write commit fails.
            return False
        if self.durable_peer and explicit and result["state"] in ("socket_written_unconfirmed","handoff_unknown"):
            receipt=next((r for r in self.store.receipt_rows(self.peer_label) if r["delivery_id"]==item["id"] and r["kind"]=="native_handoff"),None)
            if receipt and self.store.claim_explicit_notice("receipts",receipt["id"]):
                self.send_receipt(receipt,explicit=True)
        return result["state"]=="socket_written_unconfirmed"

    def on_reliable_deliver(self, msg):
        if not self.durable_peer or not self.peer_identity:
            return
        row,created=self.store.accept(msg,self.peer_label,self.trusted_link,self.peer_identity)
        self.bump("relay_in" if created else "relay_duplicates")
        audit("relay_in",msg_id=row["native_id"],delivery_id=row["id"],peer=self.peer_label,relay_node=self.label,
              to=row["target_sid"],state="durable_accepted" if created else "deduplicated",ok=True,
              preview=preview(frame_text(msg["frame"])))
        # Acceptance and its dedup/receipt record have committed before this response.
        receipt=next(r for r in self.store.receipt_rows(self.peer_label) if r["delivery_id"]==row["id"] and r["kind"]=="peer_received")
        if created:
            self.send_receipt(receipt,explicit=True)
        else:
            # Reactive transport ACKs use the same persistent attempt budget/lease,
            # not a new explicit grant or an unmetered send bypass.
            self.send_receipt(receipt,reactive=True)
        if created:
            self.dispatch_inbox(row,explicit=True)

    def on_receipt(self, msg):
        if not self.durable_peer or (msg.get("node_id"),msg.get("incarnation"))!=self.peer_identity:
            return
        if self.store.received_receipt(msg,self.peer_identity):
            self.send({"op":"receipt_ack","id":msg.get("id"),"node_id":self.store.node_id,"incarnation":self.store.incarnation})

    def pump(self):
        self.store.recover_dispatches()
        for row in self.store.outbox_rows(self.peer_label):
            self.send_outgoing(row["id"])
        for row in self.store.inbox_rows():
            if row["peer"]==self.peer_label and row["channel"]==self.trusted_link:
                self.dispatch_inbox(row)
        for row in self.store.receipt_rows(self.peer_label):
            self.send_receipt(row)
        self.store.gc()

    def bump(self, key):
        self.session[key] = self.session.get(key,0) + 1
        COUNTERS.bump(self.peer_label or "?", key)

    def scan(self):
        with self.scanlock:
            self.publish_sessions()
        if self.peer_advertised:
            self.pump()

    def publish_sessions(self):
        recs = {r["pid"]: r for r in read_sessions()}
        self.local = recs
        roster_sweep({r.get("sessionId") for r in recs.values()})
        pub = []
        for r in sorted(recs.values(), key=lambda r: r["pid"]):
            if r.get("kind") not in ("interactive", "bg", None):
                continue
            item = {k: r.get(k) for k in ("pid", "sessionId", "name", "cwd", "status", "peerProtocol",
                                          "peerFeatures", "version", "kind", "procStart", "pidDomain")}
            item["task"] = redact((roster_get(r.get("sessionId")) or {}).get("task")) or infer_task(r)
            pub.append(item)
        if pub != self.last_pub:
            self.last_pub = pub
            self.send({"op": "sessions", "label": self.label, "list": pub})

    def mirror_name(self, rec):
        # session names may be any language (users rename sessions); keep word chars of every script
        base = re.sub(r"[^\w.-]+", "-", display_name(rec)).strip("-.") or str(rec["pid"])
        return f"{self.peer_label}-{base}"[:64]

    def sync_mirrors(self, remote_list):
        self.remote_records = list(remote_list)
        self.store.remember_routes(self.peer_label, remote_list)
        want = {r["pid"]: r for r in remote_list}
        with self.mlock:
            for pid in list(self.mirrors):
                m = self.mirrors[pid]
                if pid not in want or m["proc"].poll() is not None or any(want[pid].get(k) != m["rec"].get(k) for k in ("name", "sessionId", "procStart", "pidDomain")):
                    self.kill_mirror(pid)
            for pid, rec in want.items():
                if pid not in self.mirrors:
                    self.spawn_mirror(pid, rec)
                    continue
                m = self.mirrors[pid]
                upd = {}
                if rec.get("status") != m["rec"].get("status"):
                    upd["status"] = rec.get("status")
                if rec.get("task") != m["rec"].get("task"):
                    upd["task"] = rec.get("task")
                m["rec"] = rec
                if upd:
                    try:
                        m["proc"].stdin.write((json.dumps(upd) + "\n").encode())
                        m["proc"].stdin.flush()
                    except OSError:
                        pass

    def spawn_mirror(self, rpid, rec):
        name = self.mirror_name(rec)
        if name in {m["name"] for m in self.mirrors.values()}:
            name = f"{name}-{rpid}"[:64]
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "mirror", "--name", name,
                                 "--peer", self.peer_label, "--remote", json.dumps(rec)],
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        ready = json.loads(proc.stdout.readline() or b"{}")
        if not ready.get("ready"):
            log("mirror failed to start for", rec.get("name"))
            proc.kill()
            return
        self.mirrors[rpid] = {"proc": proc, "sock": ready["sock"], "pid": ready["pid"], "name": name, "rec": rec}
        threading.Thread(target=self.mirror_reader, args=(rpid, proc), daemon=True).start()
        log(f"mirror up: {name} -> {self.peer_label}:{rec.get('name')} (local pid {ready['pid']})")

    def kill_mirror(self, rpid):
        m = self.mirrors.pop(rpid, None)
        if not m:
            return
        try:
            m["proc"].terminate()
            m["proc"].wait(3)
        except Exception:
            m["proc"].kill()
        log(f"mirror down: {m['name']}")

    def mirror_reader(self, rpid, proc):
        for line in proc.stdout:
            try:
                packet = json.loads(line)
                frame = packet["frame"]
            except (ValueError, KeyError):
                continue
            m = self.mirrors.get(rpid) or {}
            text = frame_text(frame)
            if frame.get("type")=="ccm_local":
                source=self.local_by_sock(frame.get("from")) or next((r for r in read_sessions() if frame.get("from")==peer_address(r["messagingSocketPath"])),None)
                if source:
                    if frame.get("action")=="outgoing_retry":
                        with self.scanlock:
                            self.publish_sessions()
                        if self.store.consume_explicit_grant(frame.get("grant"),frame.get("id"),self.peer_label,source):
                            self.send_outgoing(frame["id"],explicit=True)
                    elif frame.get("action")=="receipt":
                        for receipt in self.store.receipt_rows(self.peer_label):
                            if receipt["id"]==frame.get("id"):
                                item=next((r for r in self.store.inbox_rows() if r["id"]==receipt["delivery_id"] and r["target_sid"]==source["sessionId"]),None)
                                if item and self.store.claim_explicit_notice("receipts",receipt["id"]):
                                    if receipt["kind"]=="receiver_acknowledged":
                                        dependency=next((r for r in self.store.receipt_rows(self.peer_label) if r["delivery_id"]==item["id"] and r["kind"]=="native_handoff"),None)
                                        if dependency:
                                            self.send_receipt(dependency,explicit=True)
                                    self.send_receipt(receipt,explicit=True)
                    elif frame.get("action")=="inbox":
                        for item in self.store.inbox_rows():
                            if item["id"]==frame.get("id") and item["target_sid"]==source["sessionId"] and item["peer"]==self.peer_label:
                                self.dispatch_inbox(item,explicit=True)
                continue
            tracked = frame.get("type") == "user" and safe_identifier(frame.get("msg_id")) and safe_identifier((m.get("rec") or {}).get("sessionId"))
            if tracked:
                try:
                    row = self.capture_outgoing(frame,m["rec"])
                    first_notice = self.store.claim_explicit_notice("outbox",row["id"])
                    # The outbox commits even if this one explicit opportunity is lost.
                    with self.scanlock:
                        self.publish_sessions()
                    self.send_outgoing(row["id"],explicit=first_notice)
                except (OSError, sqlite3.Error, ValueError, ReliabilityError):
                    log("message remains queued or requires reconciliation")
                continue
            # Unknown native controls and untracked legacy frames retain their old path.
            with self.scanlock:
                self.publish_sessions()
                src = self.local_by_sock(frame.get("from"))
                self.send({"op": "deliver", "to_pid": rpid, "from_pid": src and src["pid"], "frame": frame})
            self.bump("relay_out")
            audit("relay_out", msg_id=frame.get("msg_id"), frame_type=frame.get("type"),
                  sender=(src and display_name(src)) or header_attr(text, "from-name"),
                  to=m.get("name"), peer=self.peer_label, preview=preview(text))

    def local_by_sock(self, addr):
        if not isinstance(addr, str) or not addr.startswith("uds:"):
            return None
        path = os.path.abspath(unquote(addr[4:]))
        for r in list(self.local.values()):
            if os.path.abspath(r["messagingSocketPath"]) == path:
                return r
        return None

    def on_deliver(self, msg):
        frame = msg["frame"]
        target = {r["pid"]: r for r in read_sessions()}.get(msg["to_pid"])
        sender = self.mirrors.get(msg.get("from_pid"))
        tracked = frame.get("type") == "user" and safe_identifier(frame.get("msg_id"))
        err = "target session gone" if not target else None
        if frame.get("type")=="ccm_local":
            return
        if tracked and target:
            origin = self.peer_identity or ("legacy:" + (self.trusted_link or self.peer_label or "local"), "legacy")
            envelope = {"frame":frame,"target_sid":target["sessionId"],"source_sid":(sender or {}).get("rec",{}).get("sessionId") or "",
                        "source_generation":generation((sender or {}).get("rec",{}))}
            row,created = self.store.accept(envelope,self.peer_label,self.trusted_link,origin,legacy=True)
            if created:
                self.dispatch_inbox(row,explicit=True)
        elif target:
            if self.durable_peer and sender:
                self.store.native_status(self.peer_identity,target.get("sessionId"),sender["rec"].get("sessionId"),generation(sender["rec"]),frame,source_generation=generation(target),ingress_channel=self.trusted_link)
            if sender:
                frame = rewrite_from(frame, sender["sock"], sender["name"])
            err = deliver_local(target["messagingSocketPath"], target["pid"], frame)
        self.bump("relay_in")
        if err:
            self.bump("errors")
            log("deliver failed:", err)
        text = frame_text(frame)
        audit("relay_in", msg_id=frame.get("msg_id"), frame_type=frame.get("type"),
              sender=(sender and sender["name"]) or header_attr(text, "from-name"),
              to=target and display_name(target), peer=self.peer_label, ok=not err, error=err, preview=preview(text))
        self.send({"op": "ack", "id": frame.get("msg_id"), "error": err})

    def run(self):
        self.send({"op": "hello", "label": self.label, "version": VERSION, "proto": PROTO,
                   "reliability": {"schema": RELIABILITY_SCHEMA, "node_id": self.store.node_id,
                                   "incarnation": self.store.incarnation}})

        def scanner():
            while not self.stop.is_set():
                try:
                    self.scan()
                except Exception as e:
                    log("scan error:", e)
                self.stop.wait(SCAN_INTERVAL)

        threading.Thread(target=scanner, daemon=True).start()
        try:
            for line in self.rfile:
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                op = msg.get("op")
                if op == "hello":
                    claimed_label = label_ok(msg.get("label"))
                    if self.peer_label and self.peer_label != claimed_label:
                        raise ReliabilityError("paired peer label changed")
                    if self.is_server and self.peer_label is None and self.trusted_link:
                        self.trusted_link += ":" + claimed_label
                    self.peer_label = self.peer_label or claimed_label
                    self.peer_advertised = True
                    capability = msg.get("reliability")
                    if self.trusted_link and isinstance(capability, dict) and type(capability.get("schema")) is int and capability["schema"] == RELIABILITY_SCHEMA:
                        identity = (capability.get("node_id"),capability.get("incarnation"))
                        if self.store.bind_peer(self.trusted_link,self.peer_label,*identity):
                            self.peer_identity = identity
                            self.durable_peer = True
                        else:
                            self.peer_advertised = False
                            log("paired reliability identity changed; old queues paused")
                    if msg.get("version") != VERSION:
                        log(f"peer runs {msg.get('version')}, we run {VERSION}")
                    if self.is_server and self.peer_label in {p["label"] for p in load_config()["peers"]} and daemon_pid():
                        # both sides dialled each other: two links would mirror everyone twice
                        self.send({"op": "error", "error": f"{self.label} already links to {self.peer_label}; pair from one side only"})
                        return
                    audit("link_up", peer=self.peer_label, role="serve" if self.is_server else "dial", version=msg.get("version"))
                elif op == "sessions":
                    self.peer_label = self.peer_label or label_ok(msg.get("label"))
                    self.sync_mirrors(msg.get("list") or [])
                elif op == "deliver":
                    threading.Thread(target=self.on_deliver, args=(msg,), daemon=True).start()
                elif op == "reliable_deliver":
                    try:
                        self.on_reliable_deliver(msg)
                    except (ReliabilityError, sqlite3.Error, OSError, ValueError):
                        log("reliable delivery rejected or paused")
                elif op == "receipt":
                    self.on_receipt(msg)
                elif op == "receipt_ack" and self.peer_identity and (msg.get("node_id"),msg.get("incarnation")) == self.peer_identity:
                    self.store.receipt_ack(msg.get("id"),self.peer_identity)
                elif op == "ack" and msg.get("error"):
                    log("remote delivery error:", msg)
                elif op == "error":
                    log("peer refused link:", msg.get("error"))
                    audit("link_refused", peer=self.peer_label, error=msg.get("error"))
                    return
        finally:
            self.stop.set()
            with self.mlock:
                for pid in list(self.mirrors):
                    self.kill_mirror(pid)
            COUNTERS.flush()
            audit("link_down", peer=self.peer_label, session_counts=self.session)


def rewrite_from(frame, sock, name):
    """Point the reply address at our local mirror of the sender, in both the
    envelope and the <cross-session-message> header the model reads."""
    frame = json.loads(json.dumps(frame))
    old = frame.get("from")
    new = peer_address(sock)
    if old:
        frame["from"] = new

    def fix(t):
        m = re.match(r"<cross-session-message\b[^>]*>", t)
        if not m:
            return t
        h = m.group(0)
        if old:
            h = h.replace(f'from="{old}"', f'from="{new}"', 1)
        clean_name = peer_name(name)
        h = re.sub(r' from-name="[^"]*"', lambda _: f' from-name="{clean_name}"' if clean_name else "", h, count=1)
        return h + t[m.end():]

    msg = frame.get("message")
    if isinstance(msg, dict):
        c = msg.get("content")
        if isinstance(c, str):
            msg["content"] = fix(c)
        elif isinstance(c, list):
            for b in c:
                if isinstance(b, dict) and isinstance(b.get("text"), str):
                    b["text"] = fix(b["text"])
                    break
    return frame


def local_recovery(store=None, delivery_id=None, explicit=False):
    store = store or ReliabilityStore()
    node = Node(None,None,load_config()["label"],"@local",trusted_link="local")
    node._store = store
    store.recover_dispatches()
    for row in store.outbox_rows("@local"):
        if delivery_id and row["id"] != delivery_id or not row["frame"] or row["transport"] == "peer_received":
            continue
        try:
            bound=store.bind_local_outgoing(row["id"])
            item,created=store.accept(store.outgoing_envelope(bound),"@local","local",(store.node_id,store.incarnation))
            store.peer_received(row["id"],(store.node_id,store.incarnation),row["target_sid"])
        except (ReliabilityError,sqlite3.Error,OSError):
            continue
    for item in store.inbox_rows():
        if item["peer"] == "@local" and (not delivery_id or item["id"]==delivery_id):
            node.dispatch_inbox(item,explicit=explicit,local=True)
    store.apply_local_receipts(explicit=explicit)
    store.gc()


# ------------------------------------------------------------------ links
def cmd_serve(a):
    global LOG_TAG
    LOG_TAG = label_ok(a.label or load_config()["label"])
    if a.label:
        cfg = load_config()
        if cfg.get("label") != LOG_TAG:
            cfg["label"] = LOG_TAG
            save_config(cfg)
    try:
        # The label is descriptive; the existing SSH/OS-account channel is the boundary.
        channel = "incoming-ssh:" + LOG_TAG if os.environ.get("SSH_CONNECTION") else None
        Node(sys.stdin.buffer, sys.stdout.buffer, LOG_TAG, is_server=True, trusted_link=channel).run()
    finally:
        COUNTERS.flush()


def remote_bootstrap(host):
    with open(os.path.abspath(__file__), "rb") as f:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", host,
                            f"mkdir -p ~/.cache/claude-code-message && cat > {REMOTE_SCRIPT}.new && mv {REMOTE_SCRIPT}.new {REMOTE_SCRIPT} && chmod 700 {REMOTE_SCRIPT}"],
                           stdin=f, capture_output=True, timeout=30)
    if r.returncode:
        raise RuntimeError(f"bootstrap to {host} failed: {r.stderr.decode().strip()}")


def run_link(host, label, peer_label, links):
    remote_bootstrap(host)
    cmd = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
           host, f"python3 {REMOTE_SCRIPT} serve --label {peer_label}"]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    node = Node(proc.stdout, proc.stdin, label, peer_label, trusted_link="configured-ssh:" + host)
    links[host] = node
    try:
        node.run()
    finally:
        proc.kill()
        links.pop(host, None)


def daemon_pid():
    try:
        pid = int(open(PIDFILE).read().strip())
        return pid if pid_alive(pid) else None
    except Exception:
        return None


def cmd_link(a):
    cfg = load_config()
    peer = next((p for p in cfg["peers"] if p["host"] == a.host), {"host": a.host, "label": label_ok(a.host)})
    run_link(a.host, cfg["label"], peer["label"], {})


def daemon_main(peers, label):
    global LOG_TAG
    LOG_TAG = label
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    open(PIDFILE, "w").write(str(os.getpid()))
    links = {}
    started = int(time.time())
    store = ReliabilityStore()

    def keep(peer):
        backoff = 1
        while True:
            t0 = time.time()
            try:
                log(f"link {peer['host']}: connecting")
                run_link(peer["host"], label, peer["label"], links)
            except Exception as e:
                log(f"link {peer['host']}: {e}")
            if time.time() - t0 > 60:
                backoff = 1
            log(f"link {peer['host']}: down, retry in {backoff}s")
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)

    def on_term(*_):
        for n in list(links.values()):
            with n.mlock:
                for pid in list(n.mirrors):
                    n.kill_mirror(pid)
        COUNTERS.flush()
        audit("daemon_down")
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        os._exit(0)

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    audit("daemon_up", version=VERSION, peers=[p["host"] for p in peers])
    for p in peers:
        threading.Thread(target=keep, args=(p,), daemon=True).start()
    while True:
        try:
            local_recovery(store)
        except (ReliabilityError,sqlite3.Error,OSError):
            log("local queue recovery paused")
        COUNTERS.flush()
        snap = {"pid": os.getpid(), "version": VERSION, "label": label, "started": started,
                "updated": int(time.time()), "links": {
                    h: {"peer": n.peer_label, "session": n.session, "total": COUNTERS.data.get(n.peer_label, {}),
                        "mirrors": [{"name": m["name"], "remote": m["rec"].get("name"), "status": m["rec"].get("status"),
                                     "task": m["rec"].get("task"), "local_pid": m["pid"]} for m in list(n.mirrors.values())]}
                    for h, n in list(links.items())}}
        write_json_private(STATUSFILE, snap)
        time.sleep(2)


def cmd_up(a):
    cfg = load_config()
    hosts = a.hosts or [p["host"] for p in cfg["peers"]]
    peers = [next((p for p in cfg["peers"] if p["host"] == h), {"host": h, "label": label_ok(h)}) for h in hosts]
    if daemon_pid():
        print(f"already running (pid {daemon_pid()})")
        return
    if a.foreground:
        daemon_main(peers, cfg["label"])
        return
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    logf = open(LOGFILE, "a")
    p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "up", "--foreground", *hosts],
                         stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True)
    for _ in range(50):
        if daemon_pid():
            break
        time.sleep(0.1)
    print(f"claude-code-message up (pid {p.pid}), log: {LOGFILE}")


def cmd_down(a):
    pid = daemon_pid()
    if not pid:
        print("not running")
    else:
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if not pid_alive(pid):
                break
            time.sleep(0.1)
        print("stopped")
    for r in read_sessions(include_mirrors=True):  # mirrors left by a crashed daemon
        if is_mirror(r):
            try:
                os.kill(r["pid"], signal.SIGTERM)
            except OSError:
                pass


def cmd_restart(a):
    cmd_down(a)
    a.hosts, a.foreground = [], False
    cmd_up(a)


def ensure_daemon():
    if not daemon_pid():
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "up"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_ensure(a):
    ensure_daemon()


def cmd_status(a):
    pid = daemon_pid()
    st = read_json(STATUSFILE, {}) or {}
    if a.json:
        print(json.dumps({"running": bool(pid), **st}, indent=2, ensure_ascii=False))
        return
    cfg = load_config()
    print(f"claude-code-message {VERSION}  node: {cfg['label']}  daemon: "
          f"{'running pid %d (v%s)' % (pid, st.get('version', '?')) if pid else 'stopped'}")
    if not pid:
        return
    for host, l in (st.get("links") or {}).items():
        t, s = l.get("total", {}), l.get("session", {})
        print(f"  link {host} ({l['peer']})  up this session: out={s.get('relay_out', 0)} in={s.get('relay_in', 0)}"
              f"  |  all time: out={t.get('relay_out', 0)} in={t.get('relay_in', 0)} errors={t.get('errors', 0)}")
        print(f"    {len(l['mirrors'])} remote members mirrored — `ccm roster` for details")
    missing = [p["host"] for p in cfg["peers"] if p["host"] not in (st.get("links") or {})]
    for h in missing:
        print(f"  link {h}: DOWN (reconnecting; see {LOGFILE})")


# ------------------------------------------------------------ chat commands
def whoami():
    """Recover from missing/stale environment hints without trusting them as identity."""
    sessions = {r["pid"]: r for r in read_sessions()}
    return next((sessions[pid] for pid in ancestor_pids() if pid in sessions), None)


def whoami_agent(as_name=None):
    """Find an active agent bridge session matching as_name or single active local bridge."""
    local_agents = [r for r in read_sessions() if (r.get("sessionId") or "").startswith("agent-")]
    if as_name:
        t = as_name.lower()
        matched = [r for r in local_agents if (r.get("name") or "").lower() == t or r.get("sessionId") == f"agent-{as_name}-{r.get('pid')}"]
        if matched:
            return matched[0]
        return None
    if len(local_agents) == 1:
        return local_agents[0]
    return None


def permission_mode(rec):
    """Use the last hook's current mode, never launch flags or a guessed bypass."""
    saved = (roster_get(rec.get("sessionId")) or {}).get("permission") or {}
    if any(not rec.get(k) or saved.get(k) != rec[k] for k in ("sessionId", "pid", "procStart", "pidDomain")):
        return None
    mode = saved.get("mode")
    if mode == "bypassPermissions":
        return "bypass"
    if mode in ("default", "acceptEdits", "auto", "dontAsk"):
        return "prompting"
    # Hook input does not attest interactive plan's bypass-availability flag.
    return None


def peer_name(name):
    name = "".join(c for c in name if c not in '\"<>' and
                   unicodedata.category(c) not in ("Cc", "Cf", "Cs", "Zl", "Zp")).strip()
    return name[:64] + "…" if len(name) > 64 else name


def peer_address(sock):
    return "uds:" + quote(sock, safe=":/_-.\\").replace("~", "%7E")


def build_frame(me, text, custom_sender=None):
    label = load_config()["label"]
    default_name = custom_sender or f"{label}-cli"
    name = peer_name(display_name(me) if me else default_name)
    attrs = []
    if me:
        attrs.append(f'from="{peer_address(me["messagingSocketPath"])}"')
        if re.fullmatch(r"[A-Za-z0-9_-]{1,80}", me.get("sessionId") or ""):
            attrs.append(f'from-session="{me["sessionId"]}"')
    if name:
        attrs.append(f'from-name="{name}"')
    mode = permission_mode(me) if me else None
    if mode:
        attrs.append(f'from-mode="{mode}"')
    header = " " + " ".join(attrs) if attrs else ""
    frame = {"msgV": 1, "msg_id": str(uuid.uuid4()), "type": "user", "priority": "next",
             "message": {"role": "user", "content": f"<cross-session-message{header}>\n{text}\n</cross-session-message>"}}
    if me:
        frame["from"] = peer_address(me["messagingSocketPath"])
    return frame, name


def resolve(target, members):
    t = target.lower()
    exact = [m for m in members if (m.get("name") or "").lower() == t]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        sys.exit(f"ambiguous exact member '{target}'; select a unique SID")
    pref = [m for m in members if (m.get("name") or "").lower().startswith(t)]
    if len(pref) == 1:
        return pref[0]
    if t.endswith("-cli"):
        node = t[:-4]
        label = (load_config().get("label") or "").lower()
        if node == label:
            local_agents = [m for m in members if not is_mirror(m) and (m.get("sessionId") or "").startswith("agent-")]
            if len(local_agents) == 1:
                return local_agents[0]
        else:
            remote_agents = [m for m in members if is_mirror(m) and (m.get("ccmHost") or "").lower() == node and (m.get("sessionId") or "").startswith("agent-")]
            if len(remote_agents) == 1:
                return remote_agents[0]
        names = ", ".join(sorted(m.get("name") or "?" for m in (pref or members)))
        sys.exit(f"unknown member '{target}': '{target}' is an ephemeral CLI sender label, not an active receiver session. Run 'ccm agent serve {target}' or send to an active member. Candidates: {names}")
    names = ", ".join(sorted(m.get("name") or "?" for m in (pref or members)))
    sys.exit(f"{'ambiguous' if pref else 'unknown'} member '{target}'. Candidates: {names}")


def read_text(a):
    text = " ".join(a.text) if a.text else sys.stdin.read()
    text = text.strip()
    if not text:
        sys.exit("empty message")
    return text


def resolve_delivery(target, members, store):
    # Offline routing is permitted only for a previously observed, unique stable SID.
    if isinstance(target,str) and target.startswith("sid:"):
        sid=target[4:]
        live=[r for r in members if r.get("sessionId")==sid]
        cached=[r for r in store.cached_routes() if r["sid"]==sid]
        peers={r.get("ccmHost") if is_mirror(r) else "@local" for r in live} | {r["peer"] for r in cached}
        if len(peers)!=1 or len(live)>1:
            sys.exit("SID is unknown or ambiguous")
        return live[0] if live else {"sessionId":sid,"name":cached[0]["name"],"agent":MIRROR_TAG,"ccmHost":cached[0]["peer"]}
    if any((r.get("name") or "").lower()==target.lower() for r in members):
        return resolve(target,members)
    cached=[r for r in store.cached_routes() if r["name"].lower()==target.lower() or (r["peer"]+"-"+r["name"]).lower()==target.lower()]
    if len(cached)==1:
        r=cached[0]
        return {"sessionId":r["sid"],"name":target,"agent":MIRROR_TAG,"ccmHost":r["peer"]}
    return resolve(target,members)


def attempt_delivery(store,row,target,explicit=True):
    if row["target_peer"]=="@local":
        local_recovery(store,row["id"],explicit=explicit)
        return
    if not target.get("messagingSocketPath"):
        return
    # Wake an existing mirror; the durable queue, not this wakeup, owns the frame.
    deliver_local(target["messagingSocketPath"],target["pid"],json.loads(row["frame"]))


def cmd_send(a):
    me = whoami()
    as_name = getattr(a, "as_agent", None) or os.environ.get("CCM_AS") or os.environ.get("CCM_AGENT_NAME")
    if not me:
        me = whoami_agent(as_name)
    elif as_name:
        agent_me = whoami_agent(as_name)
        if agent_me:
            me = agent_me
    members = [r for r in read_sessions(include_mirrors=True) if not me or r["pid"] != me["pid"]]
    store=ReliabilityStore()
    target = resolve_delivery(a.to,members,store)
    frame,sender=build_frame(me,read_text(a),custom_sender=as_name)
    row=store.enqueue([{"peer":target.get("ccmHost") if is_mirror(target) else "@local","sid":target["sessionId"]}],frame,me)[0]
    try:
        if row["target_peer"]=="@local":
            store.claim_explicit_notice("outbox",row["id"])
        attempt_delivery(store,row,target)
    except (ReliabilityError,sqlite3.Error,OSError):
        pass
    audit("send",msg_id=frame["msg_id"],delivery_id=row["id"],sender=sender,to=display_name(target),via="ccm",ok=True,
          state="durable_queued",preview=preview(frame_text(frame)))
    print(f"→ {display_name(target)}: queued id={row['id']} (not proof of reading)")
    sys.exit(0)


def cmd_broadcast(a):
    me = whoami()
    as_name = getattr(a, "as_agent", None) or os.environ.get("CCM_AS") or os.environ.get("CCM_AGENT_NAME")
    if not me:
        me = whoami_agent(as_name)
    elif as_name:
        agent_me = whoami_agent(as_name)
        if agent_me:
            me = agent_me
    label = load_config()["label"]
    members = [r for r in read_sessions(include_mirrors=True) if not me or r["pid"] != me["pid"]]
    if a.local:
        members = [r for r in members if not is_mirror(r)]
    if a.node:
        members = [r for r in members if (r.get("ccmHost") if is_mirror(r) else label) == a.node]
    if a.match:
        members = [r for r in members if re.search(a.match, display_name(r))]
    if not members:
        sys.exit("nobody to broadcast to")
    text = read_text(a)
    frame,sender=build_frame(me,f"[broadcast to {len(members)} members] {text}",custom_sender=as_name)
    if len({(r.get("ccmHost") if is_mirror(r) else "@local",r.get("sessionId")) for r in members})!=len(members):
        sys.exit("broadcast target identities are ambiguous")
    store=ReliabilityStore();group=str(uuid.uuid4())
    batch=[({"peer":r.get("ccmHost") if is_mirror(r) else "@local","sid":r["sessionId"]},dict(frame,msg_id=str(uuid.uuid4()))) for r in members]
    rows=store.enqueue_batch(batch,me,group_id=group)
    results={}
    for target,row in zip(members,rows):
        try:
            if row["target_peer"]=="@local":
                store.claim_explicit_notice("outbox",row["id"])
            attempt_delivery(store,row,target)
        except (ReliabilityError,sqlite3.Error,OSError):
            pass
        results[display_name(target)]={"state":"queued","delivery_id":row["id"],"native_msg_id":row["native_id"]}
    audit("broadcast",msg_id=frame["msg_id"],group_id=group,sender=sender,to=sorted(results),results=results,preview=preview(frame_text(frame)))
    for name,result in sorted(results.items()):
        print(f"→ {name}: queued id={result['delivery_id']}")
    sys.exit(0)


def wake_receipt_or_inbox(store, item, action, item_id, me):
    if item["peer"]=="@local":
        if action=="receipt":
            store.apply_local_receipts(explicit=True)
        else:
            node=Node(None,None,load_config()["label"],"@local",trusted_link="local");node._store=store
            node.dispatch_inbox(item,explicit=True,local=True);store.apply_local_receipts(explicit=True)
        return
    candidates=[r for r in read_sessions(include_mirrors=True) if is_mirror(r) and r.get("ccmHost")==item["peer"]]
    if not candidates:
        return
    frame={"type":"ccm_local","action":action,"id":item_id,"from":peer_address(me["messagingSocketPath"])}
    deliver_local(candidates[0]["messagingSocketPath"],candidates[0]["pid"],frame)


def cmd_receipts(a):
    store=ReliabilityStore()
    me=whoami() if a.inbox else None
    if a.inbox and not me:
        sys.exit("inbox receipts require the owning Claude session")
    rows=store.status(me["sessionId"] if me else None)
    for row in rows:
        row["receiver_acknowledged"]=bool(row.pop("acknowledged"))
        row["human_read"]="unknown";row["human_approval"]="unknown"
    if a.json:
        print(json.dumps(rows,ensure_ascii=False,indent=2))
    else:
        for row in rows:
            print(row["id"],row.get("target_peer") or "inbox",row["target_sid"],row.get("transport") or row.get("native_state"),
                  "receiver_acknowledged="+str(row["receiver_acknowledged"]).lower(),row["disposition"])


def cmd_read_ack(a):
    me=whoami()
    if not me:
        sys.exit("read-ack requires the actual owning Claude ancestor")
    store=ReliabilityStore();changed=store.acknowledge(a.id,me)
    if changed:
        item=next(r for r in store.inbox_rows() if r["id"]==a.id and r["target_sid"]==me["sessionId"])
        receipt=next((r for r in store.receipt_rows(item["peer"]) if r["delivery_id"]==a.id and r["kind"]=="receiver_acknowledged"),None)
        if receipt:
            wake_receipt_or_inbox(store,item,"receipt",receipt["id"],me)
    print(json.dumps({"delivery_id":a.id,"receiver_acknowledged":True,"human_read":"unknown","human_approval":"unknown"}))


def cmd_retry(a):
    me=whoami();store=ReliabilityStore()
    if a.inbox:
        if not me:
            sys.exit("inbox retry requires the owning Claude ancestor")
        items=[r for r in store.inbox_rows() if r["id"]==a.id and r["target_sid"]==me["sessionId"]]
        if len(items)!=1 or items[0]["native_state"] not in ("waiting_target","waiting_source_route","prewrite_failed") or items[0]["admission"] in ("held","denied","refused","expired","dropped"):
            sys.exit("native handoff is not safely retryable")
        wake_receipt_or_inbox(store,items[0],"inbox",a.id,me)
    else:
        row=store.explicit_retry(a.id,me)
        members=read_sessions(include_mirrors=True)
        targets=[r for r in members if r.get("sessionId")==row["target_sid"] and (r.get("ccmHost") if is_mirror(r) else "@local")==row["target_peer"]]
        if len(targets)==1:
            if row["target_peer"]=="@local":
                if store.consume_explicit_grant(row["explicit_grant"],row["id"],"@local",me or {}):
                    attempt_delivery(store,row,targets[0])
            else:
                wake={"type":"ccm_local","action":"outgoing_retry","id":row["id"],"grant":row["explicit_grant"]}
                if me:
                    wake["from"]=peer_address(me["messagingSocketPath"])
                deliver_local(targets[0]["messagingSocketPath"],targets[0]["pid"],wake)
    print(json.dumps({"delivery_id":a.id,"state":"explicit_safe_retry_requested","reading":"unconfirmed"}))


def cmd_task(a):
    me = whoami()
    if not me:
        sys.exit("run this from inside a Claude Code session")
    if not a.text:
        print((roster_get(me["sessionId"]) or {}).get("task") or infer_task(me) or "(no task registered)")
        return
    task = redact(" ".join(a.text).strip()[:200])
    roster_put(me["sessionId"], pid=me["pid"], name=display_name(me), cwd=me.get("cwd"), task=task, taskSource="agent")
    audit("task", session=display_name(me), task=task, source="agent")
    print(f"task registered for {display_name(me)}: {task}")


def cmd_roster(a):
    rows = roster_rows()
    me = whoami()
    if a.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    for r in rows:
        you = "  ← you" if me and r["sessionId"] == me.get("sessionId") and not r["remote"] else ""
        cwd = re.sub(r"^(/home|/Users)/[^/]+", "~", r["cwd"] or "")
        print(f"{r['name']:<34} {r['node'] or '?':<10} {r['status'] or '':<5} {cwd:<28} {r['task'] or '-'}{you}")


def cmd_log(a):
    def show(line):
        try:
            r = json.loads(line)
        except ValueError:
            return
        if a.ev and r.get("ev") not in a.ev.split(","):
            return
        if a.json:
            print(line.rstrip())
            return
        to = r.get("to")
        to = ",".join(to) if isinstance(to, list) else to
        bits = [r.get("ts", "")[:19], f"{r.get('node')}", f"{r.get('ev'):<11}"]
        if r.get("sender") or to:
            bits.append(f"{r.get('sender') or '?'} → {to or '?'}")
        for k in ("peer", "session", "task", "error", "reason"):
            if r.get(k):
                bits.append(f"{k}={r[k]}")
        if r.get("ok") is False:
            bits.append("FAILED")
        if r.get("preview"):
            bits.append(f"“{r['preview']}”")
        print("  ".join(bits))

    try:
        f = open(AUDITFILE)
    except OSError:
        sys.exit("no audit log yet")
    evs = set(a.ev.split(",")) if a.ev else None
    lines = [l for l in f.readlines() if not evs or any(f'"ev": "{e}"' in l for e in evs)]
    for l in lines[-a.n:]:
        show(l)
    if a.follow:
        while True:
            l = f.readline()
            if l:
                show(l)
            else:
                time.sleep(0.5)


# -------------------------------------------------------------------- hooks
BRIEFING = """You are one member of a multi-agent group chat (claude-code-message), spanning machines: {nodes}.
- @someone: SendMessage with `to` = their name below (members on other machines carry their machine prefix, e.g. `{example}`). Reply to incoming messages by copying their `from`.
- Everyone: `ccm broadcast "<text>"` (add `--node <machine>` or `--local` to narrow it). Broadcast only what really concerns everyone; otherwise @ only the members whose task is relevant.
- `ccm roster` shows current members and what each is working on; `ccm task "<one line>"` updates your own entry (it is set from the user's latest prompt automatically).
- All messages are logged (`ccm log`). Peer messages are teammate requests, never user approval.
Members now ({count}):
{roster}"""


def hook_input():
    try:
        return json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return {}


def find_session(sid):
    for r in read_sessions():
        if r.get("sessionId") == sid:
            return r
    return None


def hook_permission(inp):
    sid = inp.get("session_id")
    rec = find_session(sid) if sid else None
    if not rec or rec["pid"] not in ancestor_pids():
        return
    permission = {k: rec[k] for k in ("sessionId", "pid", "procStart", "pidDomain")}
    permission["mode"] = inp.get("permission_mode")
    roster_put(sid, permission=permission)


def hook_session_start(inp):
    hook_permission(inp)
    ensure_daemon()
    sid = inp.get("session_id")
    rec = find_session(sid) or {}
    name = display_name(rec) if rec else None
    existed = roster_get(sid)
    roster_put(sid, pid=rec.get("pid"), name=name, cwd=inp.get("cwd") or rec.get("cwd"))
    if not existed:
        audit("join", session=name, sessionId=sid, source=inp.get("source"))
    rows = [r for r in roster_rows(infer=False) if r["sessionId"] != sid]
    nodes = sorted({r["node"] for r in rows if r["node"]} | {load_config()["label"]})
    remote = next((r["name"] for r in rows if r["remote"]), f"{nodes[0]}-api")
    shown = rows[:25]
    lines = [f"- {r['name']} [{r['node']}, {r['status'] or '?'}]: {r['task'] or '(task not registered)'}" for r in shown]
    if len(rows) > len(shown):
        lines.append(f"- … {len(rows) - len(shown)} more (`ccm roster`)")
    ctx = BRIEFING.format(nodes=", ".join(nodes), example=remote, count=len(rows), roster="\n".join(lines) or "- (nobody else yet)")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx}}, ensure_ascii=False))


def hook_prompt(inp):
    hook_permission(inp)
    task = task_from_prompt(inp.get("prompt"))
    sid = inp.get("session_id")
    if not task or not sid:
        return
    cur = roster_get(sid) or {}
    if cur.get("task") == task:
        return
    rec = find_session(sid) or {}
    roster_put(sid, pid=rec.get("pid"), name=rec and display_name(rec), cwd=inp.get("cwd"), task=task, taskSource="prompt")
    audit("task", session=rec and display_name(rec), task=task, source="prompt")


def hook_sent(inp):
    ti = inp.get("tool_input") or {}
    resp = inp.get("tool_response")
    resp_s = resp if isinstance(resp, str) else json.dumps(resp, ensure_ascii=False)
    rec = find_session(inp.get("session_id")) or {}
    ok = '"success":false' not in (resp_s or "").replace(" ", "")
    to = ti.get("to")
    if isinstance(to, str) and to.startswith("uds:"):  # replies address a socket; log the member name
        path = os.path.abspath(unquote(to[4:]))
        to = next((display_name(r) for r in read_sessions(include_mirrors=True)
                   if os.path.abspath(r["messagingSocketPath"]) == path), to)
    audit("native_send", sender=rec and display_name(rec), to=to, via="SendMessage",
          summary=redact(ti.get("summary")), ok=ok, idle_sub=ti.get("notify_when_idle"),
          preview=preview(ti.get("message")) if ti.get("message") else None)


def hook_session_end(inp):
    sid = inp.get("session_id")
    cur = roster_get(sid) or {}
    if roster_drop(sid):
        audit("leave", session=cur.get("name"), sessionId=sid, reason=inp.get("reason"))


def cmd_hook(a):
    try:
        inp = hook_input()
        {"session-start": hook_session_start, "prompt": hook_prompt, "sent": hook_sent,
         "permission": hook_permission, "session-end": hook_session_end}[a.event](inp)
    except Exception as e:  # a hook must never break the session
        log(f"hook {a.event} failed: {e}")


# ---------------------------------------------------------- setup commands
SHIM = """#!/usr/bin/env python3
# claude-code-message shim: always runs the installed plugin's ccm (falls back to {fallback})
import json, os, sys
target = {fallback!r}
try:
    p = os.path.expanduser("~/.claude/plugins/installed_plugins.json")
    inst = json.load(open(p))["plugins"]["{plugin}"][0]["installPath"]
    if os.path.exists(os.path.join(inst, "bin", "ccm")):
        target = os.path.join(inst, "bin", "ccm")
except Exception:
    pass
os.execv(sys.executable, [sys.executable, target] + sys.argv[1:])
"""


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def claude_bin():
    for d in os.environ.get("PATH", "").split(os.pathsep) + ["/opt/homebrew/bin", "/usr/local/bin", os.path.join(HOME, ".local/bin")]:
        p = os.path.join(d, "claude")
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def installed_plugin():
    ip = read_json(os.path.join(CLAUDE_DIR, "plugins", "installed_plugins.json"), {}) or {}
    lst = (ip.get("plugins") or {}).get(PLUGIN_ID) or []
    return lst[0] if lst else None


def cmd_init(a):
    cfg = load_config()
    if a.label:
        cfg["label"] = label_ok(a.label)
    save_config(cfg)
    print(f"✓ node label: {cfg['label']}")
    claude = claude_bin()
    if not a.no_plugin and claude:
        sh([claude, "plugin", "marketplace", "add", PLUGIN_ROOT])
        sh([claude, "plugin", "marketplace", "update", "claude-code-message"])
        inst = installed_plugin()
        if inst:
            r = sh([claude, "plugin", "update", PLUGIN_ID])
            if (installed_plugin() or {}).get("version") != VERSION:
                sh([claude, "plugin", "uninstall", PLUGIN_ID])
                r = sh([claude, "plugin", "install", PLUGIN_ID])
        else:
            r = sh([claude, "plugin", "install", PLUGIN_ID])
        v = (installed_plugin() or {}).get("version")
        print(f"{'✓' if v == VERSION else '✗'} Claude plugin {PLUGIN_ID}: {v or 'not installed'} {'' if v == VERSION else r.stderr.strip()[-300:]}")
    elif not claude:
        print("! claude CLI not found; skipped plugin install (hooks and skill need it)")
    bindir = os.path.join(HOME, ".local", "bin")
    os.makedirs(bindir, exist_ok=True)
    shim = os.path.join(bindir, "ccm")
    if os.path.islink(shim):
        os.unlink(shim)
    with open(shim, "w") as f:
        f.write(SHIM.format(fallback=os.path.join(PLUGIN_ROOT, "bin", "ccm"), plugin=PLUGIN_ID))
    os.chmod(shim, 0o755)
    print(f"✓ shim: {shim}{'' if bindir in os.environ.get('PATH', '') else '  (add ~/.local/bin to PATH)'}")
    print("Next: `ccm pair <ssh-host>` on ONE machine, then `ccm doctor`. New sessions join the group chat automatically.")


def cmd_pair(a):
    cfg = load_config()
    host = a.host
    rlabel = label_ok(a.remote_label or host)
    step = lambda ok, msg: print(f"{'✓' if ok else '✗'} {msg}") or ok
    if not step(sh(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, "true"]).returncode == 0,
                f"ssh {host} works without prompts"):
        sys.exit("fix: set up key-based ssh (ssh-copy-id) and a Host entry in ~/.ssh/config")
    r = sh(["ssh", "-o", "BatchMode=yes", host, "python3 -c 'import sys;print(sys.version_info[:2]>=(3,8))'"])
    if not step(r.stdout.strip() == "True", f"python3 >= 3.8 on {host}"):
        sys.exit(1)
    rc = sh(["ssh", "-o", "BatchMode=yes", host, f"cat ~/.config/claude-code-message/config.json 2>/dev/null || echo {{}}"])
    rcfg = json.loads(rc.stdout or "{}") if rc.returncode == 0 else {}
    if any(p.get("label") == cfg["label"] for p in rcfg.get("peers", [])):
        sys.exit(f"✗ {host} already dials this machine ({cfg['label']}); a pair needs exactly one dialler. "
                 f"Run `ccm unpair <this-host>` there, or keep that direction.")
    tar = subprocess.Popen(["tar", "czf", "-", "--exclude", ".git", "--exclude", "__pycache__",
                            "--exclude", "reliability.sqlite3*", "--exclude", "reliability-identity.json",
                            "--exclude", "reliability.lock", "--exclude", ".ccm-state", "--exclude", ".test-tmp",
                            "-C", PLUGIN_ROOT, "."],
                           stdout=subprocess.PIPE)
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", host,
                        f"rm -rf {REMOTE_HOME}.new && mkdir -p {REMOTE_HOME}.new && tar xzf - -C {REMOTE_HOME}.new && "
                        f"rm -rf {REMOTE_HOME} && mv {REMOTE_HOME}.new {REMOTE_HOME}"],
                       stdin=tar.stdout, capture_output=True, text=True)
    tar.wait()
    if not step(r.returncode == 0, f"copied claude-code-message {VERSION} to {host}:{REMOTE_HOME}"):
        sys.exit(r.stderr)
    r = sh(["ssh", "-o", "BatchMode=yes", host,
            f"PATH=$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH python3 {REMOTE_HOME}/bin/ccm init --label {rlabel}"])
    for line in r.stdout.strip().splitlines():
        print(f"    [{host}] {line}")
    if not step(r.returncode == 0, f"initialised {host} as node '{rlabel}'"):
        sys.exit(r.stderr)
    cfg["peers"] = [p for p in cfg["peers"] if p["host"] != host] + [{"host": host, "label": rlabel}]
    save_config(cfg)
    step(True, f"peer saved: {host} as '{rlabel}' ({CONFIG_PATH})")
    audit("pair", peer=rlabel, host=host)
    a.hosts, a.foreground = [], False
    cmd_restart(a)
    for _ in range(40):
        st = read_json(STATUSFILE, {}) or {}
        l = (st.get("links") or {}).get(host)
        if l and l.get("mirrors"):
            step(True, f"link up: {len(l['mirrors'])} member(s) on {rlabel} visible here")
            break
        time.sleep(0.5)
    else:
        step(False, f"link not up yet; check `ccm doctor` and {LOGFILE}")


def cmd_unpair(a):
    cfg = load_config()
    cfg["peers"] = [p for p in cfg["peers"] if p["host"] != a.host and p["label"] != a.host]
    save_config(cfg)
    audit("unpair", host=a.host)
    a.hosts, a.foreground = [], False
    cmd_down(a)
    if cfg["peers"]:
        cmd_up(a)
    print(f"unpaired {a.host}")


def cmd_doctor(a):
    fails = 0

    def check(ok, msg, fix=None, warn=False):
        nonlocal fails
        print(f"{'✓' if ok else ('!' if warn else '✗')} {msg}" + ("" if ok or not fix else f"\n    fix: {fix}"))
        if not ok and not warn:
            fails += 1

    cfg = load_config()
    check(sys.version_info >= (3, 8), f"python {sys.version.split()[0]}")
    check(os.path.isdir(SESSIONS_DIR), f"Claude sessions dir {SESSIONS_DIR}", "start Claude Code once")
    sd = socket_dir()
    try:
        mode = oct(os.stat(sd).st_mode & 0o777)
        check(mode == "0o700", f"socket dir {sd} ({mode})", f"chmod 700 {sd}")
    except OSError:
        check(True, f"socket dir {sd} (created on first session)")
    claude = claude_bin()
    lv = sh([claude, "--version"]).stdout.split()[0] if claude else None
    check(bool(claude), f"claude CLI {lv or 'not found'}")
    inst = installed_plugin()
    check(bool(inst), f"plugin {PLUGIN_ID} {inst and inst.get('version')}", "ccm init")
    if inst and inst.get("version") != VERSION:
        check(False, f"this ccm is {VERSION} but the installed plugin is {inst.get('version')}", "ccm init", warn=True)
    check(os.path.exists(os.path.join(HOME, ".local", "bin", "ccm")), "shim ~/.local/bin/ccm", "ccm init")
    check(True, f"node label '{cfg['label']}'")
    pid = daemon_pid()
    st = read_json(STATUSFILE, {}) or {}
    if cfg["peers"]:
        check(bool(pid), f"daemon {'running pid %s v%s' % (pid, st.get('version')) if pid else 'stopped'}", "ccm up")
        if pid and st.get("version") != VERSION:
            check(False, f"daemon runs {st.get('version')}, installed {VERSION}", "ccm restart", warn=True)
    else:
        check(True, "no peers dialled from here (fine if the other machine dials this one)")
    for p in cfg["peers"]:
        h = p["host"]
        ok = sh(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", h, "true"]).returncode == 0
        check(ok, f"ssh {h}", "key-based ssh without prompts")
        if ok:
            rv = sh(["ssh", "-o", "BatchMode=yes", h, "PATH=$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH; claude --version 2>/dev/null | cut -d' ' -f1"]).stdout.strip()
            check(not lv or rv == lv, f"{h} Claude Code {rv or '?'} (local {lv})",
                  "keep both machines on the same Claude Code version: the peer protocol is internal", warn=True)
        l = (st.get("links") or {}).get(h)
        check(bool(l), f"link {h} ({p['label']}): {'%d members mirrored' % len(l['mirrors']) if l else 'down'}",
              f"see {LOGFILE}")
    me = whoami()
    if me:
        r = roster_get(me.get("sessionId"))
        check(bool(r), f"this session registered as {display_name(me)}: {(r or {}).get('task') or infer_task(me) or '-'}",
              "the SessionStart hook registers new sessions; older sessions show an inferred task", warn=True)
    print("all good" if not fails else f"{fails} problem(s)")
    sys.exit(1 if fails else 0)


def cmd_config(a):
    cfg = load_config()
    if a.action == "set-label":
        cfg["label"] = label_ok(a.value)
    elif a.action == "set-preview":
        cfg["audit_preview_chars"] = int(a.value)
    elif a.action in ("set-read-receipts","set-retry"):
        value=json.loads(a.value)
        if type(value) is not bool:
            raise ReliabilityError("use the JSON boolean true or false")
        cfg["read_receipts" if a.action=="set-read-receipts" else "retry_enabled"]=value
    elif a.action == "set-reliability":
        values=json.loads(a.value)
        if not isinstance(values,dict) or any(k not in RELIABILITY_DEFAULTS for k in values):
            raise ReliabilityError("set-reliability accepts only known reliability settings")
        cfg.update(values)
    if a.action != "show":
        cfg=save_config(cfg)
    print(json.dumps(cfg, indent=2, ensure_ascii=False))


# --------------------------------------------------------------------- agent bridge
AGENTS_DIR = os.path.join(STATE_DIR, "agents")


def cmd_agent(a):
    if a.action == "serve":
        cmd_agent_serve(a)
    elif a.action == "wait":
        cmd_agent_wait(a)
    elif a.action == "status":
        cmd_agent_status(a)
    elif a.action == "stop":
        cmd_agent_stop(a)


def cmd_agent_serve(a):
    name = label_ok(a.name)
    os.makedirs(AGENTS_DIR, mode=0o700, exist_ok=True)
    pid_file = os.path.join(AGENTS_DIR, f"{name}.pid")
    if os.path.exists(pid_file):
        old_pid = read_json(pid_file, {}).get("pid")
        if old_pid and pid_alive(old_pid):
            sys.exit(f"agent bridge '{name}' is already running (PID {old_pid})")
        else:
            try:
                os.unlink(pid_file)
            except OSError:
                pass

    if getattr(a, "daemon", False):
        child = os.fork()
        if child > 0:
            print(json.dumps({"daemon": True, "agent": name, "pid": child}))
            sys.exit(0)
        os.setsid()
        devnull = open(os.devnull, "r+")
        os.dup2(devnull.fileno(), 0)
        log_path = os.path.join(AGENTS_DIR, f"{name}.log")
        log_fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        os.dup2(log_fd, 1)
        os.dup2(log_fd, 2)

    pid = os.getpid()
    write_json_private(pid_file, {"name": name, "pid": pid, "startedAt": now_ms()})

    sdir = socket_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    sock = os.path.join(sdir, f"{pid}.sock")
    token = secrets.token_hex(16)
    ps = proc_start(pid)
    dom = pid_domain()
    reg_path = os.path.join(SESSIONS_DIR, f"{pid}.json")
    kpath = key_path(pid, sock)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.unlink(sock)
    except OSError:
        pass
    srv.bind(sock)
    os.chmod(sock, 0o600)
    srv.listen(16)

    sid = f"agent-{name}-{pid}"
    kind = getattr(a, "kind", "generic") or "generic"
    task = getattr(a, "task", None) or f"Agent bridge for {kind}"

    def cleanup(*_):
        for p in (reg_path, kpath, sock, pid_file):
            try:
                os.unlink(p)
            except OSError:
                pass
        roster_drop(sid)
        audit("agent_offline", agent=name, kind=kind, pid=pid)
        os._exit(0)

    try:
        signal.signal(signal.SIGTERM, cleanup)
        signal.signal(signal.SIGINT, cleanup)
    except ValueError:
        pass

    write_json_private(kpath, {"peerToken": token, "procStart": ps, "pidDomain": dom})
    now = now_ms()
    reg = {
        "pid": pid, "sessionId": sid, "cwd": os.getcwd(),
        "startedAt": now, "procStart": ps, "version": f"ccm-agent-{VERSION}",
        "peerProtocol": 1, "peerFeatures": ["agent_bridge"],
        "kind": "interactive", "entrypoint": "cli", "pidDomain": dom,
        "messagingSocketPath": sock, "name": name, "nameSource": "user",
        "nameSince": now, "agent": f"ccm-agent-{kind}",
        "status": "idle", "updatedAt": now, "statusUpdatedAt": now,
        "ccmTask": task, "detail": f"[{kind}] {task}",
    }
    write_json_private(reg_path, reg)
    roster_put(sid, pid=pid, name=name, cwd=os.getcwd(), task=task)
    audit("agent_online", agent=name, kind=kind, pid=pid)

    ready_payload = {"ready": True, "agent": name, "pid": pid, "sock": sock}
    if not getattr(a, "daemon", False):
        print(json.dumps(ready_payload), flush=True)

    if getattr(a, "timeout", 0) and a.timeout > 0:
        def timeout_handler():
            time.sleep(a.timeout)
            cleanup()
        threading.Thread(target=timeout_handler, daemon=True).start()

    def handle(c):
        buf = b""
        c.settimeout(3)
        try:
            while len(buf) <= MAX_FRAME + 4096:
                d = c.recv(65536)
                if not d:
                    break
                buf += d
        except OSError:
            pass
        finally:
            c.close()

        lines = [l for l in buf.split(b"\n") if l.strip()]
        if not lines:
            return
        try:
            first = json.loads(lines[0])
        except ValueError:
            return
        if first.get("type") != "auth" or not secrets.compare_digest(str(first.get("token", "")), token):
            log(f"agent {name}: unauthenticated frame dropped")
            return

        for l in lines[1:]:
            try:
                frame = json.loads(l)
            except ValueError:
                continue

            text = frame_text(frame)
            from_addr = frame.get("from")
            from_name = header_attr(text, "from-name") or from_addr
            from_mode = header_attr(text, "from-mode") or "prompting"
            msg_id = frame.get("msg_id") or str(uuid.uuid4())

            event = {
                "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                "msg_id": msg_id,
                "agent": name,
                "from": from_addr,
                "from_name": from_name,
                "from_mode": from_mode,
                "text": text,
                "frame": frame,
            }
            audit("agent_recv", agent=name, from_name=from_name, preview=preview(text))

            if getattr(a, "fifo", None):
                try:
                    with open(a.fifo, "a") as ff:
                        ff.write(json.dumps(event, ensure_ascii=False) + "\n")
                except OSError as e:
                    log(f"agent {name}: fifo write failed: {e}")

            if getattr(a, "inbox", None):
                try:
                    os.makedirs(a.inbox, mode=0o700, exist_ok=True)
                    write_json_private(os.path.join(a.inbox, f"{msg_id}.json"), event)
                except OSError as e:
                    log(f"agent {name}: inbox write failed: {e}")

            if getattr(a, "exec", None):
                try:
                    p = subprocess.Popen(getattr(a, "exec"), shell=True, stdin=subprocess.PIPE)
                    p.communicate(input=(json.dumps(event, ensure_ascii=False) + "\n").encode())
                except OSError as e:
                    log(f"agent {name}: exec failed: {e}")

            if not getattr(a, "daemon", False) and not getattr(a, "fifo", None) and not getattr(a, "inbox", None) and not getattr(a, "exec", None):
                print(json.dumps(event, ensure_ascii=False), flush=True)

            if getattr(a, "once", False):
                cleanup()

    while True:
        try:
            c, _ = srv.accept()
            threading.Thread(target=handle, args=(c,), daemon=True).start()
        except OSError:
            break


def cmd_agent_wait(a):
    name = label_ok(a.name)
    a.kind = getattr(a, "kind", "generic") or "generic"
    a.task = getattr(a, "task", None) or f"Waiting for message ({a.kind})"
    a.fifo = None
    a.inbox = None
    a.exec = None
    a.daemon = False
    a.once = True
    timeout = getattr(a, "timeout", 60)

    pid = os.getpid()
    os.makedirs(AGENTS_DIR, mode=0o700, exist_ok=True)
    pid_file = os.path.join(AGENTS_DIR, f"{name}.pid")
    write_json_private(pid_file, {"name": name, "pid": pid, "startedAt": now_ms(), "wait": True})

    sdir = socket_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    sock = os.path.join(sdir, f"{pid}.sock")
    token = secrets.token_hex(16)
    ps = proc_start(pid)
    dom = pid_domain()
    reg_path = os.path.join(SESSIONS_DIR, f"{pid}.json")
    kpath = key_path(pid, sock)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.unlink(sock)
    except OSError:
        pass
    srv.bind(sock)
    os.chmod(sock, 0o600)
    srv.listen(16)
    if timeout > 0:
        srv.settimeout(timeout)

    sid = f"agent-{name}-{pid}"
    kind = a.kind
    task = a.task

    def cleanup(exit_code=0):
        for p in (reg_path, kpath, sock, pid_file):
            try:
                os.unlink(p)
            except OSError:
                pass
        roster_drop(sid)
        os._exit(exit_code)

    try:
        signal.signal(signal.SIGTERM, lambda *_: cleanup(1))
        signal.signal(signal.SIGINT, lambda *_: cleanup(130))
    except ValueError:
        pass

    write_json_private(kpath, {"peerToken": token, "procStart": ps, "pidDomain": dom})
    now = now_ms()
    reg = {
        "pid": pid, "sessionId": sid, "cwd": os.getcwd(),
        "startedAt": now, "procStart": ps, "version": f"ccm-agent-{VERSION}",
        "peerProtocol": 1, "peerFeatures": ["agent_bridge"],
        "kind": "interactive", "entrypoint": "cli", "pidDomain": dom,
        "messagingSocketPath": sock, "name": name, "nameSource": "user",
        "nameSince": now, "agent": f"ccm-agent-{kind}",
        "status": "idle", "updatedAt": now, "statusUpdatedAt": now,
        "ccmTask": task, "detail": f"[{kind}] {task}",
    }
    write_json_private(reg_path, reg)
    roster_put(sid, pid=pid, name=name, cwd=os.getcwd(), task=task)

    try:
        while True:
            c, _ = srv.accept()
            buf = b""
            c.settimeout(3)
            try:
                while len(buf) <= MAX_FRAME + 4096:
                    d = c.recv(65536)
                    if not d:
                        break
                    buf += d
            except OSError:
                pass
            finally:
                c.close()

            lines = [l for l in buf.split(b"\n") if l.strip()]
            if not lines:
                continue
            try:
                first = json.loads(lines[0])
            except ValueError:
                continue
            if first.get("type") != "auth" or not secrets.compare_digest(str(first.get("token", "")), token):
                continue

            for l in lines[1:]:
                try:
                    frame = json.loads(l)
                except ValueError:
                    continue
                text = frame_text(frame)
                from_addr = frame.get("from")
                from_name = header_attr(text, "from-name") or from_addr
                from_mode = header_attr(text, "from-mode") or "prompting"
                msg_id = frame.get("msg_id") or str(uuid.uuid4())
                event = {
                    "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                    "msg_id": msg_id,
                    "agent": name,
                    "from": from_addr,
                    "from_name": from_name,
                    "from_mode": from_mode,
                    "text": text,
                    "frame": frame,
                }
                audit("agent_recv", agent=name, from_name=from_name, preview=preview(text))
                print(json.dumps(event, ensure_ascii=False), flush=True)
                cleanup(0)
    except socket.timeout:
        sys.stderr.write(f"ccm agent wait: timeout after {timeout}s\n")
        cleanup(2)
    except OSError:
        cleanup(1)


def cmd_agent_status(a):
    os.makedirs(AGENTS_DIR, mode=0o700, exist_ok=True)
    res = []
    for f in os.listdir(AGENTS_DIR):
        if not f.endswith(".pid"):
            continue
        name = f[:-4]
        d = read_json(os.path.join(AGENTS_DIR, f), {})
        pid = d.get("pid")
        alive = bool(pid and pid_alive(pid))
        rec = next((r for r in read_sessions() if r.get("pid") == pid and r.get("name") == name), None)
        res.append({
            "name": name,
            "pid": pid,
            "alive": alive,
            "wait": d.get("wait", False),
            "startedAt": d.get("startedAt"),
            "task": (rec or {}).get("ccmTask"),
            "sock": (rec or {}).get("messagingSocketPath"),
        })
    if getattr(a, "json", False):
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        if not res:
            print("No active agent bridges.")
            return
        for r in res:
            st = "running" if r["alive"] else "stale"
            print(f"agent {r['name']}: {st} (pid {r['pid']}) — {r['task'] or '-'}")


def cmd_agent_stop(a):
    name = label_ok(a.name)
    pid_file = os.path.join(AGENTS_DIR, f"{name}.pid")
    d = read_json(pid_file, {})
    pid = d.get("pid")
    if not pid or not pid_alive(pid):
        try:
            os.unlink(pid_file)
        except OSError:
            pass
        print(f"agent bridge '{name}' not running.")
        return
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if not pid_alive(pid):
                break
            time.sleep(0.1)
        if pid_alive(pid):
            os.kill(pid, signal.SIGKILL)
        print(f"stopped agent bridge '{name}' (PID {pid}).")
    except OSError as e:
        sys.exit(f"failed to stop {name}: {e}")


def main():
    ap = argparse.ArgumentParser(prog="ccm", description="Group chat for Claude Code sessions across machines")
    ap.add_argument("--version", action="version", version=VERSION)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("init", help="set up this node (label, plugin, shim)"); p.add_argument("--label"); p.add_argument("--no-plugin", action="store_true"); p.set_defaults(fn=cmd_init)
    p = sp.add_parser("pair", help="pair with another machine over ssh"); p.add_argument("host"); p.add_argument("--remote-label"); p.set_defaults(fn=cmd_pair)
    p = sp.add_parser("unpair"); p.add_argument("host"); p.set_defaults(fn=cmd_unpair)
    sp.add_parser("doctor", help="check everything").set_defaults(fn=cmd_doctor)
    p = sp.add_parser("up"); p.add_argument("hosts", nargs="*"); p.add_argument("--foreground", action="store_true"); p.set_defaults(fn=cmd_up)
    sp.add_parser("down").set_defaults(fn=cmd_down)
    sp.add_parser("restart").set_defaults(fn=cmd_restart)
    sp.add_parser("ensure").set_defaults(fn=cmd_ensure)
    p = sp.add_parser("status"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_status)
    p = sp.add_parser("roster", aliases=["peers"], help="members and their tasks"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_roster)
    p = sp.add_parser("send", help="@ one member"); p.add_argument("to"); p.add_argument("text", nargs="*")
    p.add_argument("--as", dest="as_agent", help="send as a registered agent or custom sender name"); p.set_defaults(fn=cmd_send)
    p = sp.add_parser("broadcast", help="message everyone"); p.add_argument("text", nargs="*"); p.add_argument("--local", action="store_true")
    p.add_argument("--node"); p.add_argument("--match", help="regex on member names")
    p.add_argument("--as", dest="as_agent", help="send as a registered agent or custom sender name"); p.set_defaults(fn=cmd_broadcast)
    p = sp.add_parser("task", help="show/set this session's task"); p.add_argument("text", nargs="*"); p.set_defaults(fn=cmd_task)
    p = sp.add_parser("log", help="audit trail"); p.add_argument("-n", type=int, default=40); p.add_argument("-f", "--follow", action="store_true")
    p.add_argument("--ev"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_log)
    p = sp.add_parser("receipts", help="delivery facts; no message bodies"); p.add_argument("--inbox", action="store_true"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_receipts)
    p = sp.add_parser("read-ack", help="owned receiving session declares acknowledgement, not human approval"); p.add_argument("id"); p.set_defaults(fn=cmd_read_ack)
    p = sp.add_parser("retry", help="explicit retry of a safely pending message"); p.add_argument("id"); p.add_argument("--inbox", action="store_true"); p.set_defaults(fn=cmd_retry)
    p = sp.add_parser("config"); p.add_argument("action", choices=["show", "set-label", "set-preview", "set-read-receipts", "set-retry", "set-reliability"], nargs="?", default="show")
    p.add_argument("value", nargs="?"); p.set_defaults(fn=cmd_config)
    p = sp.add_parser("hook"); p.add_argument("event", choices=["session-start", "prompt", "permission", "sent", "session-end"]); p.set_defaults(fn=cmd_hook)
    p = sp.add_parser("link"); p.add_argument("host"); p.set_defaults(fn=cmd_link)
    p = sp.add_parser("serve"); p.add_argument("--label"); p.set_defaults(fn=cmd_serve)
    p = sp.add_parser("mirror"); p.add_argument("--name", required=True); p.add_argument("--peer", required=True)
    p.add_argument("--remote", required=True); p.set_defaults(fn=cmd_mirror)
    p = sp.add_parser("agent", help="bridge external agents (Antigravity, Codex, etc.)")
    asp = p.add_subparsers(dest="action", required=True)
    p_serve = asp.add_parser("serve", help="run agent bridge listener")
    p_serve.add_argument("name")
    p_serve.add_argument("--kind", default="generic", choices=["generic", "antigravity", "codex"])
    p_serve.add_argument("--task")
    p_serve.add_argument("--fifo")
    p_serve.add_argument("--inbox")
    p_serve.add_argument("--exec")
    p_serve.add_argument("--daemon", action="store_true")
    p_serve.add_argument("--once", action="store_true")
    p_serve.add_argument("--timeout", type=float, default=0)
    p_serve.set_defaults(fn=cmd_agent)
    p_wait = asp.add_parser("wait", help="wait for one incoming message and exit")
    p_wait.add_argument("name")
    p_wait.add_argument("--kind", default="generic")
    p_wait.add_argument("--task")
    p_wait.add_argument("--timeout", type=float, default=60)
    p_wait.set_defaults(fn=cmd_agent)
    p_status = asp.add_parser("status", help="list running agent bridges")
    p_status.add_argument("name", nargs="?")
    p_status.add_argument("--json", action="store_true")
    p_status.set_defaults(fn=cmd_agent)
    p_stop = asp.add_parser("stop", help="stop a running agent bridge")
    p_stop.add_argument("name")
    p_stop.set_defaults(fn=cmd_agent)
    a = ap.parse_args()
    try:
        a.fn(a)
    except (ReliabilityError, sqlite3.Error):
        sys.exit("reliability operation failed closed; state retained for reconciliation")


if __name__ == "__main__":
    main()
