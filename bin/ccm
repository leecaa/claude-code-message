#!/usr/bin/env python3
"""claude-code-message: a group chat for Claude Code sessions, across machines.

Sessions on linked machines show up as native SendMessage peers
(`<machine>-<session>`); every session registers what it is working on, so
agents can pick whom to @, or broadcast to everyone. Everything is audited.

Setup:     ccm init | ccm pair HOST | ccm doctor
Daemon:    ccm up | ccm down | ccm restart | ccm status
Chat:      ccm roster | ccm send NAME TEXT | ccm broadcast TEXT | ccm task TEXT
Audit:     ccm log [-f] [-n N] [--ev EV]
Internal:  ccm hook EVENT | ccm serve | ccm mirror | ccm link HOST
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import secrets
import signal
import socket
import subprocess
import sys
import threading
import time
import uuid

VERSION = "0.2.8"
PROTO = 1
MIRROR_TAG = "claude-code-message"
MAX_FRAME = 1_048_576
SCAN_INTERVAL = 2.0
ROSTER_GRACE = 120  # seconds a roster entry may exist before its session registers
AUDIT_MAX = 20 * 1024 * 1024
HOME = os.path.expanduser("~")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude"))
SESSIONS_DIR = os.path.join(CLAUDE_DIR, "sessions")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")), "claude-code-message")
CONFIG_PATH = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "claude-code-message", "config.json")
ROSTER_DIR = os.path.join(STATE_DIR, "roster")
PIDFILE = os.path.join(STATE_DIR, "daemon.pid")
LOGFILE = os.path.join(STATE_DIR, "daemon.log")
STATUSFILE = os.path.join(STATE_DIR, "status.json")
AUDITFILE = os.path.join(STATE_DIR, "audit.jsonl")
COUNTERSFILE = os.path.join(STATE_DIR, "counters.json")
REMOTE_SCRIPT = "~/.cache/claude-code-message/ccm.py"
REMOTE_HOME = "~/.local/share/claude-code-message"
PLUGIN_ID = "claude-code-message@claude-code-message"
PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
IS_LINUX = sys.platform.startswith("linux")
LOG_TAG = ""


def log(*a):
    sys.stderr.write(" ".join([time.strftime("%Y-%m-%dT%H:%M:%S"), f"[{LOG_TAG}]" if LOG_TAG else "", *map(str, a)]) + "\n")
    sys.stderr.flush()


def label_ok(s):
    s = re.sub(r"[^A-Za-z0-9_-]+", "-", s or "").strip("-_")
    return s[:40] or "peer"


def default_label():
    return label_ok(socket.gethostname().split(".")[0])


def now_ms():
    return int(time.time() * 1000)


def write_json_private(path, obj):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{secrets.token_hex(4)}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, ensure_ascii=False)
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def load_config():
    cfg = read_json(CONFIG_PATH) or {}
    cfg.setdefault("label", default_label())
    cfg.setdefault("peers", [])
    cfg.setdefault("audit_preview_chars", 160)
    return cfg


def save_config(cfg):
    write_json_private(CONFIG_PATH, cfg)


# -------------------------------------------------------------------- audit
_audit_lock = threading.Lock()


def audit(ev, **kw):
    """Append-only JSONL trail of every join/leave/task change and every
    message that crosses the bridge or is sent through ccm or SendMessage."""
    rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "node": load_config()["label"], "ev": ev}
    rec.update({k: v for k, v in kw.items() if v is not None})
    line = (json.dumps(rec, ensure_ascii=False) + "\n").encode()
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        with _audit_lock:
            try:
                if os.path.getsize(AUDITFILE) > AUDIT_MAX:
                    os.replace(AUDITFILE, AUDITFILE + ".1")
            except OSError:
                pass
            fd = os.open(AUDITFILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            try:
                os.write(fd, line)
            finally:
                os.close(fd)
    except OSError as e:
        log("audit write failed:", e)


SECRET_RES = [
    # ASCII lookarounds instead of \b: in CJK text a key often follows a letter with no space
    re.compile(r"(?<![A-Za-z0-9])(?:sk|pk|rk|ctx7sk|sess|ghp|gho|ghs|github_pat|glpat|xox[abprs])[-_][A-Za-z0-9_\-]{12,}"),
    re.compile(r"(?<![A-Za-z0-9])AKIA[0-9A-Z]{16}(?![A-Za-z0-9])"),
    re.compile(r"(?i)(?<![A-Za-z0-9])(bearer|basic)\s+[A-Za-z0-9._\-+=/]{16,}"),
    re.compile(r"(?<![A-Za-z0-9])eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    re.compile(r"""(?i)(?<![a-z0-9])(["']?[A-Z0-9_]*(?:password|passwd|pwd|secret|token|api[_-]?key)["']?)(\s*[:=]\s*["']?)[^\s"',}]+(["']?)"""),
    re.compile(r"://[^/\s:@]+:[^/\s@]+@"),
    re.compile(r"(?<![A-Za-z0-9])(?:[A-Fa-f0-9]{40,}|[A-Za-z0-9+/]{48,}={0,2})(?![A-Za-z0-9])"),
]


def redact(text):
    """Tasks and previews travel to other machines and into other agents' context;
    strip anything that looks like a credential first."""
    if not isinstance(text, str):
        return text
    for r in SECRET_RES:
        text = r.sub(lambda m: (m.group(1) + (m.group(2) if m.lastindex and m.lastindex > 1 else " ") + "[redacted]" + (m.group(3) if m.lastindex and m.lastindex >= 3 else ""))
                     if m.lastindex else ("://[redacted]@" if m.group(0).startswith("://") else "[redacted]"), text)
    return text


def preview(text):
    n = load_config()["audit_preview_chars"]
    if not n or not isinstance(text, str):
        return None
    text = re.sub(r"^<cross-session-message[^>]*>\n?", "", text)
    text = re.sub(r"\n?</cross-session-message>\s*$", "", text)
    text = redact(" ".join(text.split()))
    return text[:n] + ("…" if len(text) > n else "")


def frame_text(frame):
    c = (frame.get("message") or {}).get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return next((b.get("text") for b in c if isinstance(b, dict) and isinstance(b.get("text"), str)), None)
    return None


def header_attr(text, attr):
    m = re.match(r'<cross-session-message\b[^>]*\b' + attr + r'="([^"]*)"', text or "")
    return m.group(1) if m else None


class Counters:
    def __init__(self):
        self.data = read_json(COUNTERSFILE, {}) or {}
        self.lock = threading.Lock()
        self.dirty = False

    def bump(self, peer, key):
        with self.lock:
            self.data.setdefault(peer, {"relay_out": 0, "relay_in": 0, "errors": 0})
            self.data[peer][key] = self.data[peer].get(key, 0) + 1
            self.dirty = True

    def flush(self):
        with self.lock:
            if self.dirty:
                write_json_private(COUNTERSFILE, self.data)
                self.dirty = False


COUNTERS = Counters()


# ---------------------------------------------------------------- platform ids
# Must match how Claude Code identifies live processes (docs/PROTOCOL.md), or
# the mirror's registry record is silently ignored.

def proc_start(pid):
    if IS_LINUX:
        try:
            with open(f"/proc/{pid}/stat") as f:
                return f.read().rsplit(")", 1)[1].split()[19]
        except OSError:
            return None
    try:
        out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                             env={**os.environ, "LC_ALL": "C", "TZ": "UTC"}, timeout=2)
        return out.stdout.strip() or None
    except Exception:
        return None


def pid_domain():
    if not IS_LINUX:
        return "darwin" if sys.platform == "darwin" else sys.platform
    try:
        return f"linux:{open('/etc/machine-id').read().strip()}:{os.readlink('/proc/self/ns/pid')}"
    except OSError:
        return None


def socket_dir():
    for rec in read_sessions(include_mirrors=True):
        return os.path.dirname(rec["messagingSocketPath"])
    base = os.environ.get("CLAUDE_CODE_TMPDIR") or os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(base, "cc-socks")


def key_path(pid, sock):
    # path.resolve semantics: absolute, but symlinks (/tmp on macOS) are kept
    h = hashlib.sha256(os.path.abspath(sock).encode()).hexdigest()
    return os.path.join(SESSIONS_DIR, f"{pid}.{h}.key")


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def read_sessions(include_mirrors=False):
    out = []
    try:
        names = os.listdir(SESSIONS_DIR)
    except OSError:
        return out
    for n in names:
        if not re.fullmatch(r"\d+\.json", n):
            continue
        rec = read_json(os.path.join(SESSIONS_DIR, n))
        if not isinstance(rec, dict):
            continue
        if not include_mirrors and rec.get("agent") == MIRROR_TAG:
            continue
        pid = rec.get("pid")
        if not isinstance(pid, int) or not pid_alive(pid) or not rec.get("messagingSocketPath"):
            continue
        out.append(rec)
    return out


def is_mirror(rec):
    return rec.get("agent") == MIRROR_TAG


def display_name(rec):
    return rec.get("name") or os.path.basename(rec.get("cwd") or "") or str(rec.get("pid"))


def deliver_local(sock, pid, frame):
    """Write one frame to a local inbox (real session or mirror), authenticated
    with the owner's peerToken, exactly as Claude Code's own sender does."""
    kp = read_json(key_path(pid, sock))
    if not kp or "peerToken" not in kp:
        return f"no messaging key for pid {pid}"
    data = (json.dumps({"type": "auth", "token": kp["peerToken"]}) + "\n" +
            json.dumps(frame, ensure_ascii=False) + "\n").encode()
    if len(data) > MAX_FRAME:
        return "message too large"
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(5)
        c.connect(sock)
        c.sendall(data)
        time.sleep(0.15)
        c.shutdown(socket.SHUT_WR)
        c.close()
        return None
    except OSError as e:
        return f"{type(e).__name__}: {e}"


# ------------------------------------------------------------------- roster
def roster_path(sid):
    return os.path.join(ROSTER_DIR, f"{re.sub(r'[^A-Za-z0-9-]', '', sid)}.json")


def roster_get(sid):
    return read_json(roster_path(sid)) if sid else None


def roster_put(sid, **kw):
    clean_sid = re.sub(r'[^A-Za-z0-9-]', '', sid)
    lock_path = os.path.join(ROSTER_DIR, f"{clean_sid}.lock")
    os.makedirs(ROSTER_DIR, mode=0o700, exist_ok=True)
    try:
        lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            cur = roster_get(sid) or {"sessionId": sid, "joinedAt": now_ms()}
            cur.update({k: v for k, v in kw.items() if v is not None})
            cur["updatedAt"] = now_ms()
            write_json_private(roster_path(sid), cur)
            return cur
        finally:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
            os.close(lock_fd)
    except OSError:
        cur = roster_get(sid) or {"sessionId": sid, "joinedAt": now_ms()}
        cur.update({k: v for k, v in kw.items() if v is not None})
        cur["updatedAt"] = now_ms()
        write_json_private(roster_path(sid), cur)
        return cur


def roster_drop(sid):
    clean_sid = re.sub(r'[^A-Za-z0-9-]', '', sid)
    try:
        os.unlink(os.path.join(ROSTER_DIR, f"{clean_sid}.lock"))
    except OSError:
        pass
    try:
        os.unlink(roster_path(sid))
        return True
    except OSError:
        return False


def roster_sweep(live_sids):
    try:
        names = os.listdir(ROSTER_DIR)
    except OSError:
        return
    for n in names:
        if not n.endswith(".json"):
            continue
        rec = read_json(os.path.join(ROSTER_DIR, n)) or {}
        sid = rec.get("sessionId")
        if sid in live_sids:
            continue
        if now_ms() - rec.get("updatedAt", 0) > ROSTER_GRACE * 1000:
            roster_drop(sid or n[:-5])
            audit("leave", session=rec.get("name"), sessionId=sid, reason="swept (session gone)")


def _human_prompt(line):
    if '"user"' not in line:
        return None
    try:
        d = json.loads(line)
    except ValueError:
        return None
    origin = (d.get("origin") or {}).get("kind")
    if d.get("type") != "user" or d.get("isMeta") or d.get("isSidechain") or (origin is not None and origin != "human"):
        return None
    c = (d.get("message") or {}).get("content")
    t = c if isinstance(c, str) else next((b.get("text") for b in c or [] if isinstance(b, dict) and b.get("type") == "text"), None)
    return task_from_prompt(t)


def infer_task(rec):
    """For sessions without a hook-registered task (started before the plugin):
    the latest human prompt in the transcript. Scans backwards in 1 MB chunks and
    caches the answer in the roster, so it is computed once per session."""
    sid = rec.get("sessionId")
    if not sid:
        return None
    cached = roster_get(sid)
    if cached and "task" in cached:
        return redact(cached["task"])
    proj = re.sub(r"[^A-Za-z0-9]", "-", rec.get("cwd") or "")
    path = os.path.join(CLAUDE_DIR, "projects", proj, f"{sid}.jsonl")
    task = None
    try:
        with open(path, "rb") as f:
            end = f.seek(0, 2)
            tail = b""
            pos = end
            while pos > 0 and end - pos < 32 * 1024 * 1024 and not task:
                n = min(1024 * 1024, pos)
                pos -= n
                f.seek(pos)
                chunk = f.read(n) + tail
                lines = chunk.split(b"\n")
                tail = lines[0] if pos > 0 else b""
                for l in reversed(lines[1:] if pos > 0 else lines):
                    task = _human_prompt(l.decode("utf8", "replace"))
                    if task:
                        break
    except OSError:
        return None
    roster_put(sid, pid=rec.get("pid"), name=display_name(rec), cwd=rec.get("cwd"), task=task if task is not None else "", taskSource="inferred")
    return task


# text Claude Code injects as user turns: peer messages, skill bodies, resumes
NOT_A_TASK = ("<", "/", "[Request interrupted", "Another Claude session", "Base directory for this skill",
              "This session is being continued", "Caveat:")


def task_from_prompt(p):
    if not isinstance(p, str):
        return None
    p = p.strip()
    if not p or p.startswith(NOT_A_TASK) or len(p) < 6:
        return None
    first = next((l.strip() for l in p.splitlines() if l.strip()), "")
    first = redact(" ".join(first.split()))
    return first[:140] + ("…" if len(first) > 140 else "")


def roster_rows(infer=True):
    """Every member this machine can reach: local sessions + mirrors."""
    rows = []
    for rec in read_sessions(include_mirrors=True):
        if is_mirror(rec):
            rows.append({"name": rec.get("name"), "node": rec.get("ccmHost"), "remote": True,
                         "status": rec.get("status"), "task": rec.get("ccmTask"), "cwd": rec.get("cwd"),
                         "sessionId": rec.get("sessionId")})
        else:
            r = roster_get(rec.get("sessionId")) or {}
            task = redact(r.get("task")) if "task" in r else (infer_task(rec) if infer else None)
            rows.append({"name": display_name(rec), "node": load_config()["label"], "remote": False,
                         "status": rec.get("status"), "task": task,
                         "cwd": rec.get("cwd"), "sessionId": rec.get("sessionId")})
    rows.sort(key=lambda r: (r["remote"], r["node"] or "", r["name"] or ""))
    return rows


# ------------------------------------------------------------------- mirror
def cmd_mirror(a):
    """One process per remote session. Owning a real pid lets it publish a
    registry record, key and inbox that local Claude Code accepts as a peer.
    Received frames go to stdout; status/task updates come in on stdin."""
    pid = os.getpid()
    os.makedirs(SESSIONS_DIR, mode=0o700, exist_ok=True)
    sdir = socket_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    sock = os.path.join(sdir, f"{pid}.sock")
    token = secrets.token_hex(16)
    ps = proc_start(pid)
    dom = pid_domain()
    reg_path = os.path.join(SESSIONS_DIR, f"{pid}.json")
    kpath = key_path(pid, sock)
    remote = json.loads(a.remote)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.unlink(sock)
    except OSError:
        pass
    srv.bind(sock)
    os.chmod(sock, 0o600)
    srv.listen(16)

    def cleanup(*_):
        for p in (reg_path, kpath, sock):
            try:
                os.unlink(p)
            except OSError:
                pass
        os._exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    write_json_private(kpath, {"peerToken": token, "procStart": ps, "pidDomain": dom})
    now = now_ms()
    task = remote.get("task")
    reg = {
        "pid": pid, "sessionId": remote.get("sessionId"), "cwd": remote.get("cwd") or HOME,
        "startedAt": now, "procStart": ps, "version": remote.get("version") or "claude-code-message",
        "peerProtocol": remote.get("peerProtocol", 1), "peerFeatures": remote.get("peerFeatures") or [],
        "kind": "interactive", "entrypoint": "cli", "pidDomain": dom, "messagingSocketPath": sock,
        "name": a.name, "nameSource": "user", "nameSince": now, "agent": MIRROR_TAG,
        "ccmHost": a.peer, "ccmRemoteName": remote.get("name"), "ccmTask": task,
        "detail": f"[{a.peer}] {task}" if task else f"[{a.peer}] {remote.get('name')}",
        "status": remote.get("status") or "idle", "updatedAt": now, "statusUpdatedAt": now,
    }
    write_json_private(reg_path, reg)
    print(json.dumps({"ready": True, "pid": pid, "sock": sock}), flush=True)

    def stdin_loop():
        for line in sys.stdin:
            try:
                upd = json.loads(line)
            except ValueError:
                continue
            changed = False
            if upd.get("status") and upd["status"] != reg["status"]:
                reg["status"] = upd["status"]
                reg["statusUpdatedAt"] = now_ms()
                changed = True
            if "task" in upd and upd["task"] != reg.get("ccmTask"):
                reg["ccmTask"] = upd["task"]
                reg["detail"] = f"[{a.peer}] {upd['task']}" if upd["task"] else f"[{a.peer}] {reg['ccmRemoteName']}"
                changed = True
            if changed:
                reg["updatedAt"] = now_ms()
                write_json_private(reg_path, reg)
        cleanup()

    threading.Thread(target=stdin_loop, daemon=True).start()
    out_lock = threading.Lock()

    def handle(c):
        buf = b""
        c.settimeout(3)
        try:
            while len(buf) <= MAX_FRAME + 4096:
                d = c.recv(65536)
                if not d:
                    break
                buf += d
        except OSError:
            pass
        finally:
            c.close()
        lines = [l for l in buf.split(b"\n") if l.strip()]
        if not lines:
            return  # liveness probe
        try:
            first = json.loads(lines[0])
        except ValueError:
            return
        if first.get("type") != "auth" or not secrets.compare_digest(str(first.get("token", "")), token):
            log("mirror: unauthenticated frame dropped")
            return
        for l in lines[1:]:
            try:
                frame = json.loads(l)
            except ValueError:
                continue
            with out_lock:
                print(json.dumps({"frame": frame}, ensure_ascii=False), flush=True)

    while True:
        c, _ = srv.accept()
        threading.Thread(target=handle, args=(c,), daemon=True).start()


# --------------------------------------------------------------------- node
class Node:
    """One end of a link; both ends run the same logic: publish local sessions
    (with their registered task), mirror the peer's, relay frames both ways."""

    def __init__(self, rfile, wfile, label, peer_label=None, is_server=False):
        self.rfile, self.wfile = rfile, wfile
        self.label = label
        self.peer_label = peer_label
        self.is_server = is_server
        self.wlock = threading.Lock()
        self.mlock = threading.Lock()
        self.mirrors = {}      # remote pid -> {"proc","sock","pid","name","rec"}
        self.local = {}        # local pid -> registry record
        self.last_pub = None
        self.stop = threading.Event()
        self.session = {"relay_out": 0, "relay_in": 0, "errors": 0}

    def send(self, obj):
        data = (json.dumps(obj, ensure_ascii=False) + "\n").encode()
        with self.wlock:
            self.wfile.write(data)
            self.wfile.flush()

    def bump(self, key):
        self.session[key] += 1
        COUNTERS.bump(self.peer_label or "?", key)

    def scan(self):
        recs = {r["pid"]: r for r in read_sessions()}
        self.local = recs
        roster_sweep({r.get("sessionId") for r in recs.values()})
        pub = []
        for r in sorted(recs.values(), key=lambda r: r["pid"]):
            if r.get("kind") not in ("interactive", "bg", None):
                continue
            item = {k: r.get(k) for k in ("pid", "sessionId", "name", "cwd", "status", "peerProtocol",
                                          "peerFeatures", "version", "kind")}
            item["task"] = redact((roster_get(r.get("sessionId")) or {}).get("task")) or infer_task(r)
            pub.append(item)
        if pub != self.last_pub:
            self.last_pub = pub
            self.send({"op": "sessions", "label": self.label, "list": pub})

    def mirror_name(self, rec):
        # session names may be any language (users rename sessions); keep word chars of every script
        base = re.sub(r"[^\w.-]+", "-", display_name(rec)).strip("-.") or str(rec["pid"])
        return f"{self.peer_label}-{base}"[:64]

    def sync_mirrors(self, remote_list):
        want = {r["pid"]: r for r in remote_list}
        with self.mlock:
            for pid in list(self.mirrors):
                m = self.mirrors[pid]
                if pid not in want or m["proc"].poll() is not None or want[pid].get("name") != m["rec"].get("name"):
                    self.kill_mirror(pid)
            for pid, rec in want.items():
                if pid not in self.mirrors:
                    self.spawn_mirror(pid, rec)
                    continue
                m = self.mirrors[pid]
                upd = {}
                if rec.get("status") != m["rec"].get("status"):
                    upd["status"] = rec.get("status")
                if rec.get("task") != m["rec"].get("task"):
                    upd["task"] = rec.get("task")
                m["rec"] = rec
                if upd:
                    try:
                        m["proc"].stdin.write((json.dumps(upd) + "\n").encode())
                        m["proc"].stdin.flush()
                    except OSError:
                        pass

    def spawn_mirror(self, rpid, rec):
        name = self.mirror_name(rec)
        if name in {m["name"] for m in self.mirrors.values()}:
            name = f"{name}-{rpid}"[:64]
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "mirror", "--name", name,
                                 "--peer", self.peer_label, "--remote", json.dumps(rec)],
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        ready = json.loads(proc.stdout.readline() or b"{}")
        if not ready.get("ready"):
            log("mirror failed to start for", rec.get("name"))
            proc.kill()
            return
        self.mirrors[rpid] = {"proc": proc, "sock": ready["sock"], "pid": ready["pid"], "name": name, "rec": rec}
        threading.Thread(target=self.mirror_reader, args=(rpid, proc), daemon=True).start()
        log(f"mirror up: {name} -> {self.peer_label}:{rec.get('name')} (local pid {ready['pid']})")

    def kill_mirror(self, rpid):
        m = self.mirrors.pop(rpid, None)
        if not m:
            return
        try:
            m["proc"].terminate()
            m["proc"].wait(3)
        except Exception:
            m["proc"].kill()
        log(f"mirror down: {m['name']}")

    def mirror_reader(self, rpid, proc):
        for line in proc.stdout:
            try:
                frame = json.loads(line)["frame"]
            except (ValueError, KeyError):
                continue
            m = self.mirrors.get(rpid) or {}
            src = self.local_by_sock(frame.get("from"))
            text = frame_text(frame)
            self.send({"op": "deliver", "to_pid": rpid, "from_pid": src and src["pid"], "frame": frame})
            self.bump("relay_out")
            audit("relay_out", msg_id=frame.get("msg_id"), frame_type=frame.get("type"),
                  sender=(src and display_name(src)) or header_attr(text, "from-name"),
                  to=m.get("name"), peer=self.peer_label, preview=preview(text))

    def local_by_sock(self, addr):
        if not isinstance(addr, str) or not addr.startswith("uds:"):
            return None
        path = os.path.abspath(addr[4:])
        for r in list(self.local.values()):
            if os.path.abspath(r["messagingSocketPath"]) == path:
                return r
        return None

    def on_deliver(self, msg):
        frame = msg["frame"]
        target = self.local.get(msg["to_pid"]) or {r["pid"]: r for r in read_sessions()}.get(msg["to_pid"])
        sender = self.mirrors.get(msg.get("from_pid"))
        if sender:
            frame = rewrite_from(frame, sender["sock"], sender["name"])
        err = "target session gone" if not target else deliver_local(target["messagingSocketPath"], target["pid"], frame)
        self.bump("relay_in")
        if err:
            self.bump("errors")
            log("deliver failed:", err)
        text = frame_text(frame)
        audit("relay_in", msg_id=frame.get("msg_id"), frame_type=frame.get("type"),
              sender=(sender and sender["name"]) or header_attr(text, "from-name"),
              to=target and display_name(target), peer=self.peer_label, ok=not err, error=err, preview=preview(text))
        self.send({"op": "ack", "id": frame.get("msg_id"), "error": err})

    def run(self):
        self.send({"op": "hello", "label": self.label, "version": VERSION, "proto": PROTO})

        def scanner():
            while not self.stop.is_set():
                try:
                    self.scan()
                except Exception as e:
                    log("scan error:", e)
                self.stop.wait(SCAN_INTERVAL)

        threading.Thread(target=scanner, daemon=True).start()
        try:
            for line in self.rfile:
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                op = msg.get("op")
                if op == "hello":
                    self.peer_label = self.peer_label or label_ok(msg.get("label"))
                    if msg.get("version") != VERSION:
                        log(f"peer runs {msg.get('version')}, we run {VERSION}")
                    if self.is_server and self.peer_label in {p["label"] for p in load_config()["peers"]} and daemon_pid():
                        # both sides dialled each other: two links would mirror everyone twice
                        self.send({"op": "error", "error": f"{self.label} already links to {self.peer_label}; pair from one side only"})
                        return
                    audit("link_up", peer=self.peer_label, role="serve" if self.is_server else "dial", version=msg.get("version"))
                elif op == "sessions":
                    self.peer_label = self.peer_label or label_ok(msg.get("label"))
                    self.sync_mirrors(msg.get("list") or [])
                elif op == "deliver":
                    threading.Thread(target=self.on_deliver, args=(msg,), daemon=True).start()
                elif op == "ack" and msg.get("error"):
                    log("remote delivery error:", msg)
                elif op == "error":
                    log("peer refused link:", msg.get("error"))
                    audit("link_refused", peer=self.peer_label, error=msg.get("error"))
                    return
        finally:
            self.stop.set()
            with self.mlock:
                for pid in list(self.mirrors):
                    self.kill_mirror(pid)
            COUNTERS.flush()
            audit("link_down", peer=self.peer_label, session_counts=self.session)


def rewrite_from(frame, sock, name):
    """Point the reply address at our local mirror of the sender, in both the
    envelope and the <cross-session-message> header the model reads."""
    frame = json.loads(json.dumps(frame))
    old = frame.get("from")
    new = f"uds:{sock}"
    if old:
        frame["from"] = new

    def fix(t):
        m = re.match(r"<cross-session-message\b[^>]*>", t)
        if not m:
            return t
        h = m.group(0)
        if old:
            h = h.replace(f'from="{old}"', f'from="{new}"', 1)
        h = re.sub(r'from-name="[^"]*"', f'from-name="{name}"', h, count=1)
        return h + t[m.end():]

    msg = frame.get("message")
    if isinstance(msg, dict):
        c = msg.get("content")
        if isinstance(c, str):
            msg["content"] = fix(c)
        elif isinstance(c, list):
            for b in c:
                if isinstance(b, dict) and isinstance(b.get("text"), str):
                    b["text"] = fix(b["text"])
                    break
    return frame


# ------------------------------------------------------------------ links
def cmd_serve(a):
    global LOG_TAG
    LOG_TAG = label_ok(a.label or load_config()["label"])
    if a.label:
        cfg = load_config()
        if cfg.get("label") != LOG_TAG:
            cfg["label"] = LOG_TAG
            save_config(cfg)
    try:
        Node(sys.stdin.buffer, sys.stdout.buffer, LOG_TAG, is_server=True).run()
    finally:
        COUNTERS.flush()


def remote_bootstrap(host):
    with open(os.path.abspath(__file__), "rb") as f:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", host,
                            f"mkdir -p ~/.cache/claude-code-message && cat > {REMOTE_SCRIPT}.new && mv {REMOTE_SCRIPT}.new {REMOTE_SCRIPT} && chmod 700 {REMOTE_SCRIPT}"],
                           stdin=f, capture_output=True, timeout=30)
    if r.returncode:
        raise RuntimeError(f"bootstrap to {host} failed: {r.stderr.decode().strip()}")


def run_link(host, label, peer_label, links):
    remote_bootstrap(host)
    cmd = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
           host, f"python3 {REMOTE_SCRIPT} serve --label {peer_label}"]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    node = Node(proc.stdout, proc.stdin, label, peer_label)
    links[host] = node
    try:
        node.run()
    finally:
        proc.kill()
        links.pop(host, None)


def daemon_pid():
    try:
        pid = int(open(PIDFILE).read().strip())
        return pid if pid_alive(pid) else None
    except Exception:
        return None


def cmd_link(a):
    cfg = load_config()
    peer = next((p for p in cfg["peers"] if p["host"] == a.host), {"host": a.host, "label": label_ok(a.host)})
    run_link(a.host, cfg["label"], peer["label"], {})


def daemon_main(peers, label):
    global LOG_TAG
    LOG_TAG = label
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    open(PIDFILE, "w").write(str(os.getpid()))
    links = {}
    started = int(time.time())

    def keep(peer):
        backoff = 1
        while True:
            t0 = time.time()
            try:
                log(f"link {peer['host']}: connecting")
                run_link(peer["host"], label, peer["label"], links)
            except Exception as e:
                log(f"link {peer['host']}: {e}")
            if time.time() - t0 > 60:
                backoff = 1
            log(f"link {peer['host']}: down, retry in {backoff}s")
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)

    def on_term(*_):
        for n in list(links.values()):
            with n.mlock:
                for pid in list(n.mirrors):
                    n.kill_mirror(pid)
        COUNTERS.flush()
        audit("daemon_down")
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        os._exit(0)

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    audit("daemon_up", version=VERSION, peers=[p["host"] for p in peers])
    for p in peers:
        threading.Thread(target=keep, args=(p,), daemon=True).start()
    while True:
        COUNTERS.flush()
        snap = {"pid": os.getpid(), "version": VERSION, "label": label, "started": started,
                "updated": int(time.time()), "links": {
                    h: {"peer": n.peer_label, "session": n.session, "total": COUNTERS.data.get(n.peer_label, {}),
                        "mirrors": [{"name": m["name"], "remote": m["rec"].get("name"), "status": m["rec"].get("status"),
                                     "task": m["rec"].get("task"), "local_pid": m["pid"]} for m in list(n.mirrors.values())]}
                    for h, n in list(links.items())}}
        write_json_private(STATUSFILE, snap)
        time.sleep(2)


def cmd_up(a):
    cfg = load_config()
    hosts = a.hosts or [p["host"] for p in cfg["peers"]]
    if not hosts:
        sys.exit("no peers configured: run `ccm pair HOST` first")
    peers = [next((p for p in cfg["peers"] if p["host"] == h), {"host": h, "label": label_ok(h)}) for h in hosts]
    if daemon_pid():
        print(f"already running (pid {daemon_pid()})")
        return
    if a.foreground:
        daemon_main(peers, cfg["label"])
        return
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    logf = open(LOGFILE, "a")
    p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "up", "--foreground", *hosts],
                         stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True)
    for _ in range(50):
        if daemon_pid():
            break
        time.sleep(0.1)
    print(f"claude-code-message up (pid {p.pid}), log: {LOGFILE}")


def cmd_down(a):
    pid = daemon_pid()
    if not pid:
        print("not running")
    else:
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if not pid_alive(pid):
                break
            time.sleep(0.1)
        print("stopped")
    for r in read_sessions(include_mirrors=True):  # mirrors left by a crashed daemon
        if is_mirror(r):
            try:
                os.kill(r["pid"], signal.SIGTERM)
            except OSError:
                pass


def cmd_restart(a):
    cmd_down(a)
    a.hosts, a.foreground = [], False
    cmd_up(a)


def ensure_daemon():
    if load_config()["peers"] and not daemon_pid():
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "up"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_ensure(a):
    ensure_daemon()


def cmd_status(a):
    pid = daemon_pid()
    st = read_json(STATUSFILE, {}) or {}
    if a.json:
        print(json.dumps({"running": bool(pid), **st}, indent=2, ensure_ascii=False))
        return
    cfg = load_config()
    print(f"claude-code-message {VERSION}  node: {cfg['label']}  daemon: "
          f"{'running pid %d (v%s)' % (pid, st.get('version', '?')) if pid else 'stopped'}")
    if not pid:
        return
    for host, l in (st.get("links") or {}).items():
        t, s = l.get("total", {}), l.get("session", {})
        print(f"  link {host} ({l['peer']})  up this session: out={s.get('relay_out', 0)} in={s.get('relay_in', 0)}"
              f"  |  all time: out={t.get('relay_out', 0)} in={t.get('relay_in', 0)} errors={t.get('errors', 0)}")
        print(f"    {len(l['mirrors'])} remote members mirrored — `ccm roster` for details")
    missing = [p["host"] for p in cfg["peers"] if p["host"] not in (st.get("links") or {})]
    for h in missing:
        print(f"  link {h}: DOWN (reconnecting; see {LOGFILE})")


# ------------------------------------------------------------ chat commands
def whoami():
    """The Claude session this command runs inside (Bash tool / hook), if any."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    sock = os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET")
    for r in read_sessions():
        if (sid and r.get("sessionId") == sid) or (sock and os.path.abspath(r["messagingSocketPath"]) == os.path.abspath(sock)):
            return r
    return None


def permission_mode(pid):
    """Best effort, from the command line: anything we cannot prove is bypass is
    reported as default, so receivers in bypass mode hold it for approval."""
    try:
        args = subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return "default"
    if "--dangerously-skip-permissions" in args or re.search(r"--permission-mode[ =]bypassPermissions", args):
        return "bypass"
    return "default"


def build_frame(me, text):
    label = load_config()["label"]
    if me:
        name, mode = display_name(me), permission_mode(me["pid"])
        attrs = f'from="uds:{me["messagingSocketPath"]}" from-name="{name}" from-mode="{mode}"'
    else:
        name, mode = f"{label}-cli", "default"
        attrs = f'from-name="{name}" from-mode="{mode}"'
    frame = {"msgV": 1, "msg_id": str(uuid.uuid4()), "type": "user", "priority": "next",
             "message": {"role": "user", "content": f"<cross-session-message {attrs}>\n{text}\n</cross-session-message>"}}
    if me:
        frame["from"] = f"uds:{me['messagingSocketPath']}"
    return frame, name


def resolve(target, members):
    t = target.lower()
    exact = [m for m in members if (m.get("name") or "").lower() == t]
    if exact:
        return exact[0]
    pref = [m for m in members if (m.get("name") or "").lower().startswith(t)]
    if len(pref) == 1:
        return pref[0]
    names = ", ".join(sorted(m.get("name") or "?" for m in (pref or members)))
    sys.exit(f"{'ambiguous' if pref else 'unknown'} member '{target}'. Candidates: {names}")


def read_text(a):
    text = " ".join(a.text) if a.text else sys.stdin.read()
    text = text.strip()
    if not text:
        sys.exit("empty message")
    return text


def cmd_send(a):
    me = whoami()
    members = [r for r in read_sessions(include_mirrors=True) if not me or r["pid"] != me["pid"]]
    target = resolve(a.to, members)
    frame, sender = build_frame(me, read_text(a))
    err = deliver_local(target["messagingSocketPath"], target["pid"], frame)
    audit("send", msg_id=frame["msg_id"], sender=sender, to=display_name(target), via="ccm",
          ok=not err, error=err, preview=preview(frame_text(frame)))
    print(f"→ {display_name(target)}: {'ok' if not err else err}")
    sys.exit(1 if err else 0)


def cmd_broadcast(a):
    me = whoami()
    label = load_config()["label"]
    members = [r for r in read_sessions(include_mirrors=True) if not me or r["pid"] != me["pid"]]
    if a.local:
        members = [r for r in members if not is_mirror(r)]
    if a.node:
        members = [r for r in members if (r.get("ccmHost") if is_mirror(r) else label) == a.node]
    if a.match:
        members = [r for r in members if re.search(a.match, display_name(r))]
    if not members:
        sys.exit("nobody to broadcast to")
    text = read_text(a)
    frame, sender = build_frame(me, f"[broadcast to {len(members)} members] {text}")
    results = {}
    for r in members:
        f = dict(frame, msg_id=str(uuid.uuid4()))
        results[display_name(r)] = deliver_local(r["messagingSocketPath"], r["pid"], f) or "ok"
    audit("broadcast", msg_id=frame["msg_id"], sender=sender, to=sorted(results), results=results,
          preview=preview(frame_text(frame)))
    for n, res in sorted(results.items()):
        print(f"→ {n}: {res}")
    sys.exit(0 if all(v == "ok" for v in results.values()) else 1)


def cmd_task(a):
    me = whoami()
    if not me:
        sys.exit("run this from inside a Claude Code session")
    if not a.text:
        print((roster_get(me["sessionId"]) or {}).get("task") or infer_task(me) or "(no task registered)")
        return
    task = redact(" ".join(a.text).strip()[:200])
    roster_put(me["sessionId"], pid=me["pid"], name=display_name(me), cwd=me.get("cwd"), task=task, taskSource="agent")
    audit("task", session=display_name(me), task=task, source="agent")
    print(f"task registered for {display_name(me)}: {task}")


def cmd_roster(a):
    rows = roster_rows()
    me = whoami()
    if a.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    for r in rows:
        you = "  ← you" if me and r["sessionId"] == me.get("sessionId") and not r["remote"] else ""
        cwd = re.sub(r"^(/home|/Users)/[^/]+", "~", r["cwd"] or "")
        print(f"{r['name']:<34} {r['node'] or '?':<10} {r['status'] or '':<5} {cwd:<28} {r['task'] or '-'}{you}")


def cmd_log(a):
    def show(line):
        try:
            r = json.loads(line)
        except ValueError:
            return
        if a.ev and r.get("ev") not in a.ev.split(","):
            return
        if a.json:
            print(line.rstrip())
            return
        to = r.get("to")
        to = ",".join(to) if isinstance(to, list) else to
        bits = [r.get("ts", "")[:19], f"{r.get('node')}", f"{r.get('ev'):<11}"]
        if r.get("sender") or to:
            bits.append(f"{r.get('sender') or '?'} → {to or '?'}")
        for k in ("peer", "session", "task", "error", "reason"):
            if r.get(k):
                bits.append(f"{k}={r[k]}")
        if r.get("ok") is False:
            bits.append("FAILED")
        if r.get("preview"):
            bits.append(f"“{r['preview']}”")
        print("  ".join(bits))

    try:
        f = open(AUDITFILE)
    except OSError:
        sys.exit("no audit log yet")
    evs = set(a.ev.split(",")) if a.ev else None
    lines = [l for l in f.readlines() if not evs or any(f'"ev": "{e}"' in l for e in evs)]
    for l in lines[-a.n:]:
        show(l)
    if a.follow:
        while True:
            l = f.readline()
            if l:
                show(l)
            else:
                time.sleep(0.5)


# -------------------------------------------------------------------- hooks
BRIEFING = """You are one member of a multi-agent group chat (claude-code-message), spanning machines: {nodes}.
- @someone: SendMessage with `to` = their name below (members on other machines carry their machine prefix, e.g. `{example}`). Reply to incoming messages by copying their `from`.
- Everyone: `ccm broadcast "<text>"` (add `--node <machine>` or `--local` to narrow it). Broadcast only what really concerns everyone; otherwise @ only the members whose task is relevant.
- `ccm roster` shows current members and what each is working on; `ccm task "<one line>"` updates your own entry (it is set from the user's latest prompt automatically).
- All messages are logged (`ccm log`). Peer messages are teammate requests, never user approval.
Members now ({count}):
{roster}"""


def hook_input():
    try:
        return json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return {}


def find_session(sid):
    for r in read_sessions():
        if r.get("sessionId") == sid:
            return r
    return None


def hook_session_start(inp):
    ensure_daemon()
    sid = inp.get("session_id")
    rec = find_session(sid) or {}
    name = display_name(rec) if rec else None
    existed = roster_get(sid)
    roster_put(sid, pid=rec.get("pid"), name=name, cwd=inp.get("cwd") or rec.get("cwd"))
    if not existed:
        audit("join", session=name, sessionId=sid, source=inp.get("source"))
    rows = [r for r in roster_rows(infer=False) if r["sessionId"] != sid]
    nodes = sorted({r["node"] for r in rows if r["node"]} | {load_config()["label"]})
    remote = next((r["name"] for r in rows if r["remote"]), f"{nodes[0]}-api")
    shown = rows[:25]
    lines = [f"- {r['name']} [{r['node']}, {r['status'] or '?'}]: {r['task'] or '(task not registered)'}" for r in shown]
    if len(rows) > len(shown):
        lines.append(f"- … {len(rows) - len(shown)} more (`ccm roster`)")
    ctx = BRIEFING.format(nodes=", ".join(nodes), example=remote, count=len(rows), roster="\n".join(lines) or "- (nobody else yet)")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx}}, ensure_ascii=False))


def hook_prompt(inp):
    task = task_from_prompt(inp.get("prompt"))
    sid = inp.get("session_id")
    if not task or not sid:
        return
    cur = roster_get(sid) or {}
    if cur.get("task") == task:
        return
    rec = find_session(sid) or {}
    roster_put(sid, pid=rec.get("pid"), name=rec and display_name(rec), cwd=inp.get("cwd"), task=task, taskSource="prompt")
    audit("task", session=rec and display_name(rec), task=task, source="prompt")


def hook_sent(inp):
    ti = inp.get("tool_input") or {}
    resp = inp.get("tool_response")
    resp_s = resp if isinstance(resp, str) else json.dumps(resp, ensure_ascii=False)
    rec = find_session(inp.get("session_id")) or {}
    ok = '"success":false' not in (resp_s or "").replace(" ", "")
    to = ti.get("to")
    if isinstance(to, str) and to.startswith("uds:"):  # replies address a socket; log the member name
        path = os.path.abspath(to[4:])
        to = next((display_name(r) for r in read_sessions(include_mirrors=True)
                   if os.path.abspath(r["messagingSocketPath"]) == path), to)
    audit("native_send", sender=rec and display_name(rec), to=to, via="SendMessage",
          summary=redact(ti.get("summary")), ok=ok, idle_sub=ti.get("notify_when_idle"),
          preview=preview(ti.get("message")) if ti.get("message") else None)


def hook_session_end(inp):
    sid = inp.get("session_id")
    cur = roster_get(sid) or {}
    if roster_drop(sid):
        audit("leave", session=cur.get("name"), sessionId=sid, reason=inp.get("reason"))


def cmd_hook(a):
    try:
        inp = hook_input()
        {"session-start": hook_session_start, "prompt": hook_prompt, "sent": hook_sent,
         "session-end": hook_session_end}[a.event](inp)
    except Exception as e:  # a hook must never break the session
        log(f"hook {a.event} failed: {e}")


# ---------------------------------------------------------- setup commands
SHIM = """#!/usr/bin/env python3
# claude-code-message shim: always runs the installed plugin's ccm (falls back to {fallback})
import json, os, sys
target = {fallback!r}
try:
    p = os.path.expanduser("~/.claude/plugins/installed_plugins.json")
    inst = json.load(open(p))["plugins"]["{plugin}"][0]["installPath"]
    if os.path.exists(os.path.join(inst, "bin", "ccm")):
        target = os.path.join(inst, "bin", "ccm")
except Exception:
    pass
os.execv(sys.executable, [sys.executable, target] + sys.argv[1:])
"""


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def claude_bin():
    for d in os.environ.get("PATH", "").split(os.pathsep) + ["/opt/homebrew/bin", "/usr/local/bin", os.path.join(HOME, ".local/bin")]:
        p = os.path.join(d, "claude")
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def installed_plugin():
    ip = read_json(os.path.join(CLAUDE_DIR, "plugins", "installed_plugins.json"), {}) or {}
    lst = (ip.get("plugins") or {}).get(PLUGIN_ID) or []
    return lst[0] if lst else None


def cmd_init(a):
    cfg = load_config()
    if a.label:
        cfg["label"] = label_ok(a.label)
    save_config(cfg)
    print(f"✓ node label: {cfg['label']}")
    claude = claude_bin()
    if not a.no_plugin and claude:
        sh([claude, "plugin", "marketplace", "add", PLUGIN_ROOT])
        sh([claude, "plugin", "marketplace", "update", "claude-code-message"])
        inst = installed_plugin()
        if inst:
            r = sh([claude, "plugin", "update", PLUGIN_ID])
            if (installed_plugin() or {}).get("version") != VERSION:
                sh([claude, "plugin", "uninstall", PLUGIN_ID])
                r = sh([claude, "plugin", "install", PLUGIN_ID])
        else:
            r = sh([claude, "plugin", "install", PLUGIN_ID])
        v = (installed_plugin() or {}).get("version")
        print(f"{'✓' if v == VERSION else '✗'} Claude plugin {PLUGIN_ID}: {v or 'not installed'} {'' if v == VERSION else r.stderr.strip()[-300:]}")
    elif not claude:
        print("! claude CLI not found; skipped plugin install (hooks and skill need it)")
    bindir = os.path.join(HOME, ".local", "bin")
    os.makedirs(bindir, exist_ok=True)
    shim = os.path.join(bindir, "ccm")
    if os.path.islink(shim):
        os.unlink(shim)
    with open(shim, "w") as f:
        f.write(SHIM.format(fallback=os.path.join(PLUGIN_ROOT, "bin", "ccm"), plugin=PLUGIN_ID))
    os.chmod(shim, 0o755)
    print(f"✓ shim: {shim}{'' if bindir in os.environ.get('PATH', '') else '  (add ~/.local/bin to PATH)'}")
    print("Next: `ccm pair <ssh-host>` on ONE machine, then `ccm doctor`. New sessions join the group chat automatically.")


def cmd_pair(a):
    cfg = load_config()
    host = a.host
    rlabel = label_ok(a.remote_label or host)
    step = lambda ok, msg: print(f"{'✓' if ok else '✗'} {msg}") or ok
    if not step(sh(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, "true"]).returncode == 0,
                f"ssh {host} works without prompts"):
        sys.exit("fix: set up key-based ssh (ssh-copy-id) and a Host entry in ~/.ssh/config")
    r = sh(["ssh", "-o", "BatchMode=yes", host, "python3 -c 'import sys;print(sys.version_info[:2]>=(3,8))'"])
    if not step(r.stdout.strip() == "True", f"python3 >= 3.8 on {host}"):
        sys.exit(1)
    rc = sh(["ssh", "-o", "BatchMode=yes", host, f"cat ~/.config/claude-code-message/config.json 2>/dev/null || echo {{}}"])
    rcfg = json.loads(rc.stdout or "{}") if rc.returncode == 0 else {}
    if any(p.get("label") == cfg["label"] for p in rcfg.get("peers", [])):
        sys.exit(f"✗ {host} already dials this machine ({cfg['label']}); a pair needs exactly one dialler. "
                 f"Run `ccm unpair <this-host>` there, or keep that direction.")
    tar = subprocess.Popen(["tar", "czf", "-", "--exclude", ".git", "--exclude", "__pycache__", "-C", PLUGIN_ROOT, "."],
                           stdout=subprocess.PIPE)
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", host,
                        f"rm -rf {REMOTE_HOME}.new && mkdir -p {REMOTE_HOME}.new && tar xzf - -C {REMOTE_HOME}.new && "
                        f"rm -rf {REMOTE_HOME} && mv {REMOTE_HOME}.new {REMOTE_HOME}"],
                       stdin=tar.stdout, capture_output=True, text=True)
    tar.wait()
    if not step(r.returncode == 0, f"copied claude-code-message {VERSION} to {host}:{REMOTE_HOME}"):
        sys.exit(r.stderr)
    r = sh(["ssh", "-o", "BatchMode=yes", host,
            f"PATH=$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH python3 {REMOTE_HOME}/bin/ccm init --label {rlabel}"])
    for line in r.stdout.strip().splitlines():
        print(f"    [{host}] {line}")
    if not step(r.returncode == 0, f"initialised {host} as node '{rlabel}'"):
        sys.exit(r.stderr)
    cfg["peers"] = [p for p in cfg["peers"] if p["host"] != host] + [{"host": host, "label": rlabel}]
    save_config(cfg)
    step(True, f"peer saved: {host} as '{rlabel}' ({CONFIG_PATH})")
    audit("pair", peer=rlabel, host=host)
    a.hosts, a.foreground = [], False
    cmd_restart(a)
    for _ in range(40):
        st = read_json(STATUSFILE, {}) or {}
        l = (st.get("links") or {}).get(host)
        if l and l.get("mirrors"):
            step(True, f"link up: {len(l['mirrors'])} member(s) on {rlabel} visible here")
            break
        time.sleep(0.5)
    else:
        step(False, f"link not up yet; check `ccm doctor` and {LOGFILE}")


def cmd_unpair(a):
    cfg = load_config()
    cfg["peers"] = [p for p in cfg["peers"] if p["host"] != a.host and p["label"] != a.host]
    save_config(cfg)
    audit("unpair", host=a.host)
    a.hosts, a.foreground = [], False
    cmd_down(a)
    if cfg["peers"]:
        cmd_up(a)
    print(f"unpaired {a.host}")


def cmd_doctor(a):
    fails = 0

    def check(ok, msg, fix=None, warn=False):
        nonlocal fails
        print(f"{'✓' if ok else ('!' if warn else '✗')} {msg}" + ("" if ok or not fix else f"\n    fix: {fix}"))
        if not ok and not warn:
            fails += 1

    cfg = load_config()
    check(sys.version_info >= (3, 8), f"python {sys.version.split()[0]}")
    check(os.path.isdir(SESSIONS_DIR), f"Claude sessions dir {SESSIONS_DIR}", "start Claude Code once")
    sd = socket_dir()
    try:
        mode = oct(os.stat(sd).st_mode & 0o777)
        check(mode == "0o700", f"socket dir {sd} ({mode})", f"chmod 700 {sd}")
    except OSError:
        check(True, f"socket dir {sd} (created on first session)")
    claude = claude_bin()
    lv = sh([claude, "--version"]).stdout.split()[0] if claude else None
    check(bool(claude), f"claude CLI {lv or 'not found'}")
    inst = installed_plugin()
    check(bool(inst), f"plugin {PLUGIN_ID} {inst and inst.get('version')}", "ccm init")
    if inst and inst.get("version") != VERSION:
        check(False, f"this ccm is {VERSION} but the installed plugin is {inst.get('version')}", "ccm init", warn=True)
    check(os.path.exists(os.path.join(HOME, ".local", "bin", "ccm")), "shim ~/.local/bin/ccm", "ccm init")
    check(True, f"node label '{cfg['label']}'")
    pid = daemon_pid()
    st = read_json(STATUSFILE, {}) or {}
    if cfg["peers"]:
        check(bool(pid), f"daemon {'running pid %s v%s' % (pid, st.get('version')) if pid else 'stopped'}", "ccm up")
        if pid and st.get("version") != VERSION:
            check(False, f"daemon runs {st.get('version')}, installed {VERSION}", "ccm restart", warn=True)
    else:
        check(True, "no peers dialled from here (fine if the other machine dials this one)")
    for p in cfg["peers"]:
        h = p["host"]
        ok = sh(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", h, "true"]).returncode == 0
        check(ok, f"ssh {h}", "key-based ssh without prompts")
        if ok:
            rv = sh(["ssh", "-o", "BatchMode=yes", h, "PATH=$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH; claude --version 2>/dev/null | cut -d' ' -f1"]).stdout.strip()
            check(not lv or rv == lv, f"{h} Claude Code {rv or '?'} (local {lv})",
                  "keep both machines on the same Claude Code version: the peer protocol is internal", warn=True)
        l = (st.get("links") or {}).get(h)
        check(bool(l), f"link {h} ({p['label']}): {'%d members mirrored' % len(l['mirrors']) if l else 'down'}",
              f"see {LOGFILE}")
    me = whoami()
    if me:
        r = roster_get(me.get("sessionId"))
        check(bool(r), f"this session registered as {display_name(me)}: {(r or {}).get('task') or infer_task(me) or '-'}",
              "the SessionStart hook registers new sessions; older sessions show an inferred task", warn=True)
    print("all good" if not fails else f"{fails} problem(s)")
    sys.exit(1 if fails else 0)


def cmd_config(a):
    cfg = load_config()
    if a.action == "set-label":
        cfg["label"] = label_ok(a.value)
    elif a.action == "set-preview":
        cfg["audit_preview_chars"] = int(a.value)
    if a.action != "show":
        save_config(cfg)
    print(json.dumps(cfg, indent=2, ensure_ascii=False))


def main():
    ap = argparse.ArgumentParser(prog="ccm", description="Group chat for Claude Code sessions across machines")
    ap.add_argument("--version", action="version", version=VERSION)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("init", help="set up this node (label, plugin, shim)"); p.add_argument("--label"); p.add_argument("--no-plugin", action="store_true"); p.set_defaults(fn=cmd_init)
    p = sp.add_parser("pair", help="pair with another machine over ssh"); p.add_argument("host"); p.add_argument("--remote-label"); p.set_defaults(fn=cmd_pair)
    p = sp.add_parser("unpair"); p.add_argument("host"); p.set_defaults(fn=cmd_unpair)
    sp.add_parser("doctor", help="check everything").set_defaults(fn=cmd_doctor)
    p = sp.add_parser("up"); p.add_argument("hosts", nargs="*"); p.add_argument("--foreground", action="store_true"); p.set_defaults(fn=cmd_up)
    sp.add_parser("down").set_defaults(fn=cmd_down)
    sp.add_parser("restart").set_defaults(fn=cmd_restart)
    sp.add_parser("ensure").set_defaults(fn=cmd_ensure)
    p = sp.add_parser("status"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_status)
    p = sp.add_parser("roster", aliases=["peers"], help="members and their tasks"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_roster)
    p = sp.add_parser("send", help="@ one member"); p.add_argument("to"); p.add_argument("text", nargs="*"); p.set_defaults(fn=cmd_send)
    p = sp.add_parser("broadcast", help="message everyone"); p.add_argument("text", nargs="*"); p.add_argument("--local", action="store_true")
    p.add_argument("--node"); p.add_argument("--match", help="regex on member names"); p.set_defaults(fn=cmd_broadcast)
    p = sp.add_parser("task", help="show/set this session's task"); p.add_argument("text", nargs="*"); p.set_defaults(fn=cmd_task)
    p = sp.add_parser("log", help="audit trail"); p.add_argument("-n", type=int, default=40); p.add_argument("-f", "--follow", action="store_true")
    p.add_argument("--ev"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_log)
    p = sp.add_parser("config"); p.add_argument("action", choices=["show", "set-label", "set-preview"], nargs="?", default="show")
    p.add_argument("value", nargs="?"); p.set_defaults(fn=cmd_config)
    p = sp.add_parser("hook"); p.add_argument("event", choices=["session-start", "prompt", "sent", "session-end"]); p.set_defaults(fn=cmd_hook)
    p = sp.add_parser("link"); p.add_argument("host"); p.set_defaults(fn=cmd_link)
    p = sp.add_parser("serve"); p.add_argument("--label"); p.set_defaults(fn=cmd_serve)
    p = sp.add_parser("mirror"); p.add_argument("--name", required=True); p.add_argument("--peer", required=True)
    p.add_argument("--remote", required=True); p.set_defaults(fn=cmd_mirror)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
